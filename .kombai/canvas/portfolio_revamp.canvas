    "var_f9e5dd2674f6": {
      "type": "variant",
      "label": "Aquatic Torch",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 16940,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@900&family=Work+Sans:wght@300;400;600&family=Space+Mono:wght@400;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --ink: #0d0c0a;\n    --paper: #f4f0e8;\n    --cobalt: #0055FF;\n    --vermillion: #e85d04;\n    --line-thick: 4px;\n    --line-heavy: 8px;\n    \n    --font-header: 'Big Shoulders Display', sans-serif;\n    --font-body: 'Work Sans', sans-serif;\n    --font-mono: 'Space Mono', monospace;\n  }\n\n  body {\n    background-color: var(--ink);\n    color: var(--paper);\n    font-family: var(--font-body);\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .manga-panel {\n    border: var(--line-thick) solid var(--cobalt);\n    position: relative;\n    background: var(--ink);\n    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);\n  }\n\n  .text-skew {\n    transform: skewY(-10deg);\n  }\n\n  .italic-heavy {\n    font-family: var(--font-header);\n    font-weight: 900;\n    font-style: italic;\n    text-transform: uppercase;\n    line-height: 0.8;\n  }\n\n  .diagonal-slash {\n    position: absolute;\n    top: 50%;\n    left: -10%;\n    width: 120%;\n    height: var(--line-heavy);\n    background: var(--vermillion);\n    transform: rotate(-10deg);\n    z-index: 10;\n    box-shadow: 0 0 40px var(--vermillion);\n  }\n\n  /* Custom scrollbar */\n  ::-webkit-scrollbar { width: 12px; }\n  ::-webkit-scrollbar-track { background: var(--ink); }\n  ::-webkit-scrollbar-thumb { \n    background: var(--cobalt); \n    border: 3px solid var(--ink);\n  }\n\n  .work-skew-container {\n    transform: skewY(15deg);\n    transition: transform 0.6s var(--ease-snap);\n  }\n\n  .project-card {\n    border: var(--line-thick) solid var(--cobalt);\n    height: 400px;\n    overflow: hidden;\n    position: relative;\n    cursor: pointer;\n  }\n\n  .project-card:hover {\n    transform: skewY(-15deg) scale(1.05);\n    z-index: 20;\n    border-color: var(--vermillion);\n  }\n\n  .project-card:hover .project-image {\n    filter: none;\n    transform: scale(1.1);\n  }\n\n  .project-image {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    filter: grayscale(1) contrast(1.5) multiply(var(--cobalt));\n    transition: all 0.5s ease;\n  }\n\n  .radar-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n    gap: 2px;\n    background: var(--cobalt);\n    border: var(--line-thick) solid var(--cobalt);\n  }\n\n  .stat-cell {\n    background: var(--ink);\n    padding: 2rem;\n    aspect-ratio: 1;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    align-items: center;\n  }\n</style>\n\n<div class=\"relative min-h-screen\" data-kid=\"1\">\n  \n  <nav class=\"fixed top-0 left-0 right-0 z-[100] flex justify-between items-center p-8 mix-blend-difference\" data-kid=\"2\">\n    <div class=\"italic-heavy text-4xl tracking-tighter\" data-kid=\"3\">AB / 02</div>\n    <div class=\"flex gap-12 font-mono text-xs uppercase tracking-[0.2em]\" data-kid=\"4\">\n      <a href=\"#work\" class=\"hover:text-(--vermillion) transition-colors\" data-kid=\"5\">Projects</a>\n      <a href=\"#journey\" class=\"hover:text-(--vermillion) transition-colors\" data-kid=\"6\">Path</a>\n      <a href=\"#stats\" class=\"hover:text-(--vermillion) transition-colors\" data-kid=\"7\">Stats</a>\n      <a href=\"#contact\" class=\"hover:text-(--vermillion) transition-colors\" data-kid=\"8\">Link</a>\n    </div>\n  </nav>\n\n  \n  <section class=\"relative h-screen flex flex-col justify-center overflow-hidden\" data-kid=\"9\">\n    <div class=\"diagonal-slash\" data-kid=\"10\"></div>\n    \n    \n    <div class=\"absolute inset-0 bg-(--ink) h-1/2 flex items-end pb-12 px-20\" data-kid=\"11\">\n      <h1 class=\"italic-heavy text-[15vw] text-skew leading-none select-none pointer-events-none\" data-kid=\"12\">\n        ARYAN <span class=\"text-(--vermillion)\" data-kid=\"13\">BARBATE</span>\n      </h1>\n    </div>\n\n    \n    <div class=\"absolute inset-0 top-1/2 bg-(--cobalt)/20 h-1/2 overflow-hidden\" data-kid=\"14\">\n      <video src=\"https://videos.pexels.com/video-files/3960414/3960414-sd_960_540_30fps.mp4\" poster=\"https://images.pexels.com/videos/3960414/black-and-white-free-videos-ink-drop-ink-droplets-3960414.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline preload=\"metadata\" class=\"w-full h-full object-cover grayscale contrast-200 opacity-40 mix-blend-overlay\" data-kid=\"15\"></video>\n      <div class=\"absolute inset-0 flex items-start pt-12 px-20\" data-kid=\"16\">\n        <p class=\"text-skew font-mono text-xl max-w-xl leading-relaxed\" data-kid=\"17\">\n          [ SYSTEM_STATUS: <span class=\"text-(--vermillion) animate-pulse\" data-kid=\"18\">ACTIVE</span> ]<br data-kid=\"19\">\n          I build interfaces with high-voltage intention — live API tools, creative experiments, and polished front-end craft.\n        </p>\n      </div>\n    </div>\n  </section>\n\n  \n  <div class=\"bg-(--vermillion) py-4 border-y-(--line-heavy) border-black overflow-hidden flex whitespace-nowrap\" data-kid=\"20\">\n    <div class=\"flex animate-[marquee_20s_linear_infinite] gap-12 items-center\" data-kid=\"21\">\n      <span class=\"italic-heavy text-4xl text-black\" data-kid=\"22\">FRONTEND DEVELOPER</span>\n      <img src=\"https://cdn.jsdelivr.net/npm/openmoji-named-svgs@latest/color/fire.svg\" class=\"h-10\" data-kid=\"23\">\n      <span class=\"italic-heavy text-4xl text-black\" data-kid=\"24\">REACT ARCHITECT</span>\n      <img src=\"https://cdn.jsdelivr.net/npm/openmoji-named-svgs@latest/color/fire.svg\" class=\"h-10\" data-kid=\"25\">\n      <span class=\"italic-heavy text-4xl text-black\" data-kid=\"26\">CREATIVE BUILDER</span>\n      <img src=\"https://cdn.jsdelivr.net/npm/openmoji-named-svgs@latest/color/fire.svg\" class=\"h-10\" data-kid=\"27\">\n    </div>\n    <div class=\"flex animate-[marquee_20s_linear_infinite] gap-12 items-center ml-12\" data-kid=\"28\">\n      <span class=\"italic-heavy text-4xl text-black\" data-kid=\"29\">FRONTEND DEVELOPER</span>\n      <img src=\"https://cdn.jsdelivr.net/npm/openmoji-named-svgs@latest/color/fire.svg\" class=\"h-10\" data-kid=\"30\">\n      <span class=\"italic-heavy text-4xl text-black\" data-kid=\"31\">REACT ARCHITECT</span>\n      <img src=\"https://cdn.jsdelivr.net/npm/openmoji-named-svgs@latest/color/fire.svg\" class=\"h-10\" data-kid=\"32\">\n      <span class=\"italic-heavy text-4xl text-black\" data-kid=\"33\">CREATIVE BUILDER</span>\n      <img src=\"https://cdn.jsdelivr.net/npm/openmoji-named-svgs@latest/color/fire.svg\" class=\"h-10\" data-kid=\"34\">\n    </div>\n  </div>\n\n  \n  <section id=\"work\" class=\"py-40 px-20 relative bg-(--ink)\" data-kid=\"35\">\n    <div class=\"flex justify-between items-end mb-32\" data-kid=\"36\">\n      <h2 class=\"italic-heavy text-9xl text-(--cobalt)\" data-kid=\"37\">PROJECTS<br data-kid=\"38\"><span class=\"text-white\" data-kid=\"39\">SELECTED</span></h2>\n      <div class=\"font-mono text-right text-xs uppercase tracking-widest text-(--paper)/40\" data-kid=\"40\">\n        VOL. 01 / COLLECTION<br data-kid=\"41\">\n        4 ACTIVE ENTRIES\n      </div>\n    </div>\n\n    <div class=\"work-skew-container grid grid-cols-1 md:grid-cols-2 gap-8 pb-40\" data-kid=\"42\">\n      \n      <div class=\"project-card group\" data-kid=\"43\">\n        <img src=\"https://images.unsplash.com/photo-1610454059909-f9a5a6eb4e58?auto=format&w=800&q=80&fit=crop\" class=\"project-image\" alt=\"Linea Flora\" data-kid=\"44\">\n        <div class=\"absolute inset-0 p-8 flex flex-col justify-end bg-gradient-to-t from-black/80 to-transparent\" data-kid=\"45\">\n          <div class=\"font-mono text-(--vermillion) mb-2\" data-kid=\"46\">01. CREATIVE BUILDER</div>\n          <h3 class=\"italic-heavy text-5xl\" data-kid=\"47\">LINEA FLORA</h3>\n        </div>\n      </div>\n      \n      <div class=\"project-card group\" data-kid=\"48\">\n        <img src=\"https://images.unsplash.com/photo-1625476593672-3b4548617c26?auto=format&w=800&q=80&fit=crop\" class=\"project-image\" alt=\"AniScope\" data-kid=\"49\">\n        <div class=\"absolute inset-0 p-8 flex flex-col justify-end bg-gradient-to-t from-black/80 to-transparent\" data-kid=\"50\">\n          <div class=\"font-mono text-(--vermillion) mb-2\" data-kid=\"51\">02. LIVE PRODUCT</div>\n          <h3 class=\"italic-heavy text-5xl\" data-kid=\"52\">ANISCOPE</h3>\n        </div>\n      </div>\n      \n      <div class=\"project-card group\" data-kid=\"53\">\n        <img src=\"https://images.unsplash.com/photo-1584605518182-be59824e7d15?auto=format&w=800&q=80&fit=crop\" class=\"project-image\" alt=\"GitHub Finder\" data-kid=\"54\">\n        <div class=\"absolute inset-0 p-8 flex flex-col justify-end bg-gradient-to-t from-black/80 to-transparent\" data-kid=\"55\">\n          <div class=\"font-mono text-(--vermillion) mb-2\" data-kid=\"56\">03. DEVELOPER TOOL</div>\n          <h3 class=\"italic-heavy text-5xl\" data-kid=\"57\">GITHUB FINDER</h3>\n        </div>\n      </div>\n      \n      <div class=\"project-card group\" data-kid=\"58\">\n        <img src=\"https://images.unsplash.com/photo-1721199609354-5663748a6495?auto=format&w=800&q=80&fit=crop\" class=\"project-image\" alt=\"Gallery of Senses\" data-kid=\"59\">\n        <div class=\"absolute inset-0 p-8 flex flex-col justify-end bg-gradient-to-t from-black/80 to-transparent\" data-kid=\"60\">\n          <div class=\"font-mono text-(--vermillion) mb-2\" data-kid=\"61\">04. EXPERIMENT</div>\n          <h3 class=\"italic-heavy text-5xl\" data-kid=\"62\">GALLERY SENSES</h3>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"stats\" class=\"py-40 bg-(--paper) text-(--ink)\" data-kid=\"63\">\n    <div class=\"px-20 mb-20\" data-kid=\"64\">\n      <h2 class=\"italic-heavy text-9xl\" data-kid=\"65\">POWER<br data-kid=\"66\">LEVELS</h2>\n    </div>\n\n    <div class=\"radar-grid\" data-kid=\"67\">\n      <div class=\"stat-cell\" data-kid=\"68\">\n        <div class=\"italic-heavy text-6xl text-(--vermillion)\" data-kid=\"69\">99</div>\n        <div class=\"font-mono font-bold mt-2 uppercase tracking-tighter\" data-kid=\"70\">React.js</div>\n        <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/radar-cross-section.svg\" class=\"h-20 mt-4 opacity-20\" style=\"color: var(--vermillion);\" data-kid=\"71\">\n      </div>\n      <div class=\"stat-cell\" data-kid=\"72\">\n        <div class=\"italic-heavy text-6xl text-(--vermillion)\" data-kid=\"73\">85</div>\n        <div class=\"font-mono font-bold mt-2 uppercase tracking-tighter\" data-kid=\"74\">TypeScript</div>\n        <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/radar-dish.svg\" class=\"h-20 mt-4 opacity-20\" style=\"color: var(--vermillion);\" data-kid=\"75\">\n      </div>\n      <div class=\"stat-cell\" data-kid=\"76\">\n        <div class=\"italic-heavy text-6xl text-(--vermillion)\" data-kid=\"77\">92</div>\n        <div class=\"font-mono font-bold mt-2 uppercase tracking-tighter\" data-kid=\"78\">Tailwind</div>\n        <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/chart.svg\" class=\"h-20 mt-4 opacity-20\" style=\"color: var(--vermillion);\" data-kid=\"79\">\n      </div>\n      <div class=\"stat-cell\" data-kid=\"80\">\n        <div class=\"italic-heavy text-6xl text-(--vermillion)\" data-kid=\"81\">88</div>\n        <div class=\"font-mono font-bold mt-2 uppercase tracking-tighter\" data-kid=\"82\">Motion JS</div>\n        <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/radar-sweep.svg\" class=\"h-20 mt-4 opacity-20\" style=\"color: var(--vermillion);\" data-kid=\"83\">\n      </div>\n    </div>\n    \n    \n    <div class=\"bg-(--cobalt) p-12 flex justify-between items-center text-white border-t-(--line-heavy) border-black\" data-kid=\"84\">\n      <div class=\"flex items-center gap-6\" data-kid=\"85\">\n        <i class=\"ti ti-activity text-6xl\" data-kid=\"86\"></i>\n        <div class=\"font-mono\" data-kid=\"87\">\n          <div class=\"text-xs opacity-60 uppercase\" data-kid=\"88\">Recent Pulse</div>\n          <div class=\"text-2xl font-bold uppercase tracking-tighter\" data-kid=\"89\">Pushed 12 commits to AniScope.v2</div>\n        </div>\n      </div>\n      <div class=\"italic-heavy text-4xl\" data-kid=\"90\">STATUS: OVERDRIVE</div>\n    </div>\n  </section>\n\n  \n  <footer id=\"contact\" class=\"py-40 bg-(--ink) border-t-(--line-heavy) border-(--cobalt)\" data-kid=\"91\">\n    <div class=\"px-20 grid grid-cols-1 md:grid-cols-2 gap-20\" data-kid=\"92\">\n      <div data-kid=\"93\">\n        <h2 class=\"italic-heavy text-8xl leading-[0.8] mb-12\" data-kid=\"94\">LET'S<br data-kid=\"95\"><span class=\"text-(--cobalt)\" data-kid=\"96\">CONNECT</span></h2>\n        <p class=\"font-mono text-xl opacity-60 max-w-md leading-relaxed\" data-kid=\"97\">\n          Open for collaboration on high-craft interfaces and experimental tools. Reach out through the terminal or mail.\n        </p>\n      </div>\n      <div class=\"flex flex-col gap-4\" data-kid=\"98\">\n        <a href=\"mailto:hello@barbate.xyz\" class=\"manga-panel p-8 block group hover:bg-(--cobalt) transition-all\" data-kid=\"99\">\n          <div class=\"font-mono text-xs text-(--vermillion) mb-2 group-hover:text-white transition-colors\" data-kid=\"100\">EMAIL_CHANNEL</div>\n          <div class=\"italic-heavy text-4xl group-hover:text-white transition-colors\" data-kid=\"101\">HELLO@BARBATE.XYZ</div>\n        </a>\n        <a href=\"#\" class=\"manga-panel p-8 block group hover:bg-(--cobalt) transition-all\" data-kid=\"102\">\n          <div class=\"font-mono text-xs text-(--vermillion) mb-2 group-hover:text-white transition-colors\" data-kid=\"103\">SOCIAL_X</div>\n          <div class=\"italic-heavy text-4xl group-hover:text-white transition-colors\" data-kid=\"104\">@ARYAN_BARBATE</div>\n        </a>\n      </div>\n    </div>\n    \n    <div class=\"mt-40 px-20 flex justify-between items-center border-t border-(--paper)/10 pt-12 font-mono text-[10px] uppercase tracking-[0.4em] opacity-40\" data-kid=\"105\">\n      <div data-kid=\"106\">© 2024 / ARCHIVE_DATA</div>\n      <div data-kid=\"107\">BUILT WITH SPEED_AND_INTENTION</div>\n      <div data-kid=\"108\">ARYAN_B / PANEL_POP_V2</div>\n    </div>\n  </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"109\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"110\"></script>\n<script data-kid=\"111\">\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Parallax for work panels\n  gsap.to(\".work-skew-container\", {\n    scrollTrigger: {\n      trigger: \"#work\",\n      start: \"top bottom\",\n      end: \"bottom top\",\n      scrub: 1\n    },\n    y: -100,\n    skewY: \"5deg\"\n  });\n\n  // Fade in cells\n  gsap.from(\".stat-cell\", {\n    scrollTrigger: {\n      trigger: \".radar-grid\",\n      start: \"top 80%\"\n    },\n    opacity: 0,\n    scale: 0.8,\n    stagger: 0.1,\n    duration: 0.6,\n    ease: \"back.out(1.7)\"\n  });\n\n  // Skew text float\n  gsap.to(\".text-skew\", {\n    y: -20,\n    duration: 3,\n    repeat: -1,\n    yoyo: true,\n    ease: \"sine.inOut\"\n  });\n</script>",
      "comments": [],
      "created": "2026-07-10T04:57:22.019631+00:00",
      "modified": "2026-07-10T04:57:46.242155+00:00",
