      <span class=\"font-mono text-[10px] uppercase opacity-40\" data-kid=\"152\">Frontend_Dev</span>\n                <span class=\"big-header text-5xl text-[var(--vermillion)]\" data-kid=\"153\">99</span>\n              </div>\n              <div class=\"w-full h-1 bg-white/10 relative\" data-kid=\"154\">\n                <div class=\"absolute h-full bg-[var(--vermillion)] w-[99%]\" data-kid=\"155\"></div>\n              </div>\n            </div>\n            <div class=\"stat-box border-l-4 border-[var(--cobalt)] pl-6\" data-kid=\"156\">\n              <div class=\"flex justify-between items-end mb-2\" data-kid=\"157\">\n                <span class=\"font-mono text-[10px] uppercase opacity-40\" data-kid=\"158\">Motion_Design</span>\n                <span class=\"big-header text-5xl text-[var(--cobalt)]\" data-kid=\"159\">92</span>\n              </div>\n              <div class=\"w-full h-1 bg-white/10 relative\" data-kid=\"160\">\n                <div class=\"absolute h-full bg-[var(--cobalt)] w-[92%]\" data-kid=\"161\"></div>\n              </div>\n            </div>\n          </div>\n          \n          <div class=\"mt-16 space-y-6\" data-kid=\"162\">\n            <h4 class=\"font-mono text-xs uppercase font-bold tracking-[0.3em] opacity-40\" data-kid=\"163\">ACTIVE_ARSENAL</h4>\n            <div class=\"flex flex-wrap gap-3\" data-kid=\"164\">\n              <div class=\"manga-panel bg-white text-black px-4 py-2 font-black text-sm uppercase\" data-kid=\"165\">React / Next.js</div>\n              <div class=\"manga-panel bg-white text-black px-4 py-2 font-black text-sm uppercase\" data-kid=\"166\">TypeScript</div>\n              <div class=\"manga-panel bg-white text-black px-4 py-2 font-black text-sm uppercase\" data-kid=\"167\">GSAP / Framer</div>\n              <div class=\"manga-panel bg-white text-black px-4 py-2 font-black text-sm uppercase\" data-kid=\"168\">Tailwind CSS</div>\n              <div class=\"manga-panel bg-white text-black px-4 py-2 font-black text-sm uppercase\" data-kid=\"169\">Performance</div>\n            </div>\n          </div>\n        </div>\n\n        <div id=\"github-console\" class=\"manga-panel p-8 bg-[var(--ink)] text-[#00FF41] font-mono text-xs shadow-[15px_15px_0px_var(--ink)] overflow-hidden\" data-kid=\"170\">\n          <div class=\"flex gap-2 mb-6 border-b border-white/10 pb-4\" data-kid=\"171\">\n            <div class=\"w-3 h-3 rounded-full bg-red-500\" data-kid=\"172\"></div>\n            <div class=\"w-3 h-3 rounded-full bg-yellow-500\" data-kid=\"173\"></div>\n            <div class=\"w-3 h-3 rounded-full bg-green-500\" data-kid=\"174\"></div>\n            <span class=\"ml-4 opacity-40\" data-kid=\"175\">ARYAN@SYSTEM_ARCHIVE: ~/portfolio</span>\n          </div>\n          <div class=\"space-y-2 opacity-80\" id=\"terminal-lines\" data-kid=\"176\">\n            <div data-kid=\"177\">> npm run dev:kinetic</div>\n            <div class=\"text-white\" data-kid=\"178\">VITE v8.0.16 ready in 971 ms</div>\n            <div data-kid=\"179\">➜  Local:   http://localhost:5173/</div>\n            <div class=\"pt-4\" data-kid=\"180\">> fetching github_activity...</div>\n            <div class=\"flex items-center gap-2\" data-kid=\"181\">\n              <span class=\"text-white\" data-kid=\"182\">[DONE]</span> Pushed 12 commits to <span class=\"text-[var(--vermillion)]\" data-kid=\"183\">AniScope.v2</span>\n            </div>\n            <div class=\"flex items-center gap-2\" data-kid=\"184\">\n              <span class=\"text-white\" data-kid=\"185\">[DONE]</span> Merged PR #4 in <span class=\"text-[var(--cobalt)]\" data-kid=\"186\">Kinetic-UI</span>\n            </div>\n            <div class=\"flex items-center gap-2 mt-4\" data-kid=\"187\">\n              <span class=\"animate-pulse\" data-kid=\"188\">_</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"writing\" class=\"py-40 px-12 bg-white border-y-4 border-black relative overflow-hidden\" data-kid=\"189\">\n    <div class=\"absolute inset-0 halftone-bg opacity-5\" data-kid=\"190\"></div>\n    <div class=\"max-w-4xl mx-auto relative z-10\" data-kid=\"191\">\n      <div class=\"mb-20 text-center\" data-kid=\"192\">\n        <h2 class=\"big-header text-9xl italic-heavy leading-none\" data-kid=\"193\">THE_JOURNAL</h2>\n        <p class=\"font-mono text-xs uppercase tracking-widest mt-4\" data-kid=\"194\">FRONTEND_THOUGHTS_AND_EXPERIMENTS</p>\n      </div>\n      \n      <div class=\"space-y-4\" data-kid=\"195\">\n        <div class=\"speed-line-hover relative p-8 border-b-2 border-black flex justify-between items-center group cursor-pointer\" data-kid=\"196\">\n          <div class=\"flex gap-12 items-center\" data-kid=\"197\">\n            <span class=\"big-header text-6xl text-[var(--cobalt)] opacity-20 group-hover:opacity-100 transition-opacity\" data-kid=\"198\">01</span>\n            <div data-kid=\"199\">\n              <h3 class=\"font-black text-3xl uppercase tracking-tighter\" data-kid=\"200\">The future of kinetic interfaces</h3>\n              <p class=\"font-mono text-[10px] opacity-40 mt-1 uppercase\" data-kid=\"201\">PUBLISHED: MAR 12, 2026 / 4 MIN READ</p>\n            </div>\n          </div>\n          <i class=\"ti ti-arrow-right text-3xl group-hover:translate-x-4 transition-transform text-[var(--vermillion)]\" data-kid=\"202\"></i>\n        </div>\n        \n        <div class=\"speed-line-hover relative p-8 border-b-2 border-black flex justify-between items-center group cursor-pointer\" data-kid=\"203\">\n          <div class=\"flex gap-12 items-center\" data-kid=\"204\">\n            <span class=\"big-header text-6xl text-[var(--cobalt)] opacity-20 group-hover:opacity-100 transition-opacity\" data-kid=\"205\">02</span>\n            <div data-kid=\"206\">\n              <h3 class=\"font-black text-3xl uppercase tracking-tighter\" data-kid=\"207\">Mastering GSAP ScrollTrigger</h3>\n              <p class=\"font-mono text-[10px] opacity-40 mt-1 uppercase\" data-kid=\"208\">PUBLISHED: FEB 28, 2026 / 6 MIN READ</p>\n            </div>\n          </div>\n          <i class=\"ti ti-arrow-right text-3xl group-hover:translate-x-4 transition-transform text-[var(--vermillion)]\" data-kid=\"209\"></i>\n        </div>\n        \n        <div class=\"speed-line-hover relative p-8 border-b-2 border-black flex justify-between items-center group cursor-pointer\" data-kid=\"210\">\n          <div class=\"flex gap-12 items-center\" data-kid=\"211\">\n            <span class=\"big-header text-6xl text-[var(--cobalt)] opacity-20 group-hover:opacity-100 transition-opacity\" data-kid=\"212\">03</span>\n            <div data-kid=\"213\">\n              <h3 class=\"font-black text-3xl uppercase tracking-tighter\" data-kid=\"214\">Manga Aesthetic in UI Design</h3>\n              <p class=\"font-mono text-[10px] opacity-40 mt-1 uppercase\" data-kid=\"215\">PUBLISHED: JAN 15, 2026 / 5 MIN READ</p>\n            </div>\n          </div>\n          <i class=\"ti ti-arrow-right text-3xl group-hover:translate-x-4 transition-transform text-[var(--vermillion)]\" data-kid=\"216\"></i>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"about\" class=\"py-40 px-12 grid grid-cols-2 gap-20\" data-kid=\"217\">\n    <div class=\"relative\" data-kid=\"218\">\n      <div class=\"manga-panel w-full aspect-square overflow-hidden shadow-[25px_25px_0px_var(--vermillion)] rotate-[-3deg]\" data-kid=\"219\">\n        <img src=\"https://images.unsplash.com/photo-1541715301255-12a4839b424a?auto=format&w=1000&q=80&fit=crop\" class=\"w-full h-full object-cover grayscale contrast-200\" alt=\"About Portrait\" data-kid=\"220\">\n      </div>\n      <div class=\"absolute -bottom-8 -right-8 manga-panel bg-white p-6 rotate-[5deg] z-20\" data-kid=\"221\">\n        <span class=\"big-header text-5xl\" data-kid=\"222\">CRAFT_CENTRIC</span>\n      </div>\n    </div>\n    \n    <div class=\"flex flex-col justify-center\" data-kid=\"223\">\n      <div class=\"manga-panel p-10 bg-white shadow-[12px_12px_0px_var(--ink)]\" data-kid=\"224\">\n        <h2 class=\"big-header text-7xl leading-none mb-8 italic-heavy\" data-kid=\"225\">WHO_IS_ARYAN</h2>\n        <div class=\"space-y-6 text-xl font-bold uppercase tracking-tight\" data-kid=\"226\">\n          <p data-kid=\"227\">Based in the digital trenches of India, I specialize in building interfaces that don't just sit there—they react.</p>\n          <p class=\"text-[var(--cobalt)]\" data-kid=\"228\">Obsessed with frame-perfect animations, high-contrast layouts, and the architectural side of frontend engineering.</p>\n          <p data-kid=\"229\">I believe every pixel should serve a purpose, and every interaction should feel like a \"POP\".</p>\n        </div>\n        <div class=\"grid grid-cols-3 gap-6 mt-12 border-t-2 border-black pt-8\" data-kid=\"230\">\n          <div data-kid=\"231\">\n            <div class=\"big-header text-4xl\" data-kid=\"232\">2026</div>\n            <div class=\"font-mono text-[10px] uppercase opacity-40\" data-kid=\"233\">Active_Year</div>\n          </div>\n          <div data-kid=\"234\">\n            <div class=\"big-header text-4xl\" data-kid=\"235\">45+</div>\n            <div class=\"font-mono text-[10px] uppercase opacity-40\" data-kid=\"236\">Missions_Completed</div>\n          </div>\n          <div data-kid=\"237\">\n            <div class=\"big-header text-4xl\" data-kid=\"238\">99.9</div>\n            <div class=\"font-mono text-[10px] uppercase opacity-40\" data-kid=\"239\">Uptime_Score</div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"contact\" class=\"py-40 bg-[var(--ink)] text-white px-12 border-t-8 border-[var(--vermillion)] relative overflow-hidden\" data-kid=\"240\">\n    <div class=\"absolute inset-0 halftone-bg opacity-10\" data-kid=\"241\"></div>\n    <div class=\"max-w-5xl mx-auto grid grid-cols-12 gap-20 relative z-10\" data-kid=\"242\">\n      <div class=\"col-span-5\" data-kid=\"243\">\n        <h2 class=\"big-header text-[12vw] italic-heavy text-[var(--vermillion)] leading-[0.75] mb-8\" data-kid=\"244\">LET'S<br data-kid=\"245\">TALK</h2>\n        <p class=\"font-mono text-lg opacity-60 uppercase leading-relaxed mb-12\" data-kid=\"246\">Open for new architectural missions. Reach out via the terminal or dispatch an email below.</p>\n        \n        <div class=\"space-y-4\" data-kid=\"247\">\n          <div class=\"manga-panel border-white/20 p-4 bg-transparent hover:bg-white hover:text-black transition-all group\" data-kid=\"248\">\n            <span class=\"font-mono text-[10px] uppercase opacity-40 group-hover:opacity-100\" data-kid=\"249\">SOCIAL_X</span>\n            <div class=\"font-black text-2xl uppercase\" data-kid=\"250\">@ARYAN_BARBATE</div>\n          </div>\n          <div class=\"manga-panel border-white/20 p-4 bg-transparent hover:bg-white hover:text-black transition-all group\" data-kid=\"251\">\n            <span class=\"font-mono text-[10px] uppercase opacity-40 group-hover:opacity-100\" data-kid=\"252\">GITHUB_CHANNEL</span>\n            <div class=\"font-black text-2xl uppercase\" data-kid=\"253\">ARYAN-BARBATE</div>\n          </div>\n        </div>\n      </div>\n      \n      <div class=\"col-span-7\" data-kid=\"254\">\n        <div class=\"manga-panel p-10 bg-white text-black shadow-[15px_15px_0px_var(--cobalt)]\" data-kid=\"255\">\n          <div class=\"mb-8 border-b-2 border-black pb-4\" data-kid=\"256\">\n            <h4 class=\"font-black text-2xl uppercase\" data-kid=\"257\">DISPATCH_MESSAGE</h4>\n          </div>\n          <form class=\"space-y-8\" data-kid=\"258\">\n            <div class=\"relative\" data-kid=\"259\">\n              <label class=\"font-mono text-[10px] uppercase font-bold absolute -top-3 left-4 bg-white px-2\" data-kid=\"260\">Mission_Identifier (Name)</label>\n              <input type=\"text\" class=\"w-full border-2 border-black p-4 bg-transparent font-bold outline-none focus:bg-[var(--paper)]\" placeholder=\"Your Name\" data-kid=\"261\">\n            </div>\n            <div class=\"relative\" data-kid=\"262\">\n              <label class=\"font-mono text-[10px] uppercase font-bold absolute -top-3 left-4 bg-white px-2\" data-kid=\"263\">Return_Channel (Email)</label>\n              <input type=\"email\" class=\"w-full border-2 border-black p-4 bg-transparent font-bold outline-none focus:bg-[var(--paper)]\" placeholder=\"email@domain.com\" data-kid=\"264\">\n            </div>\n            <div class=\"relative\" data-kid=\"265\">\n              <label class=\"font-mono text-[10px] uppercase font-bold absolute -top-3 left-4 bg-white px-2\" data-kid=\"266\">Objective (Message)</label>\n              <textarea class=\"w-full border-2 border-black p-4 bg-transparent font-bold outline-none focus:bg-[var(--paper)] min-h-[150px]\" placeholder=\"Briefly describe the mission...\" data-kid=\"267\"></textarea>\n            </div>\n            <button class=\"manga-panel w-full py-5 bg-[var(--ink)] text-white font-black uppercase text-xl hover:bg-[var(--vermillion)] transition-all\" data-kid=\"268\">Submit Dispatch [SEND]</button>\n          </form>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  \n    <div class=\"max-w-7xl mx-auto flex flex-col items-center gap-12 relative z-10\" data-kid=\"269\">\n      <div class=\"big-header text-3xl opacity-20\" data-kid=\"270\">ARYAN_BARBATE_V2_COLOPHON</div>\n      <div class=\"w-full flex justify-between items-center font-mono text-[10px] tracking-[0.5em] opacity-40 uppercase\" data-kid=\"271\">\n        <span data-kid=\"272\">© 2026 ARCHIVE_DATA</span>\n        <div class=\"flex gap-8\" data-kid=\"273\">\n          <a href=\"#\" class=\"hover:text-[var(--vermillion)] transition-colors\" data-kid=\"274\">Privacy</a>\n          <a href=\"#\" class=\"hover:text-[var(--cobalt)] transition-colors\" data-kid=\"275\">Cookies</a>\n          <a href=\"#\" class=\"hover:text-[var(--vermillion)] transition-colors\" data-kid=\"276\">Back_to_top</a>\n        </div>\n        <span data-kid=\"277\">BUILT_WITH_PULSE_AND_INTENTION</span>\n      </div>\n    </div>\n  \n\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"278\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"279\"></script>\n<script data-kid=\"280\">\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Loader Timeline\n  const loaderTl = gsap.timeline();\n  \n  loaderTl.to(\".scan-line\", {\n    top: \"100%\",\n    duration: 1.5,\n    repeat: 2,\n    ease: \"power2.inOut\"\n  });\n  \n  loaderTl.to(\".loader-progress\", {\n    width: \"100%\",\n    duration: 2,\n    ease: \"power1.inOut\"\n  }, 0);\n  \n  loaderTl.to(\"#loader\", {\n    yPercent: -100,\n    duration: 1,\n    ease: \"power4.inOut\"\n  });\n  \n  loaderTl.to(\"#main-content\", {\n    opacity: 1,\n    y: 0,\n    duration: 1.5,\n    ease: \"power4.out\"\n  }, \"-=0.5\");\n\n  // Hero image drift\n  gsap.to('#main-content section:first-child img', {\n    y: -30,\n    duration: 4,\n    repeat: -1,\n    yoyo: true,\n    ease: \"sine.inOut\"\n  });\n\n  // Scroll Actions Lines - Horizontal Scrub\n  gsap.to(\"#work-lines\", {\n    backgroundPositionX: \"500px\",\n    scrollTrigger: {\n      trigger: \"#work\",\n      start: \"top bottom\",\n      end: \"bottom top\",\n      scrub: 1\n    }\n  });\n\n  // Work Panels Entrance with Snap\n  gsap.utils.toArray('.work-skew-panel').forEach((panel, i) => {\n    gsap.from(panel, {\n      y: 100,\n      opacity: 0,\n      scrollTrigger: {\n        trigger: panel,\n        start: \"top 90%\",\n        toggleActions: \"play none none reverse\"\n      },\n      duration: 1,\n      ease: \"var(--ease-snap)\",\n      delay: i % 2 * 0.2\n    });\n  });\n\n  // Reveal panels for journey\n  gsap.utils.toArray('.reveal-panel').forEach(panel => {\n    gsap.to(panel, {\n      opacity: 1,\n      y: 0,\n      scrollTrigger: {\n        trigger: panel,\n        start: \"top 85%\",\n        toggleActions: \"play none none reverse\"\n      },\n      duration: 0.8,\n      ease: \"power3.out\"\n    });\n  });\n\n  // Console typing effect simulation\n  const terminal = document.querySelector(\"#terminal-lines\");\n  // Simple cursor blink already handled in CSS but could be enhanced here.\n</script></main>",
      "comments": [],
      "created": "2026-07-10T05:05:14.847063+00:00",
      "modified": "2026-07-10T05:06:26.358404+00:00",
      "id": "var_0592a1c65663",
      "viewportScrollY": 6106
    },
    "var_478a9176f04c": {
      "type": "variant",
      "label": "3D Pop-Up Archive",
      "parentId": "var_87ef19eafbe3",
      "themeId": null,
      "rect": {
        "x": 4620,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:ital,wght@0,900;1,900&family=Work+Sans:wght@300;400;500;600&family=Space+Mono:wght@400;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --ink: #0d0c0a;\n    --paper: #f4f0e8;\n    --cobalt: #0055FF;\n    --vermillion: #e85d04;\n    --font-header: 'Big Shoulders Display', sans-serif;\n    --font-body: 'Work Sans', sans-serif;\n    --font-mono: 'Space Mono', monospace;\n  }\n\n  body {\n    background-color: var(--paper);\n    color: var(--ink);\n    font-family: var(--font-body);\n    margin: 0;\n    overflow-x: hidden;\n    perspective: 1200px;\n  }\n\n  .perspective-container {\n    perspective: 1200px;\n    transform-style: preserve-3d;\n  }\n\n  .manga-panel-3d {\n    border: 4px solid var(--ink);\n    background: white;\n    position: relative;\n    transform-style: preserve-3d;\n    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.6s ease;\n    box-shadow: 12px 12px 0px var(--ink);\n  }\n\n  .manga-panel-3d:hover {\n    transform: translateZ(50px);\n    box-shadow: 24px 24px 0px var(--ink);\n  }\n\n  .extruded-text {\n    font-family: var(--font-header);\n    font-weight: 900;\n    text-transform: uppercase;\n    line-height: 0.8;\n    color: var(--ink);\n    text-shadow: \n      1px 1px 0px var(--cobalt),\n      2px 2px 0px var(--cobalt),\n      3px 3px 0px var(--cobalt),\n      4px 4px 0px var(--cobalt),\n      5px 5px 0px var(--cobalt);\n  }\n\n  .cel-shadow {\n    filter: drop-shadow(15px 15px 0px var(--ink));\n  }\n\n  /* Work Section Pop-Up */\n  .work-grid-3d {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 60px;\n    padding: 100px;\n    transform: rotateX(20deg);\n    transform-style: preserve-3d;\n  }\n\n  .project-card-3d {\n    position: relative;\n    aspect-ratio: 4/3;\n    border: 4px solid var(--cobalt);\n    background: var(--ink);\n    transform: rotateX(60deg) translateZ(0);\n    transform-origin: bottom;\n    transition: transform 0.8s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.4s ease;\n    cursor: pointer;\n    overflow: hidden;\n  }\n\n  .project-card-3d:hover {\n    transform: rotateX(0deg) translateZ(100px);\n    border-color: var(--vermillion);\n    z-index: 50;\n  }\n\n  .project-card-3d img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    filter: grayscale(1) contrast(1.2);\n    transition: filter 0.4s ease, transform 0.4s ease;\n  }\n\n  .project-card-3d:hover img {\n    filter: grayscale(0) contrast(1);\n    transform: scale(1.05);\n  }\n\n  /* Marquee */\n  .marquee-3d {\n    background: var(--vermillion);\n    border-y: 6px solid var(--ink);\n    padding: 20px 0;\n    overflow: hidden;\n    transform: rotateZ(-2deg) scale(1.1);\n    z-index: 100;\n  }\n\n  .marquee-content {\n    display: flex;\n    white-space: nowrap;\n    animation: scroll 30s linear infinite;\n  }\n\n  @keyframes scroll {\n    from { transform: translateX(0); }\n    to { transform: translateX(-50%); }\n  }\n\n  /* Stat Cube */\n  .stat-cube {\n    background: white;\n    border: 3px solid var(--ink);\n    padding: 30px;\n    box-shadow: 10px 10px 0px var(--cobalt);\n    transform-style: preserve-3d;\n  }\n\n  /* Custom components */\n  .halftone-bg {\n    background-image: radial-gradient(var(--ink) 1px, transparent 0);\n    background-size: 10px 10px;\n    opacity: 0.05;\n  }\n</style>\n\n\n<div class=\"fixed inset-0 pointer-events-none z-[9999]\" id=\"particles-container\" data-kid=\"1\"></div>\n\n\n<div id=\"loader\" class=\"fixed inset-0 bg-black z-[10000] flex items-center justify-center overflow-hidden\" data-kid=\"2\">\n  <div class=\"italic extruded-text text-[15vw] text-white animate-pulse\" data-kid=\"3\">LOADING...</div>\n  <div class=\"absolute w-[200%] h-2 bg-(--vermillion) rotate-[-15deg] shadow-[0_0_50px_var(--vermillion)]\" id=\"loader-slash\" data-kid=\"4\"></div>\n</div>\n\n<nav class=\"fixed top-0 left-0 right-0 z-[500] flex justify-between items-center p-10 mix-blend-difference\" data-kid=\"5\">\n  <div class=\"font-black text-4xl text-white tracking-tighter italic\" data-kid=\"6\">AB / 3D</div>\n  <div class=\"flex gap-10 font-mono text-sm uppercase text-white tracking-widest\" data-kid=\"7\">\n    <a href=\"#work\" class=\"hover:text-(--vermillion) transition-colors\" data-kid=\"8\">Archive</a>\n    <a href=\"#stats\" class=\"hover:text-(--vermillion) transition-colors\" data-kid=\"9\">Levels</a>\n    <a href=\"#contact\" class=\"hover:text-(--vermillion) transition-colors\" data-kid=\"10\">Signal</a>\n  </div>\n</nav>\n\n<main class=\"perspective-container\" data-kid=\"11\">\n  \n  <section class=\"relative min-h-screen flex flex-col justify-center px-20 overflow-hidden\" data-kid=\"12\">\n    <div class=\"absolute inset-0 halftone-bg pointer-events-none\" data-kid=\"13\"></div>\n    \n    <div class=\"grid grid-cols-12 gap-10 items-center\" data-kid=\"14\">\n      <div class=\"col-span-7 z-10\" id=\"hero-text-container\" data-kid=\"15\">\n        <h1 class=\"extruded-text italic text-[14vw] leading-[0.8] mb-8 select-none\" data-kid=\"16\">\n          ARYAN<br data-kid=\"17\">\n          <span class=\"text-(--vermillion)\" data-kid=\"18\">BARBATE</span>\n        </h1>\n        <div class=\"manga-panel-3d p-8 max-w-xl rotate-[-2deg]\" data-kid=\"19\">\n          <p class=\"font-mono text-xl leading-relaxed\" data-kid=\"20\">\n            [ DIMENSION_Z: <span class=\"text-(--vermillion) animate-pulse\" data-kid=\"21\">CALIBRATED</span> ]<br data-kid=\"22\">\n            Frontend Architect pushing 3D manga kinetics into editorial web experiences.\n          </p>\n        </div>\n      </div>\n\n      <div class=\"col-span-5 relative\" data-kid=\"23\">\n        <div class=\"manga-panel-3d w-full aspect-[3/4] overflow-hidden cel-shadow\" id=\"hero-image-panel\" data-kid=\"24\">\n          <img src=\"https://images.unsplash.com/photo-1541715301255-12a4839b424a?auto=format&w=800&q=80&fit=crop\" alt=\"3D Portrait\" class=\"w-full h-full object-cover grayscale contrast-150\" decoding=\"async\" loading=\"lazy\" data-kid=\"25\">\n          <div class=\"absolute inset-0 bg-(--cobalt)/20 mix-blend-overlay\" data-kid=\"26\"></div>\n        </div>\n        \n        <div class=\"absolute -top-10 -right-10 w-40 h-40 bg-(--vermillion) border-4 border-black rotate-[15deg] flex items-center justify-center text-white font-black text-2xl offset-shadow z-20\" data-kid=\"27\">\n          NEW<br data-kid=\"28\">CH.\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <div class=\"marquee-3d\" data-kid=\"29\">\n    <div class=\"marquee-content flex items-center gap-16\" data-kid=\"30\">\n      <div class=\"flex items-center gap-16 text-black font-black uppercase text-6xl italic tracking-tighter\" data-kid=\"31\">\n        <span data-kid=\"32\">3D WEBGL</span> <i class=\"ti ti-bolt\" data-kid=\"33\"></i>\n        <span data-kid=\"34\">MOTION ARCHITECT</span> <i class=\"ti ti-bolt\" data-kid=\"35\"></i>\n        <span data-kid=\"36\">REACT KINETICS</span> <i class=\"ti ti-bolt\" data-kid=\"37\"></i>\n        <span data-kid=\"38\">PANEL POP V3</span> <i class=\"ti ti-bolt\" data-kid=\"39\"></i>\n      </div>\n      <div class=\"flex items-center gap-16 text-black font-black uppercase text-6xl italic tracking-tighter\" data-kid=\"40\">\n        <span data-kid=\"41\">3D WEBGL</span> <i class=\"ti ti-bolt\" data-kid=\"42\"></i>\n        <span data-kid=\"43\">MOTION ARCHITECT</span> <i class=\"ti ti-bolt\" data-kid=\"44\"></i>\n        <span data-kid=\"45\">REACT KINETICS</span> <i class=\"ti ti-bolt\" data-kid=\"46\"></i>\n        <span data-kid=\"47\">PANEL POP V3</span> <i class=\"ti ti-bolt\" data-kid=\"48\"></i>\n      </div>\n    </div>\n  </div>\n\n  \n  <section id=\"work\" class=\"py-40 bg-(--ink) relative overflow-hidden\" data-kid=\"49\">\n    <div class=\"absolute inset-0 opacity-10\" data-kid=\"50\">\n      <video src=\"https://videos.pexels.com/video-files/3960414/3960414-sd_960_540_30fps.mp4\" poster=\"https://images.pexels.com/videos/3960414/black-and-white-free-videos-ink-drop-ink-droplets-3960414.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" autoplay muted loop playsinline preload=\"metadata\" class=\"w-full h-full object-cover\" data-kid=\"51\"></video>\n    </div>\n    \n    <div class=\"px-20 mb-20 relative z-10\" data-kid=\"52\">\n      <h2 class=\"extruded-text text-9xl text-white\" data-kid=\"53\">POP-UP<br data-kid=\"54\"><span class=\"text-(--cobalt)\" data-kid=\"55\">ARCHIVE</span></h2>\n    </div>\n\n    <div class=\"work-grid-3d\" data-kid=\"56\">\n      <div class=\"project-card-3d group\" data-kid=\"57\">\n        <img src=\"https://images.unsplash.com/photo-1565626424178-c699f6601afd?auto=format&w=800&q=80&fit=crop\" alt=\"Work 1\" data-kid=\"58\">\n        <div class=\"absolute inset-0 p-8 flex flex-col justify-end bg-gradient-to-t from-black/90 to-transparent opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"59\">\n          <div class=\"font-mono text-(--vermillion) mb-2\" data-kid=\"60\">01 / ARCHITECTURAL</div>\n          <h3 class=\"font-black text-5xl text-white uppercase italic leading-none\" data-kid=\"61\">LINEA FLORA</h3>\n        </div>\n      </div>\n      <div class=\"project-card-3d group\" data-kid=\"62\">\n        <img src=\"https://images.pexels.com/photos/17536451/pexels-photo-17536451.jpeg?auto=compress&cs=tinysrgb&w=800\" alt=\"Work 2\" data-kid=\"63\">\n        <div class=\"absolute inset-0 p-8 flex flex-col justify-end bg-gradient-to-t from-black/90 to-transparent opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"64\">\n          <div class=\"font-mono text-(--vermillion) mb-2\" data-kid=\"65\">02 / PRODUCT</div>\n          <h3 class=\"font-black text-5xl text-white uppercase italic leading-none\" data-kid=\"66\">ANISCOPE</h3>\n        </div>\n      </div>\n      <div class=\"project-card-3d group\" data-kid=\"67\">\n        <img src=\"https://images.unsplash.com/photo-1599577215410-266db4327135?auto=format&w=800&q=80&fit=crop\" alt=\"Work 3\" data-kid=\"68\">\n        <div class=\"absolute inset-0 p-8 flex flex-col justify-end bg-gradient-to-t from-black/90 to-transparent opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"69\">\n          <div class=\"font-mono text-(--vermillion) mb-2\" data-kid=\"70\">03 / UTILITY</div>\n          <h3 class=\"font-black text-5xl text-white uppercase italic leading-none\" data-kid=\"71\">G_FINDER</h3>\n        </div>\n      </div>\n      <div class=\"project-card-3d group\" data-kid=\"72\">\n        <img src=\"https://images.unsplash.com/photo-1548733865-2ff7802d2b3f?auto=format&w=800&q=80&fit=crop\" alt=\"Work 4\" data-kid=\"73\">\n        <div class=\"absolute inset-0 p-8 flex flex-col justify-end bg-gradient-to-t from-black/90 to-transparent opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"74\">\n          <div class=\"font-mono text-(--vermillion) mb-2\" data-kid=\"75\">04 / EXPERIMENT</div>\n          <h3 class=\"font-black text-5xl text-white uppercase italic leading-none\" data-kid=\"76\">SENSE_GALLERY</h3>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"stats\" class=\"py-40 bg-(--paper)\" data-kid=\"77\">\n    <div class=\"px-20 grid grid-cols-12 gap-10\" data-kid=\"78\">\n      <div class=\"col-span-5\" data-kid=\"79\">\n        <h2 class=\"extruded-text text-8xl mb-10 italic\" data-kid=\"80\">STATS<br data-kid=\"81\"><span class=\"text-(--cobalt)\" data-kid=\"82\">OVERDRIVE</span></h2>\n        <p class=\"font-medium text-xl leading-relaxed max-w-md\" data-kid=\"83\">\n          Technical weaponry rendered in high-fidelity. Continuous iteration on performance and kinetic physics.\n        </p>\n      </div>\n      <div class=\"col-span-7 grid grid-cols-2 gap-8\" data-kid=\"84\">\n        <div class=\"stat-cube flex flex-col items-center justify-center\" data-kid=\"85\">\n          <span class=\"font-black text-7xl text-(--vermillion) leading-none\" data-kid=\"86\">99</span>\n          <span class=\"font-mono font-bold mt-4 uppercase tracking-tighter\" data-kid=\"87\">React Core</span>\n          <i class=\"ti ti-activity text-4xl mt-4 text-(--cobalt)\" data-kid=\"88\"></i>\n        </div>\n        <div class=\"stat-cube flex flex-col items-center justify-center\" data-kid=\"89\">\n          <span class=\"font-black text-7xl text-(--vermillion) leading-none\" data-kid=\"90\">85</span>\n          <span class=\"font-mono font-bold mt-4 uppercase tracking-tighter\" data-kid=\"91\">TypeScript</span>\n          <i class=\"ti ti-binary text-4xl mt-4 text-(--cobalt)\" data-kid=\"92\"></i>\n        </div>\n        <div class=\"stat-cube flex flex-col items-center justify-center\" data-kid=\"93\">\n          <span class=\"font-black text-7xl text-(--vermillion) leading-none\" data-kid=\"94\">92</span>\n          <span class=\"font-mono font-bold mt-4 uppercase tracking-tighter\" data-kid=\"95\">Motion JS</span>\n          <i class=\"ti ti-vector text-4xl mt-4 text-(--cobalt)\" data-kid=\"96\"></i>\n        </div>\n        <div class=\"stat-cube flex flex-col items-center justify-center\" data-kid=\"97\">\n          <span class=\"font-black text-7xl text-(--vermillion) leading-none\" data-kid=\"98\">88</span>\n          <span class=\"font-mono font-bold mt-4 uppercase tracking-tighter\" data-kid=\"99\">Systems</span>\n          <i class=\"ti ti-cpu text-4xl mt-4 text-(--cobalt)\" data-kid=\"100\"></i>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer id=\"contact\" class=\"py-40 bg-(--ink) border-t-8 border-(--cobalt) relative overflow-hidden\" data-kid=\"101\">\n    <div class=\"px-20 flex flex-col items-center text-center gap-12 relative z-10\" data-kid=\"102\">\n      <h2 class=\"extruded-text text-[12vw] text-white italic leading-none\" data-kid=\"103\">SEND_SIGNAL</h2>\n      \n      <div class=\"flex gap-6\" data-kid=\"104\">\n        <a href=\"mailto:hello@barbate.xyz\" class=\"manga-panel-3d px-12 py-6 bg-white font-black text-2xl uppercase italic hover:bg-(--vermillion) hover:text-white\" data-kid=\"105\">Email_Archive</a>\n        <a href=\"#\" class=\"manga-panel-3d px-12 py-6 bg-white font-black text-2xl uppercase italic hover:bg-(--cobalt) hover:text-white\" data-kid=\"106\">Social_X</a>\n      </div>\n\n      <div class=\"mt-20 w-full border-t border-white/10 pt-12 flex justify-between font-mono text-xs uppercase text-white/40 tracking-[0.5em]\" data-kid=\"107\">\n        <span data-kid=\"108\">© 2024 ARYAN_BARBATE</span>\n        <span data-kid=\"109\">CH_01_COMPLETE</span>\n        <span data-kid=\"110\">TOP_SIGNAL [^]</span>\n      </div>\n    </div>\n  </footer>\n</main>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"111\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"112\"></script>\n<script data-kid=\"113\">\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Loader Timeline\n  const tl = gsap.timeline();\n  tl.to(\"#loader-slash\", {\n    width: \"400%\",\n    duration: 1.5,\n    ease: \"power4.inOut\"\n  })\n  .to(\"#loader\", {\n    yPercent: -100,\n    duration: 1.2,\n    ease: \"expo.inOut\"\n  }, \"-=0.5\");\n\n  // Hero Panel 3D Rotation on Mouse Move\n  const heroPanel = document.querySelector(\"#hero-image-panel\");\n  document.addEventListener(\"mousemove\", (e) => {\n    const xAxis = (window.innerWidth / 2 - e.pageX) / 25;\n    const yAxis = (window.innerHeight / 2 - e.pageY) / 25;\n    gsap.to(heroPanel, {\n      rotateY: xAxis,\n      rotateX: yAxis,\n      duration: 0.5,\n      ease: \"power2.out\"\n    });\n  });\n\n  // Scroll Animations\n  gsap.utils.toArray('.extruded-text').forEach(text => {\n    gsap.from(text, {\n      scrollTrigger: {\n        trigger: text,\n        start: \"top 90%\",\n      },\n      y: 50,\n      opacity: 0,\n      skewX: 10,\n      duration: 1,\n      ease: \"back.out(1.7)\"\n    });\n  });\n\n  // Stat Cubes Tilt on Scroll\n  gsap.utils.toArray('.stat-cube').forEach((cube, i) => {\n    gsap.to(cube, {\n      scrollTrigger: {\n        trigger: \"#stats\",\n        start: \"top bottom\",\n        end: \"bottom top\",\n        scrub: 1\n      },\n      rotateY: i % 2 === 0 ? 15 : -15,\n      rotateX: 10,\n      translateZ: 20\n    });\n  });\n\n  // Work Grid Perspective Tilt\n  gsap.to(\".work-grid-3d\", {\n    scrollTrigger: {\n      trigger: \"#work\",\n      start: \"top bottom\",\n      end: \"bottom top\",\n      scrub: 1\n    },\n    rotateX: 10,\n    y: -50\n  });\n</script>",
      "comments": [],
      "created": "2026-07-10T05:13:14.681123+00:00",
      "modified": "2026-07-10T05:13:44.119803+00:00",
      "id": "var_478a9176f04c",
      "viewportScrollY": 3443
    },
    "var_ada8bbdc0c1b": {
      "type": "variant",
      "label": "Origami Diorama",
      "parentId": "var_87ef19eafbe3",
      "themeId": null,
      "rect": {
        "x": 6160,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Chivo:wght@300;400;700&family=Space+Mono&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --paper: #F9F6F0;\n    --ink: #050505;\n    --cobalt: #0033CC;\n    --orange: #D34500;\n    --font-header: 'Bebas Neue', sans-serif;\n    --font-body: 'Chivo', sans-serif;\n    --font-mono: 'Space Mono', monospace;\n    --border-thick: 4px solid var(--ink);\n    --shadow-solid: 10px 10px 0px var(--ink);\n    --ease-snap: cubic-bezier(0.34, 1.56, 0.64, 1);\n  }\n\n  body {\n    background-color: #e5e0d5; /* Darker paper for surrounding desk feel */\n    color: var(--ink);\n    font-family: var(--font-body);\n    margin: 0;\n    overflow-x: hidden;\n    perspective: 2000px;\n  }\n\n  .book-container {\n    width: 100%;\n    transform-style: preserve-3d;\n  }\n\n  .page-section {\n    background-color: var(--paper);\n    min-height: 100vh;\n    width: 100%;\n    position: relative;\n    transform-style: preserve-3d;\n    border-bottom: 2px solid rgba(0,0,0,0.1);\n    box-shadow: 0 50px 100px rgba(0,0,0,0.05);\n    z-index: 1;\n  }\n\n  .big-title {\n    font-family: var(--font-header);\n    font-size: 15vw;\n    line-height: 0.8;\n    text-transform: uppercase;\n    margin: 0;\n  }\n\n  .manga-panel-3d {\n    background: white;\n    border: var(--border-thick);\n    box-shadow: var(--shadow-solid);\n    transform-style: preserve-3d;\n    transition: transform 0.5s var(--ease-snap);\n  }\n\n  /* Pop-up effect */\n  .popup-trigger:hover .manga-panel-3d {\n    transform: translateZ(50px) rotateX(-5deg);\n  }\n\n  /* Accordion Fold */\n  .accordion-fold {\n    display: flex;\n    perspective: 2000px;\n    height: 60vh;\n    margin: 4rem 0;\n  }\n\n  .fold {\n    flex: 1;\n    height: 100%;\n    position: relative;\n    transform-style: preserve-3d;\n    transition: transform 0.8s var(--ease-snap);\n    transform-origin: left;\n    border: var(--border-thick);\n    display: flex;\n    flex-direction: column;\n    padding: 2rem;\n  }\n\n  .fold-left { background: var(--orange); color: white; transform: rotateY(30deg); }\n  .fold-right { background: var(--cobalt); color: white; transform: rotateY(-30deg) translateX(-20px); }\n\n  /* 3D Diorama Work */\n  .diorama-stage {\n    height: 80vh;\n    background: #f0ede4;\n    border-top: var(--border-thick);\n    border-bottom: var(--border-thick);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    overflow: hidden;\n    position: relative;\n  }\n\n  .diorama-layer {\n    position: absolute;\n    transition: transform 0.1s linear;\n  }\n\n  .layer-bg { z-index: 1; opacity: 0.3; }\n  .layer-mid { z-index: 5; }\n  .layer-fg { z-index: 10; }\n\n  /* Cel-shading */\n  .cel-shade {\n    position: relative;\n    overflow: hidden;\n  }\n  .cel-shade::after {\n    content: '';\n    position: absolute;\n    top: 0;\n    right: 0;\n    width: 30%;\n    height: 100%;\n    background: rgba(0,0,0,0.05);\n    pointer-events: none;\n  }\n\n  /* Custom Loader */\n  #loader-overlay {\n    position: fixed;\n    inset: 0;\n    background: var(--ink);\n    z-index: 9999;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: var(--paper);\n    transform-origin: left;\n  }\n\n  .floating-stat {\n    animation: float 4s ease-in-out infinite alternate;\n  }\n  @keyframes float {\n    from { transform: translateY(0) rotateX(0); }\n    to { transform: translateY(-20px) rotateX(10deg); }\n  }\n\n  .halftone-dots {\n    background-image: radial-gradient(var(--ink) 1.5px, transparent 0);\n    background-size: 10px 10px;\n    opacity: 0.05;\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n  }\n</style>\n\n\n<div id=\"loader-overlay\" data-kid=\"1\">\n  <div class=\"flex flex-col items-center gap-8\" data-kid=\"2\">\n    <div class=\"w-64 h-1 bg-white/20 relative overflow-hidden\" data-kid=\"3\">\n      <div id=\"loader-progress\" class=\"absolute inset-0 bg-[var(--orange)] w-0\" data-kid=\"4\"></div>\n    </div>\n    <div class=\"font-mono text-xs tracking-[0.5em] uppercase animate-pulse\" data-kid=\"5\">Initializing Pop-up Universe</div>\n  </div>\n</div>\n\n<div class=\"book-container\" data-kid=\"6\">\n  \n  <section class=\"page-section flex items-center px-20 overflow-hidden\" style=\"transform-origin: left;\" id=\"hero\" data-kid=\"7\">\n    <div class=\"halftone-dots\" data-kid=\"8\"></div>\n    <div class=\"grid grid-cols-12 gap-12 w-full items-center\" data-kid=\"9\">\n      <div class=\"col-span-7\" style=\"transform: translateZ(100px)\" data-kid=\"10\">\n        <div class=\"manga-panel-3d bg-white p-12 relative\" data-kid=\"11\">\n          <span class=\"font-mono text-sm uppercase tracking-widest text-[var(--orange)] mb-4 block\" data-kid=\"12\">Chapter 01 / Introduction</span>\n          <h1 class=\"big-title mb-8\" data-kid=\"13\">ARYAN<br data-kid=\"14\">BARBATE</h1>\n          <p class=\"text-2xl font-light leading-relaxed max-w-xl\" data-kid=\"15\">\n            I craft digital <span class=\"text-[var(--orange)] font-bold italic\" data-kid=\"16\">dioramas</span>. \n            Merging frontend architectural excellence with tactile manga kinetics.\n          </p>\n          <div class=\"flex gap-6 mt-12\" data-kid=\"17\">\n            <button class=\"manga-panel-3d bg-[var(--ink)] text-white px-10 py-5 font-header text-3xl tracking-widest hover:bg-[var(--orange)]\" data-kid=\"18\">ENTER ARCHIVE</button>\n            <button class=\"manga-panel-3d bg-white px-10 py-5 font-header text-3xl tracking-widest hover:text-[var(--cobalt)]\" data-kid=\"19\">ORIGIN STORY</button>\n          </div>\n        </div>\n      </div>\n      <div class=\"col-span-5 relative\" data-kid=\"20\">\n        <div class=\"manga-panel-3d aspect-[3/4] rotateY(-15deg) rotateX(5deg) overflow-hidden\" style=\"transform: translateZ(200px)\" data-kid=\"21\">\n          <img src=\"https://images.unsplash.com/photo-1622547748225-3fc4abd2cca0?auto=format&w=800&q=80&fit=crop\" class=\"w-full h-full object-cover grayscale contrast-150\" alt=\"3D Geometric Shape\" data-kid=\"22\">\n          <div class=\"absolute inset-0 bg-gradient-to-tr from-[var(--cobalt)]/40 to-transparent\" data-kid=\"23\"></div>\n        </div>\n        \n        <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/supersonic-bullet.svg\" class=\"absolute -top-10 -right-10 w-40 opacity-10 rotate-45\" style=\"color: var(--ink);\" data-kid=\"24\">\n      </div>\n    </div>\n  </section>\n\n  \n  <div class=\"bg-[var(--ink)] py-6 border-y-4 border-black overflow-hidden flex whitespace-nowrap rotateX(10deg)\" style=\"transform-style: preserve-3d;\" data-kid=\"25\">\n    <div class=\"flex animate-[marquee_30s_linear_infinite] gap-12 items-center\" data-kid=\"26\">\n      <span class=\"font-header text-6xl text-white tracking-tighter\" data-kid=\"27\">REACT DEVELOPER</span>\n      <div class=\"w-4 h-4 bg-[var(--orange)] rotate-45\" data-kid=\"28\"></div>\n      <span class=\"font-header text-6xl text-[var(--cobalt)] tracking-tighter\" data-kid=\"29\">GSAP ARCHITECT</span>\n      <div class=\"w-4 h-4 bg-white rotate-45\" data-kid=\"30\"></div>\n      <span class=\"font-header text-6xl text-white tracking-tighter\" data-kid=\"31\">3D WEB CRAFT</span>\n      <div class=\"w-4 h-4 bg-[var(--orange)] rotate-45\" data-kid=\"32\"></div>\n      <span class=\"font-header text-6xl text-[var(--cobalt)] tracking-tighter\" data-kid=\"33\">MANGA EDITORIAL</span>\n    </div>\n  </div>\n\n  \n  <section class=\"page-section py-32 px-20\" id=\"work\" data-kid=\"34\">\n    <div class=\"mb-20\" data-kid=\"35\">\n      <h2 class=\"font-header text-9xl leading-none\" data-kid=\"36\">FEATURED<br data-kid=\"37\"><span class=\"text-[var(--cobalt)]\" data-kid=\"38\">WORKS</span></h2>\n      <div class=\"w-32 h-2 bg-[var(--ink)] mt-4\" data-kid=\"39\"></div>\n    </div>\n\n    \n    <div class=\"diorama-stage manga-panel-3d\" data-kid=\"40\">\n      <div class=\"halftone-dots\" data-kid=\"41\"></div>\n      \n      \n      <div class=\"relative w-full h-full flex items-center justify-center translateZ(0)\" data-kid=\"42\">\n        \n        <div class=\"diorama-layer layer-bg scale-150\" data-depth=\"0.1\" data-kid=\"43\">\n          <h3 class=\"font-header text-[20vw] text-[var(--ink)] select-none\" data-kid=\"44\">LINEA</h3>\n        </div>\n        \n        <div class=\"diorama-layer layer-mid\" data-depth=\"0.5\" data-kid=\"45\">\n          <div class=\"manga-panel-3d w-[600px] aspect-video overflow-hidden\" data-kid=\"46\">\n            <img src=\"https://images.pexels.com/photos/12024938/pexels-photo-12024938.jpeg\" class=\"w-full h-full object-cover\" alt=\"Linea Flora\" data-kid=\"47\">\n          </div>\n        </div>\n        \n        <div class=\"diorama-layer layer-fg translate-x-48 translate-y-32\" data-depth=\"1.2\" data-kid=\"48\">\n          <div class=\"manga-panel-3d bg-[var(--orange)] text-white p-8 w-80\" data-kid=\"49\">\n            <span class=\"font-mono text-xs uppercase font-bold mb-2 block\" data-kid=\"50\">01 / Creative Builder</span>\n            <h4 class=\"font-header text-5xl mb-4\" data-kid=\"51\">LINEA FLORA</h4>\n            <p class=\"text-sm font-medium mb-6\" data-kid=\"52\">Editorial flower curation with a high-motion soul.</p>\n            <button class=\"w-full py-3 bg-white text-[var(--ink)] font-bold uppercase tracking-widest text-xs\" data-kid=\"53\">Explore Panel</button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"page-section py-32 px-20 bg-[#f4f0e8]\" id=\"journey\" data-kid=\"54\">\n    <div class=\"flex justify-between items-end mb-20\" data-kid=\"55\">\n       <h2 class=\"font-header text-8xl\" data-kid=\"56\">DEVELOPER<br data-kid=\"57\"><span class=\"text-[var(--orange)]\" data-kid=\"58\">EVOLUTION</span></h2>\n       <div class=\"font-mono text-right text-xs opacity-40 uppercase tracking-widest\" data-kid=\"59\">Tracking growth / 2020 - 2024</div>\n    </div>\n\n    <div class=\"accordion-fold\" data-kid=\"60\">\n      <div class=\"fold fold-left cel-shade\" data-kid=\"61\">\n        <div class=\"text-7xl font-header\" data-kid=\"62\">01</div>\n        <h3 class=\"text-3xl font-header mt-auto\" data-kid=\"63\">THE SEED</h3>\n        <p class=\"font-mono text-xs mt-4\" data-kid=\"64\">Discovering the logic behind the layout. First contact with the DOM.</p>\n      </div>\n      <div class=\"fold bg-white cel-shade\" data-kid=\"65\">\n        <div class=\"text-7xl font-header\" data-kid=\"66\">02</div>\n        <h3 class=\"text-3xl font-header mt-auto\" data-kid=\"67\">THE ROOT</h3>\n        <h3 class=\"text-3xl font-header mt-auto\" data-kid=\"68\">THE ROOT</h3>\n        <p class=\"font-mono text-xs mt-4 text-[var(--ink)]\" data-kid=\"69\">Building systems. React, state, and complex data flows.</p>\n      </div>\n      <div class=\"fold fold-right cel-shade\" data-kid=\"70\">\n        <div class=\"text-7xl font-header\" data-kid=\"71\">03</div>\n        <h3 class=\"text-3xl font-header mt-auto\" data-kid=\"72\">THE BLOOM</h3>\n        <p class=\"font-mono text-xs mt-4\" data-kid=\"73\">Merging design and tech into cohesive high-craft interfaces.</p>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"page-section py-32 px-20\" id=\"skills\" data-kid=\"74\">\n    <div class=\"grid grid-cols-12 gap-20\" data-kid=\"75\">\n      <div class=\"col-span-4\" data-kid=\"76\">\n        <div class=\"manga-panel-3d bg-[var(--cobalt)] text-white p-12 rotateX(10deg)\" data-kid=\"77\">\n          <h2 class=\"font-header text-7xl mb-6\" data-kid=\"78\">COMBAT<br data-kid=\"79\">SKILLS</h2>\n          <p class=\"text-lg opacity-80\" data-kid=\"80\">\n            A specialized arsenal for building performant, motion-driven 3D experiences.\n          </p>\n        </div>\n      </div>\n      <div class=\"col-span-8 grid grid-cols-2 gap-8\" data-kid=\"81\">\n        <div class=\"manga-panel-3d bg-white p-10 floating-stat\" data-kid=\"82\">\n          <div class=\"flex justify-between items-center mb-8\" data-kid=\"83\">\n            <h4 class=\"font-header text-4xl\" data-kid=\"84\">FRONTEND</h4>\n            <span class=\"text-5xl font-header text-[var(--orange)]\" data-kid=\"85\">99%</span>\n          </div>\n          <ul class=\"font-mono text-sm space-y-3 opacity-60\" data-kid=\"86\">\n            <li data-kid=\"87\">> React.js / Next.js</li>\n            <li data-kid=\"88\">> TypeScript / ES6</li>\n            <li data-kid=\"89\">> Tailwind / SCSS</li>\n          </ul>\n        </div>\n        <div class=\"manga-panel-3d bg-white p-10 floating-stat\" style=\"animation-delay: -2s\" data-kid=\"90\">\n          <div class=\"flex justify-between items-center mb-8\" data-kid=\"91\">\n            <h4 class=\"font-header text-4xl\" data-kid=\"92\">MOTION</h4>\n            <span class=\"text-5xl font-header text-[var(--cobalt)]\" data-kid=\"93\">95%</span>\n          </div>\n          <ul class=\"font-mono text-sm space-y-3 opacity-60\" data-kid=\"94\">\n            <li data-kid=\"95\">> GSAP / ScrollTrigger</li>\n            <li data-kid=\"96\">> Framer Motion</li>\n            <li data-kid=\"97\">> Three.js / WebGL</li>\n          </ul>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"page-section py-40 px-20 bg-[var(--ink)] text-white flex items-center justify-center overflow-hidden\" id=\"contact\" data-kid=\"98\">\n    <div class=\"absolute inset-0 halftone-dots opacity-20\" data-kid=\"99\"></div>\n    \n    <div class=\"relative w-full max-w-4xl transform-style-preserve-3d\" id=\"contact-fold-container\" data-kid=\"100\">\n      \n      <div class=\"manga-panel-3d bg-[var(--paper)] p-16 text-[var(--ink)] flex flex-col gap-12 rotateX(60deg)\" style=\"transform-origin: bottom;\" id=\"contact-panel\" data-kid=\"101\">\n        <div class=\"flex justify-between items-start\" data-kid=\"102\">\n          <div data-kid=\"103\">\n            <h2 class=\"font-header text-8xl leading-none\" data-kid=\"104\">LET'S<br data-kid=\"105\"><span class=\"text-[var(--orange)]\" data-kid=\"106\">CONNECT</span></h2>\n            <p class=\"font-mono text-sm mt-4 opacity-60\" data-kid=\"107\">Initializing transmission channel...</p>\n          </div>\n          <div class=\"w-32 h-32 border-4 border-dashed border-[var(--ink)] flex items-center justify-center\" data-kid=\"108\">\n            <i class=\"ti ti-mail text-5xl\" data-kid=\"109\"></i>\n          </div>\n        </div>\n\n        <form class=\"grid grid-cols-2 gap-8\" data-kid=\"110\">\n          <div class=\"flex flex-col gap-2\" data-kid=\"111\">\n            <label class=\"font-mono text-[10px] uppercase font-bold\" data-kid=\"112\">NAME_FIELD</label>\n            <input type=\"text\" placeholder=\"TYPE YOUR NAME\" class=\"bg-transparent border-b-4 border-black p-4 font-header text-3xl outline-none placeholder:opacity-20 focus:border-[var(--orange)]\" data-kid=\"113\">\n          </div>\n          <div class=\"flex flex-col gap-2\" data-kid=\"114\">\n            <label class=\"font-mono text-[10px] uppercase font-bold\" data-kid=\"115\">EMAIL_FIELD</label>\n            <input type=\"email\" placeholder=\"TYPE YOUR EMAIL\" class=\"bg-transparent border-b-4 border-black p-4 font-header text-3xl outline-none placeholder:opacity-20 focus:border-[var(--cobalt)]\" data-kid=\"116\">\n          </div>\n          <div class=\"col-span-2 flex flex-col gap-2\" data-kid=\"117\">\n            <label class=\"font-mono text-[10px] uppercase font-bold\" data-kid=\"118\">MESSAGE_FIELD</label>\n            <textarea placeholder=\"WHAT'S ON YOUR MIND?\" class=\"bg-transparent border-b-4 border-black p-4 font-header text-3xl outline-none placeholder:opacity-20 focus:border-[var(--orange)] h-32\" data-kid=\"119\"></textarea>\n          </div>\n          <button class=\"col-span-2 manga-panel-3d bg-[var(--ink)] text-white py-6 font-header text-4xl tracking-[0.2em] hover:bg-[var(--orange)] transition-all\" data-kid=\"120\">SEND TRANSMISSION</button>\n        </form>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"py-20 px-20 bg-black text-white relative border-t-8 border-[var(--orange)]\" style=\"transform: rotateX(20deg); transform-origin: top;\" data-kid=\"121\">\n    <div class=\"flex flex-col items-center gap-12\" data-kid=\"122\">\n      <div class=\"font-header text-[12vw] opacity-10\" data-kid=\"123\">END CHAPTER</div>\n      <div class=\"flex gap-20 font-header text-4xl\" data-kid=\"124\">\n        <a href=\"#\" class=\"hover:text-[var(--orange)]\" data-kid=\"125\">TWITTER</a>\n        <a href=\"#\" class=\"hover:text-[var(--cobalt)]\" data-kid=\"126\">GITHUB</a>\n        <a href=\"#\" class=\"hover:text-[var(--orange)]\" data-kid=\"127\">LINKEDIN</a>\n      </div>\n      <div class=\"mt-20 flex justify-between w-full font-mono text-[10px] tracking-widest opacity-30\" data-kid=\"128\">\n        <span data-kid=\"129\">© 2024 / ORIGAMI_EDITION</span>\n        <span data-kid=\"130\">STAY KINETIC</span>\n        <span data-kid=\"131\">BACK TO COVER [^]</span>\n      </div>\n    </div>\n  </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"132\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"133\"></script>\n<script data-kid=\"134\">\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Loader sequence\n  const tl = gsap.timeline();\n  tl.to(\"#loader-progress\", { width: \"100%\", duration: 1.5, ease: \"power2.inOut\" })\n    .to(\"#loader-overlay\", { rotateY: -90, duration: 1.2, ease: \"power4.inOut\", transformOrigin: \"left\" })\n    .from(\"#hero\", { scale: 1.2, duration: 1.5, ease: \"power2.out\" }, \"-=0.5\");\n\n  // Section unfolding (Accordion effect)\n  gsap.utils.toArray('.page-section').forEach(section => {\n    gsap.from(section, {\n      scrollTrigger: {\n        trigger: section,\n        start: \"top bottom\",\n        end: \"top center\",\n        scrub: 1\n      },\n      rotateX: 45,\n      transformOrigin: \"top\"\n    });\n  });\n\n  // Diorama parallax\n  window.addEventListener('mousemove', (e) => {\n    const x = (window.innerWidth / 2 - e.pageX) / 50;\n    const y = (window.innerHeight / 2 - e.pageY) / 50;\n    \n    gsap.to('.diorama-layer', {\n      x: (i, target) => x * target.dataset.depth * 50,\n      y: (i, target) => y * target.dataset.depth * 50,\n      duration: 0.5,\n      ease: \"power2.out\"\n    });\n  });\n\n  // Fold animation\n  gsap.to(\".fold-left\", {\n    scrollTrigger: {\n      trigger: \".accordion-fold\",\n      start: \"top 80%\",\n      end: \"bottom 20%\",\n      scrub: 1\n    },\n    rotateY: 10\n  });\n\n  gsap.to(\".fold-right\", {\n    scrollTrigger: {\n      trigger: \".accordion-fold\",\n      start: \"top 80%\",\n      end: \"bottom 20%\",\n      scrub: 1\n    },\n    rotateY: -10,\n    x: 0\n  });\n\n  // Contact pop-up\n  gsap.to(\"#contact-panel\", {\n    scrollTrigger: {\n      trigger: \"#contact\",\n      start: \"top 60%\",\n      end: \"top 20%\",\n      scrub: 1\n    },\n    rotateX: 0,\n    y: -50\n  });\n\n</script>",
      "comments": [],
      "created": "2026-07-10T05:13:17.082560+00:00",
      "modified": "2026-07-10T05:13:45.377780+00:00",
      "id": "var_ada8bbdc0c1b",
      "viewportScrollY": 0
    },
    "var_b8a72a1545b6": {
      "type": "variant",
      "label": "Kinetic Z-Plunge",
      "parentId": "var_87ef19eafbe3",
      "themeId": null,
      "rect": {
        "x": 12320,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;700&family=JetBrains+Mono:wght@400;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --bone: #EAE5D9;\n    --black: #0F0F0F;\n    --cobalt: #1A5FFF;\n    --vermillion: #FF4500;\n    --panel-border: 6px solid var(--black);\n    --font-header: 'Anton', sans-serif;\n    --font-body: 'Inter', sans-serif;\n    --font-mono: 'JetBrains Mono', monospace;\n  }\n\n  body {\n    background-color: var(--black);\n    color: var(--bone);\n    font-family: var(--font-body);\n    margin: 0;\n    overflow-x: hidden;\n    perspective: 1500px;\n  }\n\n  .perspective-tunnel {\n    position: relative;\n    width: 100%;\n    transform-style: preserve-3d;\n  }\n\n  .halftone-bg {\n    position: fixed;\n    inset: 0;\n    background-image: radial-gradient(var(--bone) 1.5px, transparent 0);\n    background-size: 10px 10px;\n    opacity: 0.05;\n    z-index: -1;\n  }\n\n  .z-plunge-title {\n    position: relative;\n    transform-style: preserve-3d;\n    height: 100vh;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .z-layer {\n    position: absolute;\n    font-family: var(--font-header);\n    font-size: 15vw;\n    text-transform: uppercase;\n    white-space: nowrap;\n    pointer-events: none;\n    line-height: 0.8;\n  }\n\n  .z-layer:nth-child(1) { transform: translateZ(0); color: var(--vermillion); z-index: 5; }\n  .z-layer:nth-child(2) { transform: translateZ(-100px); color: var(--cobalt); opacity: 0.6; z-index: 4; }\n  .z-layer:nth-child(3) { transform: translateZ(-200px); color: var(--bone); opacity: 0.4; z-index: 3; }\n  .z-layer:nth-child(4) { transform: translateZ(-300px); color: var(--cobalt); opacity: 0.2; z-index: 2; }\n  .z-layer:nth-child(5) { transform: translateZ(-400px); color: var(--vermillion); opacity: 0.1; z-index: 1; }\n\n  .manga-page-section {\n    position: relative;\n    min-height: 100vh;\n    width: 100%;\n    transform-origin: left center;\n    transition: transform 1s cubic-bezier(0.645, 0.045, 0.355, 1);\n    transform-style: preserve-3d;\n    background: var(--bone);\n    color: var(--black);\n    padding: 80px 40px;\n    border-left: 20px solid var(--black);\n    box-sizing: border-box;\n  }\n\n  .manga-page-section.turned {\n    transform: rotateY(-110deg);\n  }\n\n  .content-panel {\n    border: var(--panel-border);\n    padding: 2rem;\n    background: white;\n    box-shadow: 12px 12px 0px var(--black);\n    margin-bottom: 2rem;\n    transform-style: preserve-3d;\n  }\n\n  .vermillion-slash {\n    position: absolute;\n    top: 0;\n    left: 45%;\n    width: 12px;\n    height: 100%;\n    background: var(--vermillion);\n    transform: skewX(-15deg);\n    box-shadow: 0 0 30px var(--vermillion);\n    z-index: 10;\n  }\n\n  /* 3D Stat Cubes */\n  .cube-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n    gap: 4rem;\n    padding: 4rem 0;\n  }\n\n  .cube-container {\n    width: 200px;\n    height: 200px;\n    perspective: 1000px;\n    margin: 0 auto;\n  }\n\n  .cube {\n    width: 100%;\n    height: 100%;\n    position: relative;\n    transform-style: preserve-3d;\n    animation: rotate-cube 10s infinite linear;\n  }\n\n  .cube-face {\n    position: absolute;\n    width: 200px;\n    height: 200px;\n    border: 4px solid var(--black);\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    background: white;\n    font-family: var(--font-header);\n    backface-visibility: visible;\n  }\n\n  .face-front  { transform: translateZ(100px); }\n  .face-back   { transform: rotateY(180deg) translateZ(100px); }\n  .face-right  { transform: rotateY(90deg) translateZ(100px); background: var(--cobalt); color: white; }\n  .face-left   { transform: rotateY(-90deg) translateZ(100px); background: var(--vermillion); color: white; }\n  .face-top    { transform: rotateX(90deg) translateZ(100px); }\n  .face-bottom { transform: rotateX(-90deg) translateZ(100px); }\n\n  @keyframes rotate-cube {\n    from { transform: rotateX(0) rotateY(0); }\n    to { transform: rotateX(360deg) rotateY(360deg); }\n  }\n\n  .nav-float {\n    position: fixed;\n    top: 2rem;\n    right: 2rem;\n    z-index: 1000;\n    display: flex;\n    gap: 1rem;\n  }\n\n  .nav-btn {\n    background: var(--black);\n    color: var(--bone);\n    border: none;\n    padding: 0.5rem 1rem;\n    font-family: var(--font-mono);\n    font-size: 0.75rem;\n    text-transform: uppercase;\n    cursor: pointer;\n    border: 2px solid var(--bone);\n  }\n\n  .nav-btn:hover {\n    background: var(--vermillion);\n    color: white;\n  }\n</style>\n\n<div class=\"halftone-bg\" data-kid=\"1\"></div>\n\n<nav class=\"nav-float\" data-kid=\"2\">\n  <button class=\"nav-btn\" onclick=\"turnPage()\" data-kid=\"3\">Next Chapter / Page</button>\n  <button class=\"nav-btn\" data-kid=\"4\">Terminal [~]</button>\n</nav>\n\n<div class=\"perspective-tunnel\" data-kid=\"5\">\n  \n  <section class=\"z-plunge-title\" id=\"hero\" data-kid=\"6\">\n    <div class=\"z-layer\" data-kid=\"7\">ARYAN BARBATE</div>\n    <div class=\"z-layer\" data-kid=\"8\">ARYAN BARBATE</div>\n    <div class=\"z-layer\" data-kid=\"9\">ARYAN BARBATE</div>\n    <div class=\"z-layer\" data-kid=\"10\">ARYAN BARBATE</div>\n    <div class=\"z-layer\" data-kid=\"11\">ARYAN BARBATE</div>\n    \n    <div class=\"absolute bottom-20 left-20 font-mono text-xs max-w-xs opacity-60\" data-kid=\"12\">\n      [!] INITIATING Z-AXIS PLUNGE... <br data-kid=\"13\">\n      DECODING FRONTEND ARCHITECTURE...\n    </div>\n  </section>\n\n  \n  <section class=\"manga-page-section\" id=\"projects\" data-kid=\"14\">\n    <div class=\"vermillion-slash\" data-kid=\"15\"></div>\n    <h2 class=\"font-[Anton] text-[10vw] leading-none mb-12 uppercase italic\" data-kid=\"16\">Selected <span class=\"text-(--cobalt)\" data-kid=\"17\">Artifacts</span></h2>\n    \n    <div class=\"grid grid-cols-2 gap-12\" data-kid=\"18\">\n      <div class=\"content-panel\" data-kid=\"19\">\n        <div class=\"aspect-video bg-gray-200 mb-6 border-4 border-black overflow-hidden relative\" data-kid=\"20\">\n          <img src=\"https://images.unsplash.com/photo-1546414701-81cc6963c67f?auto=format&w=800&q=80&fit=crop\" class=\"w-full h-full object-cover grayscale\" loading=\"lazy\" data-kid=\"21\">\n          <div class=\"absolute inset-0 bg-(--cobalt) mix-blend-multiply opacity-40\" data-kid=\"22\"></div>\n        </div>\n        <h3 class=\"font-[Anton] text-4xl uppercase mb-2\" data-kid=\"23\">Linea Flora</h3>\n        <p class=\"font-mono text-sm opacity-70\" data-kid=\"24\">EDITORIAL / MOTION / FLOWER-TECH</p>\n      </div>\n\n      <div class=\"content-panel translate-y-20\" data-kid=\"25\">\n        <div class=\"aspect-video bg-gray-200 mb-6 border-4 border-black overflow-hidden relative\" data-kid=\"26\">\n          <img src=\"https://images.unsplash.com/photo-1565626424178-c699f6601afd?auto=format&w=800&q=80&fit=crop\" class=\"w-full h-full object-cover grayscale\" loading=\"lazy\" data-kid=\"27\">\n          <div class=\"absolute inset-0 bg-(--vermillion) mix-blend-multiply opacity-40\" data-kid=\"28\"></div>\n        </div>\n        <h3 class=\"font-[Anton] text-4xl uppercase mb-2\" data-kid=\"29\">AniScope</h3>\n        <p class=\"font-mono text-sm opacity-70\" data-kid=\"30\">CINEMATIC / DATA / ANIME-ENGINE</p>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"manga-page-section\" id=\"skills\" data-kid=\"31\">\n    <h2 class=\"font-[Anton] text-[10vw] leading-none mb-12 uppercase\" data-kid=\"32\">Power <span class=\"text-(--vermillion)\" data-kid=\"33\">Levels</span></h2>\n    \n    <div class=\"cube-grid\" data-kid=\"34\">\n      <div class=\"cube-container\" data-kid=\"35\">\n        <div class=\"cube\" data-kid=\"36\">\n          <div class=\"cube-face face-front\" data-kid=\"37\"><i class=\"ti ti-brand-react text-6xl\" data-kid=\"38\"></i></div>\n          <div class=\"cube-face face-back\" data-kid=\"39\"><span class=\"text-4xl\" data-kid=\"40\">LVL 99</span></div>\n          <div class=\"cube-face face-right\" data-kid=\"41\">REACT</div>\n          <div class=\"cube-face face-left\" data-kid=\"42\">VITE</div>\n          <div class=\"cube-face face-top\" data-kid=\"43\"></div>\n          <div class=\"cube-face face-bottom\" data-kid=\"44\"></div>\n        </div>\n      </div>\n\n      <div class=\"cube-container\" data-kid=\"45\">\n        <div class=\"cube\" style=\"animation-delay: -2s;\" data-kid=\"46\">\n          <div class=\"cube-face face-front\" data-kid=\"47\"><i class=\"ti ti-brand-typescript text-6xl\" data-kid=\"48\"></i></div>\n          <div class=\"cube-face face-back\" data-kid=\"49\"><span class=\"text-4xl\" data-kid=\"50\">LVL 85</span></div>\n          <div class=\"cube-face face-right\" data-kid=\"51\">TS</div>\n          <div class=\"cube-face face-left\" data-kid=\"52\">NODE</div>\n          <div class=\"cube-face face-top\" data-kid=\"53\"></div>\n          <div class=\"cube-face face-bottom\" data-kid=\"54\"></div>\n        </div>\n      </div>\n\n      <div class=\"cube-container\" data-kid=\"55\">\n        <div class=\"cube\" style=\"animation-delay: -5s;\" data-kid=\"56\">\n          <div class=\"cube-face face-front\" data-kid=\"57\"><i class=\"ti ti-brand-tailwind text-6xl\" data-kid=\"58\"></i></div>\n          <div class=\"cube-face face-back\" data-kid=\"59\"><span class=\"text-4xl\" data-kid=\"60\">LVL 92</span></div>\n          <div class=\"cube-face face-right\" data-kid=\"61\">CSS</div>\n          <div class=\"cube-face face-left\" data-kid=\"62\">GSAP</div>\n          <div class=\"cube-face face-top\" data-kid=\"63\"></div>\n          <div class=\"cube-face face-bottom\" data-kid=\"64\"></div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"manga-page-section\" id=\"contact\" data-kid=\"65\">\n    <div class=\"max-w-4xl mx-auto py-20\" data-kid=\"66\">\n      <h2 class=\"font-[Anton] text-8xl uppercase leading-none mb-12\" data-kid=\"67\">Transmission <br data-kid=\"68\"> <span class=\"text-(--cobalt)\" data-kid=\"69\">Intercepted</span></h2>\n      <div class=\"content-panel bg-black text-bone\" data-kid=\"70\">\n        <div class=\"font-mono p-4 space-y-4\" data-kid=\"71\">\n          <div class=\"text-(--vermillion)\" data-kid=\"72\">> DEPLOY_TRANSMISSION</div>\n          <div class=\"grid grid-cols-1 gap-6\" data-kid=\"73\">\n            <div data-kid=\"74\">\n              <label class=\"block text-xs uppercase opacity-50 mb-2\" data-kid=\"75\">Identification</label>\n              <input type=\"text\" class=\"w-full bg-transparent border-b-2 border-bone/20 p-2 font-mono outline-none focus:border-vermillion transition-colors\" placeholder=\"ENTER NAME...\" data-kid=\"76\">\n            </div>\n            <div data-kid=\"77\">\n              <label class=\"block text-xs uppercase opacity-50 mb-2\" data-kid=\"78\">Message_Data</label>\n              <textarea class=\"w-full bg-transparent border-b-2 border-bone/20 p-2 font-mono outline-none focus:border-vermillion transition-colors\" rows=\"4\" placeholder=\"INPUT MESSAGE CONTENT...\" data-kid=\"79\"></textarea>\n            </div>\n            <button class=\"bg-vermillion text-white py-4 font-bold uppercase hover:bg-white hover:text-black transition-all\" data-kid=\"80\">Send Burst</button>\n          </div>\n        </div>\n      </div>\n    </div>\n    \n    <footer class=\"mt-20 pt-10 border-t-2 border-black flex justify-between font-mono text-[10px] uppercase opacity-60\" data-kid=\"81\">\n      <span data-kid=\"82\">© 2024 Aryan Barbate / 3D Manga Archive</span>\n      <span data-kid=\"83\">Built in the Z-axis plunge</span>\n    </footer>\n  </section>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"84\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"85\"></script>\n<script data-kid=\"86\">\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Z-Plunge Entrance\n  gsap.from(\".z-layer\", {\n    z: (i) => i * -200,\n    opacity: 0,\n    stagger: 0.1,\n    duration: 2,\n    ease: \"power4.out\"\n  });\n\n  // Title drift\n  gsap.to(\".z-layer\", {\n    x: \"random(-20, 20)\",\n    y: \"random(-20, 20)\",\n    duration: 5,\n    repeat: -1,\n    yoyo: true,\n    ease: \"sine.inOut\"\n  });\n\n  // Page Turn Interaction\n  let currentPage = 0;\n  const pages = document.querySelectorAll('.manga-page-section');\n  \n  function turnPage() {\n    if (currentPage < pages.length) {\n      pages[currentPage].classList.add('turned');\n      currentPage++;\n    } else {\n      pages.forEach(p => p.classList.remove('turned'));\n      currentPage = 0;\n    }\n  }\n\n  // Scroll Triggered Page Turns (Experimental)\n  pages.forEach((page, i) => {\n    ScrollTrigger.create({\n      trigger: page,\n      start: \"top top\",\n      onEnter: () => {\n        if(i > 0) pages[i-1].classList.add('turned');\n      }\n    });\n  });\n\n  // Mouse tilt for content panels\n  document.querySelectorAll('.content-panel').forEach(panel => {\n    panel.addEventListener('mousemove', (e) => {\n      const { left, top, width, height } = panel.getBoundingClientRect();\n      const x = (e.clientX - left) / width - 0.5;\n      const y = (e.clientY - top) / height - 0.5;\n      gsap.to(panel, {\n        rotateY: x * 20,\n        rotateX: -y * 20,\n        duration: 0.5,\n        ease: \"power2.out\"\n      });\n    });\n    panel.addEventListener('mouseleave', () => {\n      gsap.to(panel, { rotateY: 0, rotateX: 0, duration: 1, ease: \"elastic.out(1, 0.3)\" });\n    });\n  });\n</script>",
      "comments": [],
      "created": "2026-07-10T05:13:28.382624+00:00",
      "modified": "2026-07-10T05:13:54.297949+00:00",
      "id": "var_b8a72a1545b6",
      "viewportScrollY": 2858
    },
    "var_cdbf222a443c": {
      "type": "variant",
      "label": "Hyper-Saturated Pop-Art",
      "parentId": "var_ada8bbdc0c1b",
      "themeId": null,
      "rect": {
        "x": 7700,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Chivo:wght@400;700;900&family=Space+Mono:wght@400;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --magenta: #ff00ff;\n    --cyan: #00ffff;\n    --yellow: #ffff00;\n    --black: #000000;\n    --white: #ffffff;\n    --font-header: 'Bebas Neue', sans-serif;\n    --font-body: 'Chivo', sans-serif;\n    --font-mono: 'Space Mono', monospace;\n    --border-max: 6px solid var(--black);\n    --cmyk-shadow: -8px 0px 0px var(--cyan), 8px 0px 0px var(--magenta);\n    --ease-brutal: cubic-bezier(0.9, 0, 0.1, 1);\n  }\n\n  body {\n    background-color: var(--white);\n    color: var(--black);\n    font-family: var(--font-body);\n    margin: 0;\n    overflow-x: hidden;\n    perspective: 1500px;\n  }\n\n  .halftone-bg {\n    background-image: radial-gradient(var(--black) 2px, transparent 0);\n    background-size: 12px 12px;\n    opacity: 0.1;\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n  }\n\n  .pop-panel {\n    background: var(--white);\n    border: var(--border-max);\n    box-shadow: 12px 12px 0px var(--black);\n    position: relative;\n    transform-style: preserve-3d;\n    transition: transform 0.3s var(--ease-brutal);\n  }\n\n  .pop-panel:hover {\n    transform: translateZ(30px) rotateX(-2deg) rotateY(2deg);\n    box-shadow: 20px 20px 0px var(--black);\n  }\n\n  .cmyk-text {\n    text-shadow: -4px 0px 0px var(--cyan), 4px 0px 0px var(--magenta);\n  }\n\n  .big-header {\n    font-family: var(--font-header);\n    font-size: 15vw;\n    line-height: 0.8;\n    text-transform: uppercase;\n  }\n\n  /* Loader Panels */\n  .loader-panel {\n    position: fixed;\n    inset: 0;\n    z-index: 10000;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-family: var(--font-header);\n    font-size: 10vw;\n    color: var(--white);\n    transform-origin: top;\n  }\n\n  /* Diorama Layers */\n  .diorama-stage {\n    height: 90vh;\n    border: var(--border-max);\n    background: var(--yellow);\n    overflow: hidden;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    transform-style: preserve-3d;\n  }\n\n  .diorama-layer {\n    position: absolute;\n    will-change: transform;\n  }\n\n  .pow-graphic {\n    width: 200px;\n    filter: drop-shadow(8px 8px 0px var(--black));\n    z-index: 50;\n  }\n\n  .matrix-bg {\n    background: var(--black);\n    overflow: hidden;\n    position: relative;\n  }\n\n  .skew-tag {\n    background: var(--black);\n    color: var(--white);\n    padding: 4px 12px;\n    font-family: var(--font-mono);\n    font-size: 12px;\n    transform: skewX(-15deg);\n    display: inline-block;\n  }\n</style>\n\n\n<div id=\"loader\" data-kid=\"157\">\n  <div class=\"loader-panel bg-black\" style=\"z-index: 10006;\" data-kid=\"158\">01 / LOAD</div>\n  <div class=\"loader-panel bg-[var(--magenta)]\" style=\"z-index: 10005;\" data-kid=\"159\">02 / READY</div>\n  <div class=\"loader-panel bg-[var(--cyan)]\" style=\"z-index: 10004;\" data-kid=\"160\">03 / SET</div>\n  <div class=\"loader-panel bg-[var(--yellow)]\" style=\"z-index: 10003;\" data-kid=\"161\">04 / GO</div>\n  <div class=\"loader-panel bg-black\" style=\"z-index: 10002;\" data-kid=\"162\">05 / EXPLODE</div>\n  <div class=\"loader-panel bg-[var(--magenta)]\" style=\"z-index: 10001;\" data-kid=\"163\">06 / ARYAN</div>\n</div>\n\n<nav class=\"fixed top-0 left-0 w-full z-50 p-8 flex justify-between items-center\" data-kid=\"1\">\n  <div class=\"pop-panel bg-[var(--yellow)] px-6 py-2 rotate-[-3deg]\" data-kid=\"2\">\n    <span class=\"font-header text-4xl tracking-tighter\" data-kid=\"3\">AB // POP_ART.V3</span>\n  </div>\n  <div class=\"flex gap-4\" data-kid=\"4\">\n    <a href=\"#work\" class=\"pop-panel bg-[var(--cyan)] px-4 py-2 font-bold uppercase text-sm hover:translate-y-[-4px]\" data-kid=\"5\">Work</a>\n    <a href=\"#journey\" class=\"pop-panel bg-[var(--magenta)] px-4 py-2 font-bold uppercase text-sm hover:translate-y-[-4px]\" data-kid=\"6\">Journey</a>\n    <a href=\"#contact\" class=\"pop-panel bg-black text-white px-6 py-2 font-bold uppercase text-sm hover:translate-y-[-4px]\" data-kid=\"7\">Talk</a>\n  </div>\n</nav>\n\n<main class=\"relative z-10\" data-kid=\"8\">\n  \n  <section class=\"min-h-screen relative flex items-center justify-center pt-20 px-12\" id=\"hero\" data-kid=\"9\">\n    <div class=\"halftone-bg\" data-kid=\"10\"></div>\n    \n    <div class=\"absolute top-1/4 left-10 rotate-[-15deg] z-0\" data-kid=\"11\">\n      <h1 class=\"big-header opacity-10 leading-none select-none\" data-kid=\"12\">DYNAMIC<br data-kid=\"13\">DYNAMIC</h1>\n    </div>\n\n    <div class=\"grid grid-cols-12 gap-8 w-full items-center relative z-10\" data-kid=\"14\">\n      <div class=\"col-span-8\" data-kid=\"15\">\n        <div class=\"pop-panel p-16 bg-white rotate-[-2deg]\" style=\"transform: translateZ(50px)\" data-kid=\"16\">\n          <div class=\"skew-tag mb-4\" data-kid=\"17\">STAY SATURATED</div>\n          <h1 class=\"big-header cmyk-text mb-4\" data-kid=\"18\">FRONTEND<br data-kid=\"19\"><span class=\"text-[var(--magenta)]\" data-kid=\"20\">EXPLOSION</span></h1>\n          <p class=\"text-3xl font-black uppercase leading-tight max-w-2xl\" data-kid=\"21\">\n            Building hyper-kinetic <span class=\"bg-[var(--cyan)] px-2\" data-kid=\"22\">interfaces</span> that break the grid. Indian-based developer with a 3D soul.\n          </p>\n          <div class=\"flex gap-8 mt-12\" data-kid=\"23\">\n            <button class=\"pop-panel bg-[var(--yellow)] px-12 py-6 font-header text-5xl hover:bg-black hover:text-white\" data-kid=\"24\">VIEW ARCHIVE</button>\n            <img src=\"https://cdn.jsdelivr.net/npm/openmoji-named-svgs@latest/color/collision.svg\" class=\"w-32 animate-bounce\" data-kid=\"25\">\n          </div>\n        </div>\n      </div>\n      \n      <div class=\"col-span-4 relative\" data-kid=\"26\">\n        <div class=\"pop-panel aspect-[3/4] rotate-[5deg] overflow-hidden\" style=\"transform: translateZ(150px)\" data-kid=\"27\">\n          <img src=\"https://images.unsplash.com/photo-1671519821564-ced7e41ee7ae?auto=format&w=800&q=80&fit=crop\" class=\"w-full h-full object-cover saturate-200 contrast-125\" alt=\"Hyper-Saturated 3D\" data-kid=\"28\">\n          <div class=\"absolute inset-0 border-[12px] border-black opacity-20 pointer-events-none\" data-kid=\"29\"></div>\n        </div>\n        <div class=\"absolute -bottom-10 -right-10 pop-panel bg-[var(--magenta)] p-6 rotate-[-10deg] z-20\" data-kid=\"30\">\n          <span class=\"font-header text-4xl text-white\" data-kid=\"31\">VOL. 3.0</span>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <div class=\"bg-black py-8 border-y-[8px] border-[var(--cyan)] overflow-hidden flex whitespace-nowrap rotate-[-2deg] relative z-20\" data-kid=\"32\">\n    <div class=\"flex animate-[marquee_20s_linear_infinite] gap-12 items-center\" data-kid=\"33\">\n      <span class=\"font-header text-8xl text-[var(--magenta)] tracking-tighter\" data-kid=\"34\">REACT_OVERDRIVE</span>\n      <i class=\"ti ti-bolt text-7xl text-[var(--yellow)]\" data-kid=\"35\"></i>\n      <span class=\"font-header text-8xl text-white tracking-tighter\" data-kid=\"36\">3D_SPATIAL_CRAFT</span>\n      <i class=\"ti ti-flame text-7xl text-[var(--cyan)]\" data-kid=\"37\"></i>\n      <span class=\"font-header text-8xl text-[var(--yellow)] tracking-tighter\" data-kid=\"38\">KINEMATIC_CRAYON</span>\n      <i class=\"ti ti-zap text-7xl text-[var(--magenta)]\" data-kid=\"39\"></i>\n    </div>\n  </div>\n\n  \n  <section class=\"py-40 px-12\" id=\"work\" data-kid=\"40\">\n    <div class=\"flex justify-between items-end mb-24\" data-kid=\"41\">\n      <h2 class=\"big-header cmyk-text leading-none\" data-kid=\"42\">SELECTED<br data-kid=\"43\">ARTIFACTS</h2>\n      <div class=\"pop-panel bg-[var(--magenta)] text-white p-6 rotate-[5deg]\" data-kid=\"44\">\n        <span class=\"font-header text-5xl\" data-kid=\"45\">[CHAPTER 02]</span>\n      </div>\n    </div>\n\n    <div class=\"diorama-stage pop-panel\" data-kid=\"46\">\n      <div class=\"halftone-bg opacity-20\" data-kid=\"47\"></div>\n      \n      <div class=\"relative w-full h-full flex items-center justify-center\" data-kid=\"48\">\n        \n        <div class=\"diorama-layer z-0 opacity-10 select-none scale-150\" data-depth=\"0.1\" data-kid=\"49\">\n          <h3 class=\"font-header text-[30vw] text-black\" data-kid=\"50\">POW!</h3>\n        </div>\n        \n        \n        <div class=\"diorama-layer z-10\" data-depth=\"0.5\" data-kid=\"51\">\n          <div class=\"pop-panel w-[700px] aspect-video overflow-hidden\" style=\"box-shadow: -20px 20px 0px var(--cyan), 20px -20px 0px var(--magenta);\" data-kid=\"52\">\n            <img src=\"https://images.pexels.com/photos/12024938/pexels-photo-12024938.jpeg?auto=compress&cs=tinysrgb&w=1200\" class=\"w-full h-full object-cover saturate-150\" alt=\"Project 1\" data-kid=\"53\">\n          </div>\n        </div>\n        \n        \n        <div class=\"diorama-layer z-20 translate-x-1/2 translate-y-1/3\" data-depth=\"1.5\" data-kid=\"54\">\n          <div class=\"pop-panel bg-[var(--yellow)] p-12 w-[400px]\" data-kid=\"55\">\n            <div class=\"skew-tag mb-4\" data-kid=\"56\">DEPLOYED // 2024</div>\n            <h4 class=\"font-header text-7xl mb-4 leading-none\" data-kid=\"57\">LINEA<br data-kid=\"58\">FLORA</h4>\n            <p class=\"font-black text-xl mb-8\" data-kid=\"59\">Digital garden rendered with extreme kinetic motion.</p>\n            <button class=\"w-full py-4 bg-black text-white font-header text-4xl hover:bg-[var(--magenta)] transition-colors\" data-kid=\"60\">OPEN_PANEL</button>\n          </div>\n        </div>\n\n        \n        <img src=\"https://cdn.jsdelivr.net/npm/openmoji-named-svgs@latest/color/bomb.svg\" class=\"diorama-layer z-30 w-40 -translate-x-[400px] -translate-y-40 rotate-[-15deg]\" data-depth=\"2\" data-kid=\"61\">\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-40 px-12 bg-black text-white relative overflow-hidden\" id=\"journey\" data-kid=\"62\">\n    <div class=\"halftone-bg opacity-30\" style=\"background-image: radial-gradient(var(--white) 2px, transparent 0);\" data-kid=\"63\"></div>\n    <h2 class=\"big-header mb-20 text-center\" data-kid=\"64\">THE <span class=\"text-[var(--cyan)]\" data-kid=\"65\">EVOLUTION</span></h2>\n\n    <div class=\"flex gap-0 h-[600px] perspective-[2000px] max-w-6xl mx-auto\" id=\"accordion\" data-kid=\"66\">\n      <div class=\"flex-1 pop-panel bg-[var(--cyan)] p-12 flex flex-col justify-between overflow-hidden cursor-pointer origin-left rotate-y-[25deg]\" data-kid=\"67\">\n        <div class=\"font-header text-9xl text-black/20\" data-kid=\"68\">01</div>\n        <div class=\"relative z-10\" data-kid=\"69\">\n          <h3 class=\"font-header text-7xl text-black\" data-kid=\"70\">THE_SEED</h3>\n          <p class=\"font-mono text-black font-bold\" data-kid=\"71\">Discovering the atomic logic of the web.</p>\n        </div>\n        <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/star-swirl.svg\" class=\"absolute -right-10 -bottom-10 w-64 opacity-10\" style=\"color: black;\" data-kid=\"72\">\n      </div>\n      <div class=\"flex-1 pop-panel bg-[var(--yellow)] p-12 flex flex-col justify-between overflow-hidden cursor-pointer translate-x-[-10px] z-10\" data-kid=\"73\">\n        <div class=\"font-header text-9xl text-black/20\" data-kid=\"74\">02</div>\n        <div class=\"relative z-10\" data-kid=\"75\">\n          <h3 class=\"font-header text-7xl text-black\" data-kid=\"76\">THE_ROOT</h3>\n          <p class=\"font-mono text-black font-bold\" data-kid=\"77\">Architecting complex React ecosystems.</p>\n        </div>\n      </div>\n      <div class=\"flex-1 pop-panel bg-[var(--magenta)] p-12 flex flex-col justify-between overflow-hidden cursor-pointer origin-right rotate-y-[-25deg] translate-x-[-20px]\" data-kid=\"78\">\n        <div class=\"font-header text-9xl text-black/20\" data-kid=\"79\">03</div>\n        <div class=\"relative z-10\" data-kid=\"80\">\n          <h3 class=\"font-header text-7xl text-black\" data-kid=\"81\">THE_BLOOM</h3>\n          <p class=\"font-mono text-black font-bold\" data-kid=\"82\">Mastering the spatial 3D frontier.</p>\n        </div>\n        <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/bright-explosion.svg\" class=\"absolute -right-10 top-0 w-64 opacity-10\" style=\"color: black;\" data-kid=\"83\">\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-40 px-12 bg-white\" id=\"skills\" data-kid=\"84\">\n    <div class=\"grid grid-cols-12 gap-12\" data-kid=\"85\">\n      <div class=\"col-span-4\" data-kid=\"86\">\n        <div class=\"pop-panel bg-black text-white p-12 rotate-[-5deg]\" data-kid=\"87\">\n          <h2 class=\"font-header text-8xl leading-none\" data-kid=\"88\">COMBAT<br data-kid=\"89\">STATS</h2>\n          <p class=\"font-mono text-sm mt-6 opacity-60\" data-kid=\"90\">// ARYAN_B_STATS.JSON</p>\n        </div>\n        <div class=\"mt-12 space-y-4\" data-kid=\"91\">\n          <div class=\"pop-panel bg-[var(--cyan)] p-4 flex justify-between items-center\" data-kid=\"92\">\n            <span class=\"font-bold\" data-kid=\"93\">OVERDRIVE_MODE</span>\n            <span class=\"bg-black text-white px-2 text-xs font-mono\" data-kid=\"94\">ACTIVE</span>\n          </div>\n          <div class=\"pop-panel bg-[var(--magenta)] p-4 flex justify-between items-center\" data-kid=\"95\">\n            <span class=\"font-bold\" data-kid=\"96\">CRAFT_LEVEL</span>\n            <span class=\"bg-black text-white px-2 text-xs font-mono\" data-kid=\"97\">MAX</span>\n          </div>\n        </div>\n      </div>\n      \n      <div class=\"col-span-8 grid grid-cols-2 gap-8\" data-kid=\"98\">\n        <div class=\"pop-panel p-10 bg-[var(--white)] group\" data-kid=\"99\">\n          <div class=\"absolute -top-6 -right-6 w-20 h-20 bg-[var(--yellow)] border-[4px] border-black flex items-center justify-center rotate-12 z-20\" data-kid=\"100\">\n            <i class=\"ti ti-flame text-4xl\" data-kid=\"101\"></i>\n          </div>\n          <h4 class=\"font-header text-6xl mb-8\" data-kid=\"102\">FRONTEND</h4>\n          <div class=\"w-full h-8 bg-black p-1 mb-4\" data-kid=\"103\">\n            <div class=\"h-full bg-[var(--cyan)] w-[99%]\" data-kid=\"104\"></div>\n          </div>\n          <div class=\"flex justify-between font-header text-3xl\" data-kid=\"105\">\n            <span data-kid=\"106\">REACT / TS / NEXT</span>\n            <span class=\"text-[var(--magenta)]\" data-kid=\"107\">99%</span>\n          </div>\n        </div>\n        \n        <div class=\"pop-panel p-10 bg-[var(--white)] group\" data-kid=\"108\">\n          <div class=\"absolute -top-6 -right-6 w-20 h-20 bg-[var(--cyan)] border-[4px] border-black flex items-center justify-center rotate-[-12deg] z-20\" data-kid=\"109\">\n            <i class=\"ti ti-vector-bezier text-4xl\" data-kid=\"110\"></i>\n          </div>\n          <h4 class=\"font-header text-6xl mb-8\" data-kid=\"111\">MOTION</h4>\n          <div class=\"w-full h-8 bg-black p-1 mb-4\" data-kid=\"112\">\n            <div class=\"h-full bg-[var(--magenta)] w-[95%]\" data-kid=\"113\"></div>\n          </div>\n          <div class=\"flex justify-between font-header text-3xl\" data-kid=\"114\">\n            <span data-kid=\"115\">GSAP / THREE.JS</span>\n            <span class=\"text-[var(--cyan)]\" data-kid=\"116\">95%</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"min-h-screen bg-[var(--yellow)] flex items-center justify-center px-12 relative overflow-hidden\" id=\"contact\" data-kid=\"117\">\n    <div class=\"halftone-bg opacity-20\" data-kid=\"118\"></div>\n    <div class=\"absolute inset-0 z-0 overflow-hidden\" data-kid=\"119\">\n      <h1 class=\"big-header opacity-5 leading-none rotate-[-15deg] scale-150\" data-kid=\"120\">MESSAGE_MESSAGE_MESSAGE</h1>\n    </div>\n\n    <div class=\"pop-panel bg-white p-20 w-full max-w-4xl rotateX(15deg) relative z-10\" style=\"box-shadow: 30px 30px 0px var(--black);\" id=\"contact-form\" data-kid=\"121\">\n      <div class=\"flex justify-between items-start mb-16\" data-kid=\"122\">\n        <div data-kid=\"123\">\n          <h2 class=\"font-header text-9xl leading-none\" data-kid=\"124\">LET'S<br data-kid=\"125\"><span class=\"text-[var(--magenta)]\" data-kid=\"126\">EXPLODE</span></h2>\n          <p class=\"font-black text-2xl uppercase mt-4\" data-kid=\"127\">Initializing transmission channel...</p>\n        </div>\n        <div class=\"pop-panel bg-[var(--cyan)] p-8 rotate-12\" data-kid=\"128\">\n           <i class=\"ti ti-mail-fast text-6xl\" data-kid=\"129\"></i>\n        </div>\n      </div>\n\n      <form class=\"grid grid-cols-2 gap-12\" data-kid=\"130\">\n        <div class=\"flex flex-col gap-4\" data-kid=\"131\">\n          <label class=\"pop-panel bg-black text-white px-4 py-1 self-start font-mono text-xs rotate-[-3deg]\" data-kid=\"132\">NAME_ID</label>\n          <input type=\"text\" placeholder=\"TYPE YOUR ALIAS\" class=\"border-b-[6px] border-black p-4 font-header text-5xl outline-none focus:bg-[var(--cyan)]/10\" data-kid=\"133\">\n        </div>\n        <div class=\"flex flex-col gap-4\" data-kid=\"134\">\n          <label class=\"pop-panel bg-black text-white px-4 py-1 self-start font-mono text-xs rotate-[3deg]\" data-kid=\"135\">EMAIL_ID</label>\n          <input type=\"email\" placeholder=\"TYPE YOUR FREQUENCY\" class=\"border-b-[6px] border-black p-4 font-header text-5xl outline-none focus:bg-[var(--magenta)]/10\" data-kid=\"136\">\n        </div>\n        <div class=\"col-span-2 flex flex-col gap-4\" data-kid=\"137\">\n          <label class=\"pop-panel bg-black text-white px-4 py-1 self-start font-mono text-xs rotate-[-1deg]\" data-kid=\"138\">INTEL_FIELD</label>\n          <textarea placeholder=\"WHAT'S THE MISSION?\" class=\"border-b-[6px] border-black p-4 font-header text-5xl outline-none h-40 focus:bg-[var(--yellow)]/20\" data-kid=\"139\"></textarea>\n        </div>\n        <button class=\"col-span-2 pop-panel bg-black text-white py-8 font-header text-6xl tracking-widest hover:bg-[var(--magenta)] hover:scale-[1.02]\" data-kid=\"140\">TRANSMIT // SEND</button>\n      </form>\n    </div>\n  </section>\n\n  \n  <footer class=\"py-24 bg-black text-white px-12 border-t-[12px] border-[var(--magenta)]\" data-kid=\"141\">\n    <div class=\"max-w-7xl mx-auto flex flex-col items-center gap-16\" data-kid=\"142\">\n      <div class=\"flex gap-12 font-header text-6xl\" data-kid=\"143\">\n        <a href=\"#\" class=\"hover:text-[var(--cyan)] transition-colors\" data-kid=\"144\">TWITTER</a>\n        <span class=\"text-[var(--yellow)]\" data-kid=\"145\">//</span>\n        <a href=\"#\" class=\"hover:text-[var(--magenta)] transition-colors\" data-kid=\"146\">GITHUB</a>\n        <span class=\"text-[var(--cyan)]\" data-kid=\"147\">//</span>\n        <a href=\"#\" class=\"hover:text-[var(--yellow)] transition-colors\" data-kid=\"148\">LINKEDIN</a>\n      </div>\n      \n      <div class=\"w-full h-1 bg-[var(--white)]/10\" data-kid=\"149\"></div>\n      \n      <div class=\"flex justify-between w-full font-mono text-[10px] tracking-[0.5em] uppercase opacity-40\" data-kid=\"150\">\n        <span data-kid=\"151\">© 2024 / HYPER_SATURATED_ARCHIVE</span>\n        <span data-kid=\"152\">BUILT WITH BRUTAL_CRAFT</span>\n        <span data-kid=\"153\">REBOOT_TO_TOP [^]</span>\n      </div>\n    </div>\n  </footer>\n</main>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"154\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"155\"></script>\n<script data-kid=\"156\">\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Flip-book Loader\n  const loaderTl = gsap.timeline();\n  loaderTl.to(\".loader-panel\", {\n    yPercent: -100,\n    stagger: 0.1,\n    duration: 0.5,\n    ease: \"expo.inOut\",\n    delay: 1\n  })\n  .to(\"#loader\", { display: \"none\" })\n  .from(\"#hero\", { scale: 0.8, rotateX: 20, opacity: 0, duration: 1.5, ease: \"power4.out\" }, \"-=0.2\");\n\n  // 3D Parallax Diorama\n  window.addEventListener('mousemove', (e) => {\n    const x = (window.innerWidth / 2 - e.pageX) / 40;\n    const y = (window.innerHeight / 2 - e.pageY) / 40;\n    \n    gsap.to('.diorama-layer', {\n      x: (i, target) => x * target.dataset.depth * 50,\n      y: (i, target) => y * target.dataset.depth * 50,\n      rotateY: x * 0.5,\n      rotateX: -y * 0.5,\n      duration: 0.8,\n      ease: \"power2.out\"\n    });\n    \n    gsap.to('#contact-form', {\n      rotateY: x * 0.2,\n      rotateX: 15 + (-y * 0.2),\n      duration: 0.8,\n      ease: \"power2.out\"\n    });\n  });\n\n  // Accordion Interaction\n  const folds = document.querySelectorAll('#accordion > div');\n  folds.forEach(fold => {\n    fold.addEventListener('mouseenter', () => {\n      gsap.to(folds, { flex: 0.5, duration: 0.6, ease: \"power4.out\" });\n      gsap.to(fold, { flex: 2, rotateY: 0, duration: 0.6, ease: \"power4.out\" });\n    });\n    fold.addEventListener('mouseleave', () => {\n      gsap.to(folds, { flex: 1, duration: 0.6, ease: \"power4.out\" });\n      gsap.to('.origin-left', { rotateY: 25, duration: 0.6 });\n      gsap.to('.origin-right', { rotateY: -25, duration: 0.6 });\n    });\n  });\n\n  // Scroll Animations\n  gsap.utils.toArray('.pop-panel').forEach(panel => {\n    gsap.from(panel, {\n      scrollTrigger: {\n        trigger: panel,\n        start: \"top 90%\",\n        toggleActions: \"play none none reverse\"\n      },\n      y: 50,\n      opacity: 0,\n      scale: 0.9,\n      duration: 0.8,\n      ease: \"back.out(1.7)\"\n    });\n  });\n\n</script>",
      "comments": [],
      "created": "2026-07-10T05:20:32.107760+00:00",
