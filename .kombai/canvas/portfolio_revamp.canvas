      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800;900&family=Work+Sans:wght@300;400;500;600&family=Space+Mono:wght@400;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n\n  :root {\n    --paper: #f4f0e8;\n    --ink: #000000;\n    --cobalt: #002387;\n    --vermillion: #e85d04;\n    --font-header: 'Big Shoulders Display', sans-serif;\n    --font-body: 'Work Sans', sans-serif;\n    --font-mono: 'Space Mono', monospace;\n    --border-thick: 4px solid var(--ink);\n    --shadow-pop: 10px 10px 0px var(--ink);\n  }\n\n  body {\n    background-color: var(--ink);\n    color: var(--ink);\n    font-family: var(--font-body);\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  /* Page Snapping spreads */\n  .section-spread {\n    position: sticky;\n    top: 0;\n    height: 100vh;\n    width: 100%;\n    background: var(--paper);\n    display: flex;\n    flex-direction: column;\n    overflow: hidden;\n    border-bottom: var(--border-thick);\n  }\n\n  .manga-panel {\n    border: var(--border-thick);\n    background: white;\n    position: relative;\n    box-shadow: var(--shadow-pop);\n  }\n\n  .big-header {\n    font-family: var(--font-header);\n    text-transform: uppercase;\n    line-height: 0.8;\n    letter-spacing: -0.03em;\n  }\n\n  .italic-black {\n    font-family: var(--font-header);\n    font-weight: 900;\n    font-style: italic;\n    text-transform: uppercase;\n  }\n\n  .halftone {\n    background-image: radial-gradient(var(--ink) 1px, transparent 0);\n    background-size: 6px 6px;\n    opacity: 0.05;\n  }\n\n  /* Loader Sequence */\n  #sequence-loader {\n    position: fixed;\n    inset: 0;\n    z-index: 9999;\n    background: var(--ink);\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    grid-template-rows: repeat(2, 1fr);\n    gap: 10px;\n    padding: 10px;\n  }\n  .loader-panel {\n    background: var(--paper);\n    border: 4px solid var(--ink);\n    display: grid;\n    place-items: center;\n    overflow: hidden;\n  }\n\n  .action-lines {\n    position: absolute;\n    inset: 0;\n    background-image: repeating-linear-gradient(45deg, transparent, transparent 10px, rgba(0,0,0,0.1) 10px, rgba(0,0,0,0.1) 11px);\n    opacity: 0;\n    pointer-events: none;\n    transition: opacity 0.3s ease;\n  }\n  .manga-panel:hover .action-lines {\n    opacity: 1;\n    animation: pulse-lines 0.2s infinite;\n  }\n  @keyframes pulse-lines {\n    0% { transform: scale(1); }\n    100% { transform: scale(1.02); }\n  }\n\n  /* Scroll Skew */\n  .kinetic-text { transition: transform 0.1s linear; }\n\n  .cobalt-flood { background-color: var(--cobalt); color: white; border-color: var(--ink); }\n  .vermillion-flood { background-color: var(--vermillion); color: white; border-color: var(--ink); }\n</style>\n\n\n<div id=\"sequence-loader\" data-kid=\"1\">\n  <div class=\"loader-panel\" data-kid=\"2\"><span class=\"italic-black text-6xl\" data-kid=\"3\">ACT 01</span></div>\n  <div class=\"loader-panel vermillion-flood\" data-kid=\"4\"><i class=\"ti ti-bolt text-8xl\" data-kid=\"5\"></i></div>\n  <div class=\"loader-panel cobalt-flood\" data-kid=\"6\"><span class=\"font-mono\" data-kid=\"7\">INITIALIZING...</span></div>\n  <div class=\"loader-panel\" data-kid=\"8\"><img src=\"https://cdn.jsdelivr.net/npm/openmoji-named-svgs@latest/color/fire.svg\" class=\"h-32\" data-kid=\"9\"></div>\n  <div class=\"loader-panel\" data-kid=\"10\"><span class=\"italic-black text-6xl\" data-kid=\"11\">OVERDRIVE</span></div>\n  <div class=\"loader-panel vermillion-flood\" data-kid=\"12\"><span class=\"italic-black text-4xl\" data-kid=\"13\">ARYAN BARBATE</span></div>\n</div>\n\n<div id=\"main-content\" style=\"opacity: 0;\" data-kid=\"14\">\n  \n  <nav class=\"fixed top-0 left-0 w-full z-50 flex justify-between items-center px-12 py-8 mix-blend-difference\" data-kid=\"15\">\n    <div class=\"manga-panel px-6 py-2 bg-white rotate-[-1deg] border-4\" data-kid=\"16\">\n      <span class=\"font-black text-2xl uppercase tracking-tighter italic\" data-kid=\"17\">ARYAN / KINETIC</span>\n    </div>\n    <div class=\"flex gap-12 font-mono text-xs uppercase text-white tracking-[0.3em]\" data-kid=\"18\">\n      <a href=\"#work\" class=\"hover:text-[var(--vermillion)] transition-colors underline underline-offset-8\" data-kid=\"19\">ARCHIVE</a>\n      <a href=\"#skills\" class=\"hover:text-[var(--vermillion)] transition-colors\" data-kid=\"20\">WEAPONS</a>\n      <a href=\"#contact\" class=\"hover:text-[var(--vermillion)] transition-colors\" data-kid=\"21\">LINK</a>\n    </div>\n  </nav>\n\n  \n  <section class=\"section-spread overflow-visible\" data-kid=\"22\">\n    <div class=\"absolute inset-0 halftone\" data-kid=\"23\"></div>\n    <div class=\"h-full flex items-center px-12 relative z-10\" data-kid=\"24\">\n      <div class=\"grid grid-cols-12 gap-12 w-full\" data-kid=\"25\">\n        <div class=\"col-span-8\" data-kid=\"26\">\n          <div class=\"manga-panel p-12 bg-white relative\" data-kid=\"27\">\n            <div class=\"action-lines\" data-kid=\"28\"></div>\n            <h1 class=\"big-header text-[14vw] kinetic-text\" data-kid=\"29\">\n              OVER<span class=\"text-[var(--vermillion)]\" data-kid=\"30\">DRIVE</span><br data-kid=\"31\">\n              <span class=\"text-[var(--cobalt)]\" data-kid=\"32\">CRAFT</span>\n            </h1>\n            <div class=\"flex gap-4 mt-8\" data-kid=\"33\">\n              <div class=\"px-4 py-1 bg-black text-white font-mono text-xs uppercase\" data-kid=\"34\">Frontend Architect</div>\n              <div class=\"px-4 py-1 border-2 border-black font-mono text-xs uppercase\" data-kid=\"35\">India Based</div>\n            </div>\n          </div>\n        </div>\n        <div class=\"col-span-4 self-end\" data-kid=\"36\">\n          <div class=\"manga-panel aspect-[3/4] overflow-hidden rotate-[4deg] relative group\" data-kid=\"37\">\n            <img src=\"https://images.unsplash.com/photo-1541715301255-12a4839b424a?auto=format&w=800&q=80&fit=crop\" class=\"w-full h-full object-cover grayscale contrast-200 brightness-75 transition-all group-hover:scale-110 group-hover:rotate-[-2deg]\" data-kid=\"38\">\n            <div class=\"absolute inset-0 bg-gradient-to-t from-[var(--cobalt)]/80 to-transparent\" data-kid=\"39\"></div>\n            <div class=\"absolute bottom-6 left-6 right-6\" data-kid=\"40\">\n              <span class=\"italic-black text-white text-5xl\" data-kid=\"41\">ARYAN.B</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <div class=\"relative z-30 bg-black py-6 border-y-8 border-[var(--vermillion)] overflow-hidden flex whitespace-nowrap\" data-kid=\"42\">\n    <div class=\"flex animate-[marquee_15s_linear_infinite] gap-16 items-center\" data-kid=\"43\">\n      <span class=\"italic-black text-6xl text-white\" data-kid=\"44\">SYSTEM ACTIVE</span>\n      <i class=\"ti ti-activity text-5xl text-[var(--vermillion)]\" data-kid=\"45\"></i>\n      <span class=\"italic-black text-6xl text-white\" data-kid=\"46\">PUSHING BOUNDARIES</span>\n      <i class=\"ti ti-bolt text-5xl text-[var(--cobalt)]\" data-kid=\"47\"></i>\n      <span class=\"italic-black text-6xl text-white\" data-kid=\"48\">HIGH VOLTAGE INTENTION</span>\n    </div>\n    <div class=\"flex animate-[marquee_15s_linear_infinite] gap-16 items-center ml-16\" data-kid=\"49\">\n      <span class=\"italic-black text-6xl text-white\" data-kid=\"50\">SYSTEM ACTIVE</span>\n      <i class=\"ti ti-activity text-5xl text-[var(--vermillion)]\" data-kid=\"51\"></i>\n      <span class=\"italic-black text-6xl text-white\" data-kid=\"52\">PUSHING BOUNDARIES</span>\n      <i class=\"ti ti-bolt text-5xl text-[var(--cobalt)]\" data-kid=\"53\"></i>\n      <span class=\"italic-black text-6xl text-white\" data-kid=\"54\">HIGH VOLTAGE INTENTION</span>\n    </div>\n  </div>\n\n  \n  <section id=\"work\" class=\"section-spread bg-black text-white\" data-kid=\"55\">\n    <div class=\"absolute inset-0 halftone opacity-20\" data-kid=\"56\"></div>\n    <div class=\"p-12 h-full flex flex-col justify-center\" data-kid=\"57\">\n      <div class=\"flex justify-between items-end mb-16 border-b-4 border-white pb-8\" data-kid=\"58\">\n        <h2 class=\"italic-black text-[12vw] text-[var(--cobalt)]\" data-kid=\"59\">SELECTED<br data-kid=\"60\"><span class=\"text-white\" data-kid=\"61\">PROJECTS</span></h2>\n        <div class=\"text-right font-mono text-xs opacity-50 uppercase tracking-widest mb-4\" data-kid=\"62\">\n          VOL. 01 / ARCHIVE<br data-kid=\"63\">\n          04 ENTRIES FOUND\n        </div>\n      </div>\n      \n      <div id=\"work-track\" class=\"flex gap-12 h-[50vh] overflow-visible\" data-kid=\"64\">\n        <div class=\"project-panel manga-panel flex-shrink-0 w-[450px] overflow-hidden group rotate-[-2deg]\" data-kid=\"65\">\n          <img src=\"https://images.unsplash.com/photo-1586204712758-6c50443844c2?auto=format&w=800&q=80&fit=crop\" class=\"w-full h-full object-cover grayscale contrast-125 group-hover:scale-105 group-hover:grayscale-0 transition-all duration-500\" data-kid=\"66\">\n          <div class=\"absolute inset-0 bg-black/40 p-8 flex flex-col justify-end\" data-kid=\"67\">\n            <span class=\"font-mono text-[var(--vermillion)] text-xs mb-2\" data-kid=\"68\">01. LINEA FLORA</span>\n            <h3 class=\"italic-black text-5xl\" data-kid=\"69\">CREATIVE BUILDER</h3>\n          </div>\n        </div>\n        <div class=\"project-panel manga-panel flex-shrink-0 w-[450px] overflow-hidden group rotate-[3deg] mt-12\" data-kid=\"70\">\n          <img src=\"https://images.unsplash.com/photo-1593349480374-01bb7d5782d5?auto=format&w=800&q=80&fit=crop\" class=\"w-full h-full object-cover grayscale contrast-125 group-hover:scale-105 group-hover:grayscale-0 transition-all duration-500\" data-kid=\"71\">\n          <div class=\"absolute inset-0 bg-black/40 p-8 flex flex-col justify-end\" data-kid=\"72\">\n            <span class=\"font-mono text-[var(--vermillion)] text-xs mb-2\" data-kid=\"73\">02. ANISCOPE</span>\n            <h3 class=\"italic-black text-5xl\" data-kid=\"74\">LIVE PRODUCT</h3>\n          </div>\n        </div>\n        <div class=\"project-panel manga-panel flex-shrink-0 w-[450px] overflow-hidden group rotate-[-1deg]\" data-kid=\"75\">\n          <img src=\"https://images.unsplash.com/photo-1584605518182-be59824e7d15?auto=format&w=800&q=80&fit=crop\" class=\"w-full h-full object-cover grayscale contrast-125 group-hover:scale-105 group-hover:grayscale-0 transition-all duration-500\" data-kid=\"76\">\n          <div class=\"absolute inset-0 bg-black/40 p-8 flex flex-col justify-end\" data-kid=\"77\">\n            <span class=\"font-mono text-[var(--vermillion)] text-xs mb-2\" data-kid=\"78\">03. GITHUB FINDER</span>\n            <h3 class=\"italic-black text-5xl\" data-kid=\"79\">DEVELOPER TOOL</h3>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"skills\" class=\"section-spread\" data-kid=\"80\">\n    <div class=\"grid grid-cols-12 h-full\" data-kid=\"81\">\n      <div class=\"col-span-7 p-12 flex flex-col justify-center gap-12\" data-kid=\"82\">\n        <div class=\"manga-panel p-8 bg-[var(--cobalt)] text-white rotate-[-2deg]\" data-kid=\"83\">\n          <h2 class=\"italic-black text-9xl\" data-kid=\"84\">POWER<br data-kid=\"85\">LEVELS</h2>\n        </div>\n        <div class=\"grid grid-cols-2 gap-8\" data-kid=\"86\">\n          <div class=\"manga-panel p-8 group\" data-kid=\"87\">\n            <div class=\"flex justify-between items-start mb-6\" data-kid=\"88\">\n              <h4 class=\"font-black text-4xl italic uppercase\" data-kid=\"89\">Frontend</h4>\n              <span class=\"italic-black text-4xl text-[var(--vermillion)]\" data-kid=\"90\">99%</span>\n            </div>\n            <div class=\"space-y-3 font-mono text-xs uppercase tracking-tighter\" data-kid=\"91\">\n              <div class=\"flex items-center gap-2\" data-kid=\"92\"><i class=\"ti ti-zap\" data-kid=\"93\"></i> React / Next.js</div>\n              <div class=\"flex items-center gap-2\" data-kid=\"94\"><i class=\"ti ti-zap\" data-kid=\"95\"></i> TypeScript</div>\n              <div class=\"flex items-center gap-2\" data-kid=\"96\"><i class=\"ti ti-zap\" data-kid=\"97\"></i> Tailwind CSS</div>\n            </div>\n          </div>\n          <div class=\"manga-panel p-8 group\" data-kid=\"98\">\n            <div class=\"flex justify-between items-start mb-6\" data-kid=\"99\">\n              <h4 class=\"font-black text-4xl italic uppercase\" data-kid=\"100\">Motion</h4>\n              <span class=\"italic-black text-4xl text-[var(--vermillion)]\" data-kid=\"101\">92%</span>\n            </div>\n            <div class=\"space-y-3 font-mono text-xs uppercase tracking-tighter\" data-kid=\"102\">\n              <div class=\"flex items-center gap-2\" data-kid=\"103\"><i class=\"ti ti-zap\" data-kid=\"104\"></i> GSAP / ScrollTrigger</div>\n              <div class=\"flex items-center gap-2\" data-kid=\"105\"><i class=\"ti ti-zap\" data-kid=\"106\"></i> Framer Motion</div>\n              <div class=\"flex items-center gap-2\" data-kid=\"107\"><i class=\"ti ti-zap\" data-kid=\"108\"></i> SVG Animation</div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div class=\"col-span-5 bg-black p-12 flex items-center\" data-kid=\"109\">\n        <div class=\"manga-panel w-full bg-[#121210] border-white p-0 overflow-hidden shadow-[15px_15px_0px_var(--cobalt)]\" data-kid=\"110\">\n          <div class=\"bg-[#1c1c1a] p-3 flex gap-2 border-b-4 border-white\" data-kid=\"111\">\n            <div class=\"w-3 h-3 rounded-full bg-[#ff5f56]\" data-kid=\"112\"></div>\n            <div class=\"w-3 h-3 rounded-full bg-[#ffbd2e]\" data-kid=\"113\"></div>\n            <div class=\"w-3 h-3 rounded-full bg-[#27c93f]\" data-kid=\"114\"></div>\n            <span class=\"ml-auto font-mono text-[10px] text-white/40 uppercase\" data-kid=\"115\">github_console.sh</span>\n          </div>\n          <div class=\"p-8 font-mono text-sm text-[var(--vermillion)] space-y-4 h-[50vh] overflow-y-auto\" data-kid=\"116\">\n            <div class=\"flex gap-2\" data-kid=\"117\"><span class=\"text-green-500\" data-kid=\"118\">➜</span> <span data-kid=\"119\">fetch --profile=aryan</span></div>\n            <div class=\"text-white/60\" data-kid=\"120\">[ OK ] Profile data retrieved.</div>\n            <div class=\"flex gap-2\" data-kid=\"121\"><span class=\"text-green-500\" data-kid=\"122\">➜</span> <span data-kid=\"123\">status --current</span></div>\n            <div class=\"text-white\" data-kid=\"124\">STATUS: <span class=\"animate-pulse\" data-kid=\"125\">BUILDING_NEXT_GEN</span></div>\n            <div class=\"text-white/40 pt-8\" data-kid=\"126\">> Analyzing commit history...</div>\n            <div class=\"grid grid-cols-5 gap-1 pt-4\" data-kid=\"127\">\n              <div class=\"aspect-square bg-green-900 border border-black\" data-kid=\"128\"></div>\n              <div class=\"aspect-square bg-green-500 border border-black\" data-kid=\"129\"></div>\n              <div class=\"aspect-square bg-green-700 border border-black\" data-kid=\"130\"></div>\n              <div class=\"aspect-square bg-green-400 border border-black\" data-kid=\"131\"></div>\n              <div class=\"aspect-square bg-green-600 border border-black\" data-kid=\"132\"></div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"journey\" class=\"section-spread bg-[var(--vermillion)] text-white border-white\" data-kid=\"133\">\n    <div class=\"grid grid-cols-12 h-full\" data-kid=\"134\">\n      <div class=\"col-span-4 p-12 flex flex-col justify-between\" data-kid=\"135\">\n        <h2 class=\"italic-black text-9xl leading-none text-black\" data-kid=\"136\">THE<br data-kid=\"137\">JOURNEY</h2>\n        <div class=\"manga-panel p-8 bg-white text-black rotate-3\" data-kid=\"138\">\n          <img src=\"https://i.pravatar.cc/100?u=aryan\" class=\"w-16 h-16 rounded-full border-4 border-black mb-4\" data-kid=\"139\">\n          <h4 class=\"font-black text-2xl uppercase\" data-kid=\"140\">Aryan Barbate</h4>\n          <p class=\"font-mono text-xs opacity-60\" data-kid=\"141\">Architecting interfaces since 2021.</p>\n        </div>\n      </div>\n      <div class=\"col-span-8 p-12 overflow-y-auto space-y-8\" data-kid=\"142\">\n        <div class=\"manga-panel p-10 bg-white text-black\" data-kid=\"143\">\n          <div class=\"flex gap-6 items-center mb-4\" data-kid=\"144\">\n            <span class=\"italic-black text-6xl text-[var(--cobalt)]\" data-kid=\"145\">01</span>\n            <h3 class=\"font-black text-4xl uppercase\" data-kid=\"146\">Seed Phase</h3>\n          </div>\n          <p class=\"text-xl font-medium\" data-kid=\"147\">Initial contact with the machine. HTML turned into structure, CSS turned into style.</p>\n        </div>\n        <div class=\"manga-panel p-10 bg-white text-black translate-x-12\" data-kid=\"148\">\n          <div class=\"flex gap-6 items-center mb-4\" data-kid=\"149\">\n            <span class=\"italic-black text-6xl text-[var(--vermillion)]\" data-kid=\"150\">02</span>\n            <h3 class=\"font-black text-4xl uppercase\" data-kid=\"151\">Logic Root</h3>\n          </div>\n          <p class=\"text-xl font-medium\" data-kid=\"152\">The shift from styling to thinking in logic. JavaScript brought the interfaces to life.</p>\n        </div>\n        <div class=\"manga-panel p-10 bg-white text-black translate-x-24\" data-kid=\"153\">\n          <div class=\"flex gap-6 items-center mb-4\" data-kid=\"154\">\n            <span class=\"italic-black text-6xl text-[var(--cobalt)]\" data-kid=\"155\">03</span>\n            <h3 class=\"font-black text-4xl uppercase\" data-kid=\"156\">System Sprout</h3>\n          </div>\n          <p class=\"text-xl font-medium\" data-kid=\"157\">React changed everything. Component-driven architecture became the standard.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer id=\"contact\" class=\"bg-black py-32 px-12 text-white relative\" data-kid=\"158\">\n    <div class=\"max-w-7xl mx-auto grid grid-cols-2 gap-24 items-start\" data-kid=\"159\">\n      <div data-kid=\"160\">\n        <h2 class=\"italic-black text-[12vw] leading-none mb-12\" data-kid=\"161\">LET'S<br data-kid=\"162\"><span class=\"text-[var(--vermillion)]\" data-kid=\"163\">TALK</span></h2>\n        <div class=\"flex flex-col gap-6\" data-kid=\"164\">\n          <a href=\"#\" class=\"manga-panel p-8 bg-white text-black block hover:bg-[var(--cobalt)] hover:text-white transition-all group\" data-kid=\"165\">\n            <span class=\"font-mono text-xs uppercase opacity-40 group-hover:opacity-100 mb-2 block\" data-kid=\"166\">Transmission_Channel</span>\n            <span class=\"italic-black text-5xl\" data-kid=\"167\">HELLO@BARBATE.XYZ</span>\n          </a>\n          <a href=\"#\" class=\"manga-panel p-8 bg-white text-black block hover:bg-[var(--vermillion)] hover:text-white transition-all group\" data-kid=\"168\">\n            <span class=\"font-mono text-xs uppercase opacity-40 group-hover:opacity-100 mb-2 block\" data-kid=\"169\">Social_Pulse</span>\n            <span class=\"italic-black text-5xl\" data-kid=\"170\">TWITTER.COM/ARYAN</span>\n          </a>\n        </div>\n      </div>\n      \n      <div class=\"manga-panel p-12 bg-[#121210] border-white\" data-kid=\"171\">\n        <h4 class=\"italic-black text-4xl mb-8\" data-kid=\"172\">Journal Entry</h4>\n        <div class=\"space-y-6\" data-kid=\"173\">\n          <div class=\"border-b-2 border-white/20 pb-4 group cursor-pointer hover:border-[var(--vermillion)]\" data-kid=\"174\">\n            <div class=\"flex justify-between items-center mb-1\" data-kid=\"175\">\n              <span class=\"font-black uppercase text-xl group-hover:text-[var(--vermillion)] transition-colors\" data-kid=\"176\">The Editorial Soul of Web</span>\n              <span class=\"font-mono text-[10px] opacity-40\" data-kid=\"177\">JUNE 2024</span>\n            </div>\n            <p class=\"text-sm text-white/60\" data-kid=\"178\">Exploring the intersection of print design and modern frontend.</p>\n          </div>\n          <div class=\"border-b-2 border-white/20 pb-4 group cursor-pointer hover:border-[var(--vermillion)]\" data-kid=\"179\">\n            <div class=\"flex justify-between items-center mb-1\" data-kid=\"180\">\n              <span class=\"font-black uppercase text-xl group-hover:text-[var(--vermillion)] transition-colors\" data-kid=\"181\">Micro-animations for High Impact</span>\n              <span class=\"font-mono text-[10px] opacity-40\" data-kid=\"182\">MAY 2024</span>\n            </div>\n            <p class=\"text-sm text-white/60\" data-kid=\"183\">How tiny movements create premium experiences.</p>\n          </div>\n        </div>\n        \n        <div class=\"mt-20 flex justify-between items-end\" data-kid=\"184\">\n          <div class=\"bg-[var(--vermillion)] p-4 rotate-[-4deg]\" data-kid=\"185\">\n            <span class=\"italic-black text-3xl text-black\" data-kid=\"186\">AB/2024</span>\n          </div>\n          <div class=\"font-mono text-[10px] uppercase opacity-40 tracking-widest text-right\" data-kid=\"187\">\n            BUILT WITH SPEED_AND_INTENTION<br data-kid=\"188\">\n            COPYRIGHT © ALL RIGHTS RESERVED\n          </div>\n        </div>\n      </div>\n    </div>\n  </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"189\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"190\"></script>\n<script data-kid=\"191\">\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Opening Sequence Animation\n  window.addEventListener('load', () => {\n    const tl = gsap.timeline();\n    \n    tl.to('.loader-panel', {\n      scale: 0,\n      opacity: 0,\n      stagger: {\n        amount: 1,\n        grid: [2,3],\n        from: \"center\"\n      },\n      duration: 0.8,\n      ease: \"power4.inOut\"\n    });\n    \n    tl.to('#sequence-loader', {\n      opacity: 0,\n      pointerEvents: 'none',\n      duration: 0.4\n    });\n    \n    tl.to('#main-content', {\n      opacity: 1,\n      duration: 1\n    }, \"-=0.2\");\n  });\n\n  // Kinetic Text Skew based on scroll velocity\n  let proxy = { skew: 0 },\n      skewSetter = gsap.quickSetter(\".kinetic-text\", \"skewY\", \"deg\"),\n      clamp = gsap.utils.clamp(-20, 20);\n\n  ScrollTrigger.create({\n    onUpdate: (self) => {\n      let skew = clamp(self.getVelocity() / -300);\n      if (Math.abs(skew) > Math.abs(proxy.skew)) {\n        proxy.skew = skew;\n        gsap.to(proxy, {\n          skew: 0, \n          duration: 0.8, \n          ease: \"power3\", \n          overwrite: true, \n          onUpdate: () => skewSetter(proxy.skew)\n        });\n      }\n    }\n  });\n\n  // Smooth snapping for sections (Page-turn effect)\n  gsap.utils.toArray('.section-spread').forEach((section, i) => {\n    ScrollTrigger.create({\n      trigger: section,\n      start: \"top top\",\n      pin: true,\n      pinSpacing: false,\n      snap: 1\n    });\n  });\n\n  // Project Horizontal Scroll Sync\n  gsap.to(\"#work-track\", {\n    x: \"-100%\",\n    ease: \"none\",\n    scrollTrigger: {\n      trigger: \"#work\",\n      start: \"top top\",\n      end: \"+=1000\",\n      scrub: 1,\n      pin: true\n    }\n  });\n\n  // Action lines hover logic already in CSS, but GSAP can spice up entries\n  gsap.from('.manga-panel', {\n    scrollTrigger: {\n      trigger: '.manga-panel',\n      start: \"top 90%\"\n    },\n    y: 50,\n    opacity: 0,\n    rotate: -5,\n    stagger: 0.1,\n    duration: 1,\n    ease: \"back.out(1.7)\"\n  });\n</script>",
      "comments": [],
      "created": "2026-07-10T05:05:14.337877+00:00",
      "modified": "2026-07-10T05:05:54.675946+00:00",
