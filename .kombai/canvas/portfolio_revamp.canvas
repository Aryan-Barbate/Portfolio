      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@100..900&family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&family=Work+Sans:wght@100..900&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --paper: #f4f0e8;\n    --ink: #000000;\n    --accent-blue: #0047ff;\n    --accent-red: #ff3c00;\n    --halftone: rgba(0, 0, 0, 0.05);\n    --border-thick: 4px;\n    --font-display: 'Big Shoulders Display', sans-serif;\n    --font-body: 'Work Sans', sans-serif;\n    --font-mono: 'Space Mono', monospace;\n  }\n\n  body {\n    background-color: var(--paper);\n    color: var(--ink);\n    font-family: var(--font-body);\n    margin: 0;\n    padding: 0;\n  }\n\n  .manga-grid {\n    display: grid;\n    grid-template-columns: repeat(12, 1fr);\n    border: var(--border-thick) solid var(--ink);\n  }\n\n  .panel-border {\n    border: var(--border-thick) solid var(--ink);\n  }\n\n  .breakout-text {\n    font-family: var(--font-display);\n    font-weight: 900;\n    text-transform: uppercase;\n    line-height: 0.8;\n    letter-spacing: -0.05em;\n  }\n\n  .sticker-blue {\n    background: var(--accent-blue);\n    color: white;\n    padding: 2px 8px;\n    font-family: var(--font-mono);\n    font-weight: 700;\n    font-size: 0.75rem;\n    text-transform: uppercase;\n    display: inline-block;\n    transform: rotate(-2deg);\n  }\n\n  .sticker-red {\n    background: var(--accent-red);\n    color: white;\n    padding: 2px 8px;\n    font-family: var(--font-mono);\n    font-weight: 700;\n    font-size: 0.75rem;\n    text-transform: uppercase;\n    display: inline-block;\n    transform: rotate(1deg);\n  }\n\n  /* Custom Screentone effect */\n  .screentone {\n    background-image: radial-gradient(var(--ink) 1px, transparent 0);\n    background-size: 4px 4px;\n    opacity: 0.1;\n  }\n\n  /* Horizontal Filmstrip */\n  .filmstrip-container {\n    display: flex;\n    overflow-x: auto;\n    gap: 0;\n    scrollbar-width: none;\n    -ms-overflow-style: none;\n  }\n  .filmstrip-container::-webkit-scrollbar { display: none; }\n\n  .project-panel {\n    flex: 0 0 500px;\n    height: 600px;\n    border-right: var(--border-thick) solid var(--ink);\n    position: relative;\n    overflow: hidden;\n    transition: flex 0.5s cubic-bezier(0.16, 1, 0.3, 1);\n  }\n  \n  .project-panel:hover {\n    flex: 0 0 700px;\n  }\n\n  .project-title {\n    position: absolute;\n    bottom: 40px;\n    left: 20px;\n    z-index: 10;\n    mix-blend-mode: difference;\n    color: white;\n  }\n</style>\n\n<div class=\"relative min-h-screen\" data-kid=\"1\">\n  \n  <nav class=\"fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-8 py-4 bg-[var(--paper)] border-b-[var(--border-thick)] border-[var(--ink)]\" data-kid=\"2\">\n    <div class=\"flex items-center gap-4\" data-kid=\"3\">\n      <div class=\"w-10 h-10 bg-[var(--ink)] text-[var(--paper)] flex items-center justify-center font-black text-xl\" data-kid=\"4\">AB</div>\n      <div class=\"sticker-blue\" data-kid=\"5\">VOL. 2024</div>\n    </div>\n    <div class=\"hidden md:flex gap-8 font-mono font-bold text-xs uppercase tracking-widest\" data-kid=\"6\">\n      <a href=\"#work\" class=\"hover:text-[var(--accent-blue)]\" data-kid=\"7\">/ WORK</a>\n      <a href=\"#journey\" class=\"hover:text-[var(--accent-blue)]\" data-kid=\"8\">/ STORY</a>\n      <a href=\"#skills\" class=\"hover:text-[var(--accent-blue)]\" data-kid=\"9\">/ TECH</a>\n      <a href=\"#writing\" class=\"hover:text-[var(--accent-blue)]\" data-kid=\"10\">/ LOG</a>\n    </div>\n    <button class=\"bg-[var(--accent-red)] text-white px-6 py-2 font-mono font-black text-sm border-[var(--border-thick)] border-[var(--ink)] shadow-[4px_4px_0_var(--ink)] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-none transition-all\" data-kid=\"11\">\n      HIRE ME\n    </button>\n  </nav>\n\n  \n  <header class=\"pt-24 px-8 pb-16\" data-kid=\"12\">\n    <div class=\"grid grid-cols-12 border-[var(--border-thick)] border-[var(--ink)]\" data-kid=\"13\">\n      \n      <div class=\"col-span-12 lg:col-span-4 border-b-[var(--border-thick)] lg:border-b-0 lg:border-r-[var(--border-thick)] border-[var(--ink)] p-8 relative overflow-hidden\" data-kid=\"14\">\n        <div class=\"screentone absolute inset-0\" data-kid=\"15\"></div>\n        <div class=\"relative z-10\" data-kid=\"16\">\n          <p class=\"font-mono text-xs mb-8 tracking-widest opacity-60\" data-kid=\"17\">// INITIALIZING PROTOCOL</p>\n          <h2 class=\"breakout-text text-8xl leading-none mb-12\" data-kid=\"18\">ARYAN<br data-kid=\"19\">BARBATE</h2>\n          <p class=\"text-lg leading-tight font-medium max-w-xs\" data-kid=\"20\">\n            A architectural-minded frontend engineer building highly rhythmic digital experiences.\n          </p>\n        </div>\n      </div>\n\n      \n      <div class=\"col-span-12 lg:col-span-4 border-b-[var(--border-thick)] lg:border-b-0 lg:border-r-[var(--border-thick)] border-[var(--ink)] relative h-[500px] lg:h-auto\" data-kid=\"21\">\n        <img src=\"https://images.unsplash.com/photo-1677849242177-2a86834456f0?auto=format&w=800&q=80&fit=crop\" alt=\"Screentone Eye\" class=\"w-full h-full object-cover grayscale contrast-150\" decoding=\"async\" loading=\"lazy\" data-kid=\"22\">\n        <div class=\"absolute inset-0 bg-[var(--accent-blue)] mix-blend-multiply opacity-40\" data-kid=\"23\"></div>\n        <div class=\"absolute top-4 right-4 sticker-red\" data-kid=\"24\">LIVE PROXY</div>\n      </div>\n\n      \n      <div class=\"col-span-12 lg:col-span-4 p-8 flex flex-col justify-between relative\" data-kid=\"25\">\n        <div class=\"relative\" data-kid=\"26\">\n          <h1 class=\"breakout-text text-[15rem] leading-[0.7] absolute -left-20 top-12 mix-blend-difference text-white pointer-events-none z-20\" data-kid=\"27\">FRONT</h1>\n          <h1 class=\"breakout-text text-[15rem] leading-[0.7] absolute -left-20 top-[15rem] mix-blend-difference text-white pointer-events-none z-20\" data-kid=\"28\">END</h1>\n        </div>\n        <div class=\"mt-auto pt-48 relative z-10\" data-kid=\"29\">\n          <div class=\"flex gap-4 mb-4\" data-kid=\"30\">\n            <span class=\"w-12 h-1 bg-[var(--ink)]\" data-kid=\"31\"></span>\n            <span class=\"font-mono text-xs uppercase tracking-tighter\" data-kid=\"32\">Based in India // Remote World</span>\n          </div>\n          <p class=\"font-mono text-sm opacity-60\" data-kid=\"33\">\n            [SYS_LOG]: High-craft interfaces, polished interactions, and creative experiments.\n          </p>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  \n  <div class=\"bg-[var(--ink)] text-[var(--paper)] py-4 border-y-[var(--border-thick)] border-[var(--ink)] overflow-hidden whitespace-nowrap\" data-kid=\"34\">\n    <div class=\"flex animate-[marquee_20s_linear_infinite] gap-12 text-4xl font-black uppercase font-[var(--font-display)]\" data-kid=\"35\">\n      <span data-kid=\"36\">REACT • TYPESCRIPT • FRAMER MOTION • TAILWIND • NEXT.JS • GSAP • WEBGL • CREATIVE CODING • INTERFACE ARCHITECT • </span>\n      <span data-kid=\"37\">REACT • TYPESCRIPT • FRAMER MOTION • TAILWIND • NEXT.JS • GSAP • WEBGL • CREATIVE CODING • INTERFACE ARCHITECT • </span>\n    </div>\n  </div>\n\n  \n  <section id=\"work\" class=\"py-24\" data-kid=\"38\">\n    <div class=\"px-8 mb-12 flex items-baseline justify-between\" data-kid=\"39\">\n      <h3 class=\"breakout-text text-8xl\" data-kid=\"40\">FEATURED_PANELS</h3>\n      <div class=\"font-mono text-sm sticker-blue\" data-kid=\"41\">SCROLL HORIZONTAL ➔</div>\n    </div>\n    \n    <div class=\"filmstrip-container border-y-[var(--border-thick)] border-[var(--ink)]\" data-kid=\"42\">\n      \n      <div class=\"project-panel group\" data-kid=\"43\">\n        <img src=\"https://images.unsplash.com/photo-1601654152371-0ceae53a92c7?auto=format&w=800&q=80&fit=crop\" class=\"w-full h-full object-cover grayscale brightness-50 group-hover:grayscale-0 group-hover:brightness-100 transition-all duration-700\" alt=\"Urban Project\" decoding=\"async\" loading=\"lazy\" data-kid=\"44\">\n        <div class=\"absolute inset-0 bg-[var(--ink)] opacity-40 group-hover:opacity-20 transition-opacity\" data-kid=\"45\"></div>\n        <div class=\"project-title\" data-kid=\"46\">\n          <p class=\"font-mono text-xs mb-2 text-[var(--accent-red)]\" data-kid=\"47\">01 / CREATIVE BUILDER</p>\n          <h4 class=\"text-6xl font-black font-[var(--font-display)] leading-none\" data-kid=\"48\">LINEA FLORA</h4>\n        </div>\n        <div class=\"absolute top-8 right-8 w-16 h-16 bg-[var(--paper)] border-[var(--border-thick)] border-[var(--ink)] flex items-center justify-center transform rotate-12 group-hover:rotate-0 transition-transform\" data-kid=\"49\">\n          <i class=\"ti ti-arrow-up-right text-3xl\" data-kid=\"50\"></i>\n        </div>\n      </div>\n\n      \n      <div class=\"project-panel group\" data-kid=\"51\">\n        <img src=\"https://images.unsplash.com/photo-1589803196988-17b417281773?auto=format&w=800&q=80&fit=crop\" class=\"w-full h-full object-cover grayscale brightness-50 group-hover:grayscale-0 group-hover:brightness-100 transition-all duration-700\" alt=\"AniScope\" decoding=\"async\" loading=\"lazy\" data-kid=\"52\">\n        <div class=\"absolute inset-0 bg-[var(--ink)] opacity-40 group-hover:opacity-20 transition-opacity\" data-kid=\"53\"></div>\n        <div class=\"project-title\" data-kid=\"54\">\n          <p class=\"font-mono text-xs mb-2 text-[var(--accent-blue)]\" data-kid=\"55\">02 / LIVE PRODUCT</p>\n          <h4 class=\"text-6xl font-black font-[var(--font-display)] leading-none\" data-kid=\"56\">ANISCOPE</h4>\n        </div>\n      </div>\n\n      \n      <div class=\"project-panel group\" data-kid=\"57\">\n        <img src=\"https://images.unsplash.com/photo-1429292394373-ddbcc6bb7468?auto=format&w=800&q=80&fit=crop\" class=\"w-full h-full object-cover grayscale brightness-50 group-hover:grayscale-0 group-hover:brightness-100 transition-all duration-700\" alt=\"Finder\" decoding=\"async\" loading=\"lazy\" data-kid=\"58\">\n        <div class=\"absolute inset-0 bg-[var(--ink)] opacity-40 group-hover:opacity-20 transition-opacity\" data-kid=\"59\"></div>\n        <div class=\"project-title\" data-kid=\"60\">\n          <p class=\"font-mono text-xs mb-2 text-[var(--accent-red)]\" data-kid=\"61\">03 / DEVELOPER TOOL</p>\n          <h4 class=\"text-6xl font-black font-[var(--font-display)] leading-none\" data-kid=\"62\">GITHUB FINDER</h4>\n        </div>\n      </div>\n\n      \n      <div class=\"project-panel group\" data-kid=\"63\">\n        <div class=\"w-full h-full bg-[var(--accent-blue)] screentone flex items-center justify-center p-12\" data-kid=\"64\">\n          <h4 class=\"text-8xl text-white font-black font-[var(--font-display)] text-center leading-[0.8]\" data-kid=\"65\">MORE<br data-kid=\"66\">COMING<br data-kid=\"67\">SOON</h4>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"grid grid-cols-12 border-t-[var(--border-thick)] border-[var(--ink)]\" data-kid=\"68\">\n    \n    <div id=\"skills\" class=\"col-span-12 lg:col-span-7 p-8 border-b-[var(--border-thick)] lg:border-b-0 lg:border-r-[var(--border-thick)] border-[var(--ink)] bg-[var(--paper)]\" data-kid=\"69\">\n      <div class=\"flex items-center gap-4 mb-12\" data-kid=\"70\">\n        <div class=\"w-12 h-12 bg-[var(--accent-blue)] border-[var(--border-thick)] border-[var(--ink)] text-white flex items-center justify-center font-black text-2xl\" data-kid=\"71\">?</div>\n        <h3 class=\"breakout-text text-6xl\" data-kid=\"72\">CAPABILITIES</h3>\n      </div>\n      \n      <div class=\"grid grid-cols-1 md:grid-cols-2 gap-8\" data-kid=\"73\">\n        <div class=\"panel-border p-6 shadow-[8px_8px_0_var(--ink)] hover:shadow-none hover:translate-x-[4px] hover:translate-y-[4px] transition-all bg-white relative\" data-kid=\"74\">\n          <div class=\"sticker-red absolute -top-4 -left-2\" data-kid=\"75\">CORE</div>\n          <h5 class=\"font-black text-xl mb-4 font-mono\" data-kid=\"76\">LANGUAGES</h5>\n          <ul class=\"space-y-2 font-mono text-sm uppercase font-bold\" data-kid=\"77\">\n            <li data-kid=\"78\"><i class=\"ti ti-bolt text-[var(--accent-blue)] mr-2\" data-kid=\"79\"></i>JAVASCRIPT (ES6+)</li>\n            <li data-kid=\"80\"><i class=\"ti ti-bolt text-[var(--accent-blue)] mr-2\" data-kid=\"81\"></i>TYPESCRIPT</li>\n            <li data-kid=\"82\"><i class=\"ti ti-bolt text-[var(--accent-blue)] mr-2\" data-kid=\"83\"></i>HTML5 / CSS3</li>\n            <li data-kid=\"84\"><i class=\"ti ti-bolt text-[var(--accent-blue)] mr-2\" data-kid=\"85\"></i>SQL</li>\n          </ul>\n        </div>\n\n        <div class=\"panel-border p-6 shadow-[8px_8px_0_var(--ink)] hover:shadow-none hover:translate-x-[4px] hover:translate-y-[4px] transition-all bg-white relative\" data-kid=\"86\">\n          <div class=\"sticker-blue absolute -top-4 -left-2\" data-kid=\"87\">FRAMEWORKS</div>\n          <h5 class=\"font-black text-xl mb-4 font-mono\" data-kid=\"88\">UI_SYSTEMS</h5>\n          <ul class=\"space-y-2 font-mono text-sm uppercase font-bold\" data-kid=\"89\">\n            <li data-kid=\"90\"><i class=\"ti ti-bolt text-[var(--accent-red)] mr-2\" data-kid=\"91\"></i>REACT / NEXT.JS</li>\n            <li data-kid=\"92\"><i class=\"ti ti-bolt text-[var(--accent-red)] mr-2\" data-kid=\"93\"></i>TAILWIND CSS</li>\n            <li data-kid=\"94\"><i class=\"ti ti-bolt text-[var(--accent-red)] mr-2\" data-kid=\"95\"></i>FRAMER MOTION</li>\n            <li data-kid=\"96\"><i class=\"ti ti-bolt text-[var(--accent-red)] mr-2\" data-kid=\"97\"></i>GSAP</li>\n          </ul>\n        </div>\n      </div>\n    </div>\n\n    \n    <div id=\"about\" class=\"col-span-12 lg:col-span-5 p-8 bg-[var(--paper)]\" data-kid=\"98\">\n       <div class=\"flex items-center gap-4 mb-8\" data-kid=\"99\">\n        <h3 class=\"breakout-text text-6xl\" data-kid=\"100\">THE_FILE</h3>\n      </div>\n      <div class=\"panel-border p-0 overflow-hidden mb-8\" data-kid=\"101\">\n        <div class=\"bg-[var(--ink)] p-2 flex justify-between items-center\" data-kid=\"102\">\n          <div class=\"flex gap-2\" data-kid=\"103\">\n            <span class=\"w-3 h-3 rounded-full bg-[var(--accent-red)] border border-black\" data-kid=\"104\"></span>\n            <span class=\"w-3 h-3 rounded-full bg-yellow-400 border border-black\" data-kid=\"105\"></span>\n            <span class=\"w-3 h-3 rounded-full bg-green-500 border border-black\" data-kid=\"106\"></span>\n          </div>\n          <span class=\"text-[var(--paper)] font-mono text-[10px]\" data-kid=\"107\">BIO.EXE</span>\n        </div>\n        <div class=\"p-6 font-mono text-sm leading-relaxed\" data-kid=\"108\">\n          I build interfaces with intention — live API tools, creative experiments, and polished front-end craft. Small in quantity, <span class=\"bg-[var(--ink)] text-[var(--paper)] px-1\" data-kid=\"109\">high in craft.</span>\n          <br data-kid=\"110\"><br data-kid=\"111\">\n          I believe the web should be as tactile as a printed page. My approach is architectural: strong foundations, rhythmic spacing, and expressive details.\n        </div>\n      </div>\n      <div class=\"flex gap-4\" data-kid=\"112\">\n        <div class=\"flex-1 panel-border p-4 text-center\" data-kid=\"113\">\n          <p class=\"text-3xl font-black font-[var(--font-display)]\" data-kid=\"114\">4+</p>\n          <p class=\"text-[10px] font-mono uppercase opacity-60\" data-kid=\"115\">PROJ_COUNT</p>\n        </div>\n        <div class=\"flex-1 panel-border p-4 text-center bg-[var(--accent-blue)] text-white\" data-kid=\"116\">\n          <p class=\"text-3xl font-black font-[var(--font-display)]\" data-kid=\"117\">3.2k</p>\n          <p class=\"text-[10px] font-mono uppercase opacity-90\" data-kid=\"118\">COMMITS</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"writing\" class=\"py-24 px-8 border-t-[var(--border-thick)] border-[var(--ink)]\" data-kid=\"119\">\n    <div class=\"mb-16\" data-kid=\"120\">\n      <h3 class=\"breakout-text text-8xl\" data-kid=\"121\">ANTHOLOGY_LOG</h3>\n      <p class=\"font-mono text-xs tracking-widest opacity-60 uppercase mt-4\" data-kid=\"122\">Selected thoughts and technical documentation</p>\n    </div>\n\n    <div class=\"space-y-0\" data-kid=\"123\">\n      \n      <div class=\"group py-12 border-b-[var(--border-thick)] border-dotted border-[var(--ink)] flex flex-col md:flex-row gap-8 items-start md:items-center relative\" data-kid=\"124\">\n        <div class=\"w-20 h-20 bg-[var(--ink)] text-[var(--paper)] rounded-full flex items-center justify-center font-black text-3xl shrink-0 group-hover:bg-[var(--accent-red)] transition-colors\" data-kid=\"125\">01</div>\n        <div class=\"flex-1\" data-kid=\"126\">\n          <div class=\"flex items-center gap-4 mb-2\" data-kid=\"127\">\n             <p class=\"font-mono text-xs opacity-50 uppercase tracking-widest\" data-kid=\"128\">March 2024 / ARCHITECTURE</p>\n             <div class=\"w-2 h-2 rounded-full bg-[var(--accent-blue)]\" data-kid=\"129\"></div>\n          </div>\n          <h4 class=\"text-4xl md:text-5xl font-black font-[var(--font-display)] group-hover:text-[var(--accent-blue)] transition-colors\" data-kid=\"130\">THE RHYTHM OF THE GRID: BEYOND FLEXBOX</h4>\n        </div>\n        <div class=\"hidden md:block w-48 h-32 border-[var(--border-thick)] border-[var(--ink)] overflow-hidden opacity-0 group-hover:opacity-100 transition-opacity translate-x-12 group-hover:translate-x-0 transition-transform\" data-kid=\"131\">\n           <video src=\"https://videos.pexels.com/video-files/36597637/15516650_360_640_30fps.mp4\" class=\"w-full h-full object-cover grayscale\" autoplay muted loop playsinline data-kid=\"132\"></video>\n        </div>\n      </div>\n\n      \n      <div class=\"group py-12 border-b-[var(--border-thick)] border-dotted border-[var(--ink)] flex flex-col md:flex-row gap-8 items-start md:items-center relative\" data-kid=\"133\">\n        <div class=\"w-20 h-20 bg-[var(--ink)] text-[var(--paper)] rounded-full flex items-center justify-center font-black text-3xl shrink-0 group-hover:bg-[var(--accent-red)] transition-colors\" data-kid=\"134\">02</div>\n        <div class=\"flex-1\" data-kid=\"135\">\n           <div class=\"flex items-center gap-4 mb-2\" data-kid=\"136\">\n             <p class=\"font-mono text-xs opacity-50 uppercase tracking-widest\" data-kid=\"137\">Feb 2024 / ENGINEERING</p>\n          </div>\n          <h4 class=\"text-4xl md:text-5xl font-black font-[var(--font-display)] group-hover:text-[var(--accent-blue)] transition-colors\" data-kid=\"138\">POSTERIZED INTERFACES IN REACT</h4>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section id=\"contact\" class=\"py-24 px-8 bg-[var(--paper)] border-t-[var(--border-thick)] border-[var(--ink)]\" data-kid=\"139\">\n    <div class=\"grid grid-cols-12 gap-8\" data-kid=\"140\">\n      <div class=\"col-span-12 lg:col-span-6\" data-kid=\"141\">\n        <h3 class=\"breakout-text text-[10rem] leading-[0.8] mb-12\" data-kid=\"142\">LET'S<br data-kid=\"143\"><span class=\"text-[var(--accent-red)]\" data-kid=\"144\">TALK</span></h3>\n        <div class=\"space-y-6\" data-kid=\"145\">\n          <div class=\"flex items-center gap-4\" data-kid=\"146\">\n            <i class=\"ti ti-mail text-4xl\" data-kid=\"147\"></i>\n            <span class=\"text-2xl font-black font-mono\" data-kid=\"148\">ARYANBARBATE@SYS.DEV</span>\n          </div>\n          <div class=\"flex gap-4\" data-kid=\"149\">\n            <div class=\"w-12 h-12 bg-black flex items-center justify-center text-white\" data-kid=\"150\"><i class=\"ti ti-brand-github text-2xl\" data-kid=\"151\"></i></div>\n            <div class=\"w-12 h-12 bg-black flex items-center justify-center text-white\" data-kid=\"152\"><i class=\"ti ti-brand-x text-2xl\" data-kid=\"153\"></i></div>\n            <div class=\"w-12 h-12 bg-black flex items-center justify-center text-white\" data-kid=\"154\"><i class=\"ti ti-brand-linkedin text-2xl\" data-kid=\"155\"></i></div>\n          </div>\n        </div>\n      </div>\n      \n      <div class=\"col-span-12 lg:col-span-6\" data-kid=\"156\">\n        <form class=\"space-y-0\" data-kid=\"157\">\n          <div class=\"relative border-[var(--border-thick)] border-[var(--ink)] p-8 pt-12 bg-white\" data-kid=\"158\">\n            <div class=\"absolute top-0 left-0 border-r-[var(--border-thick)] border-b-[var(--border-thick)] border-[var(--ink)] px-4 py-1 bg-[var(--ink)] text-[var(--paper)] font-mono text-xs font-bold uppercase\" data-kid=\"159\">NARRATOR</div>\n            <div class=\"grid grid-cols-2 gap-8 mb-8\" data-kid=\"160\">\n              <div class=\"col-span-2 md:col-span-1\" data-kid=\"161\">\n                <label class=\"block font-mono text-[10px] uppercase font-black mb-2 opacity-50\" data-kid=\"162\">INPUT: NAME</label>\n                <input type=\"text\" class=\"w-full border-b-[var(--border-thick)] border-[var(--ink)] bg-transparent py-2 outline-none font-mono text-sm placeholder:opacity-20\" placeholder=\"TYPE_HERE...\" data-kid=\"163\">\n              </div>\n              <div class=\"col-span-2 md:col-span-1\" data-kid=\"164\">\n                <label class=\"block font-mono text-[10px] uppercase font-black mb-2 opacity-50\" data-kid=\"165\">INPUT: EMAIL</label>\n                <input type=\"email\" class=\"w-full border-b-[var(--border-thick)] border-[var(--ink)] bg-transparent py-2 outline-none font-mono text-sm placeholder:opacity-20\" placeholder=\"PROTO_ADDRESS...\" data-kid=\"166\">\n              </div>\n            </div>\n            <div class=\"mb-12\" data-kid=\"167\">\n               <label class=\"block font-mono text-[10px] uppercase font-black mb-2 opacity-50\" data-kid=\"168\">INPUT: MESSAGE</label>\n               <textarea rows=\"4\" class=\"w-full border-[var(--border-thick)] border-[var(--ink)] bg-[var(--paper)] p-4 outline-none font-mono text-sm resize-none\" placeholder=\"YOUR_TRANSMISSION...\" data-kid=\"169\"></textarea>\n            </div>\n            <button class=\"w-full bg-[var(--accent-red)] text-white font-black font-mono py-4 border-[var(--border-thick)] border-[var(--ink)] shadow-[8px_8px_0_var(--ink)] hover:translate-x-[4px] hover:translate-y-[4px] hover:shadow-none transition-all flex items-center justify-center gap-4 group\" data-kid=\"170\">\n              SEND_TRANSMISSION <i class=\"ti ti-send text-xl group-hover:translate-x-2 transition-transform\" data-kid=\"171\"></i>\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"py-12 px-8 bg-[var(--ink)] text-[var(--paper)] flex flex-col md:flex-row justify-between items-center gap-8\" data-kid=\"172\">\n    <div class=\"flex items-center gap-8\" data-kid=\"173\">\n      <div class=\"text-4xl font-black font-[var(--font-display)]\" data-kid=\"174\">ARYAN.DEV</div>\n      <div class=\"w-px h-12 bg-white opacity-20\" data-kid=\"175\"></div>\n      <p class=\"font-mono text-[10px] max-w-xs opacity-60\" data-kid=\"176\">\n        CODED IN INDIA. DESIGNED FOR THE INTERNET. \n        ALL RIGHTS RESERVED © 2024. VOL 1. ISSUE 02.\n      </p>\n    </div>\n    <div class=\"flex gap-4\" data-kid=\"177\">\n      <img src=\"https://cdn.jsdelivr.net/npm/openmoji-named-svgs@latest/color/black-nib.svg\" class=\"w-8 h-8\" alt=\"Nib\" data-kid=\"178\">\n      <div class=\"font-mono text-[10px] uppercase border border-white/20 px-4 py-2\" data-kid=\"179\">\n        ENCODED WITH INTEGRITY\n      </div>\n    </div>\n  </footer>\n</div>\n\n<script data-kid=\"180\">\n  // Simple Horizontal Scroll behavior indicator\n  const container = document.querySelector('.filmstrip-container');\n  if (container) {\n    container.addEventListener('wheel', (e) => {\n      if (e.deltaY !== 0) {\n        e.preventDefault();\n        container.scrollLeft += e.deltaY;\n      }\n    });\n  }\n</script>",
