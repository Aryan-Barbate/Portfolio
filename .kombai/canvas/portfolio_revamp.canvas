    },
    "var_40b941473bc1": {
      "type": "variant",
      "label": "Kinetic Hybrid - Velocity",
      "parentId": "var_b147d8870838",
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:ital,wght@0,700;0,800;0,900;1,700;1,800;1,900&family=Work+Sans:wght@300;400;500;600&family=Space+Mono:wght@400;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n\n  :root {\n    --paper: #f4f0e8;\n    --ink: #000000;\n    --cobalt: #002387;\n    --vermillion: #e85d04;\n    --font-header: 'Big Shoulders Display', sans-serif;\n    --font-body: 'Work Sans', sans-serif;\n    --font-mono: 'Space Mono', monospace;\n    --border-thick: 4px solid var(--ink);\n  }\n\n  body {\n    background-color: var(--paper);\n    color: var(--ink);\n    font-family: var(--font-body);\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  /* Utility Classes */\n  .manga-panel {\n    border: var(--border-thick);\n    background: white;\n    position: relative;\n    box-shadow: 4px 4px 0px var(--ink);\n    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1);\n  }\n\n  .manga-panel:hover {\n    transform: translate(-4px, -4px) skewX(-1deg);\n    box-shadow: 12px 12px 0px var(--ink);\n  }\n\n  .halftone {\n    background-image: radial-gradient(var(--ink) 1.5px, transparent 0);\n    background-size: 10px 10px;\n    opacity: 0.08;\n  }\n\n  .big-header {\n    font-family: var(--font-header);\n    text-transform: uppercase;\n    line-height: 0.8;\n    letter-spacing: -0.04em;\n  }\n\n  .cobalt-flood { background-color: var(--cobalt); color: white; }\n  .vermillion-flood { background-color: var(--vermillion); color: white; }\n\n  /* Loader */\n  #loader-screen {\n    position: fixed;\n    inset: 0;\n    background: var(--ink);\n    z-index: 10000;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    overflow: hidden;\n  }\n\n  .loader-slash {\n    position: absolute;\n    width: 200%;\n    height: 15px;\n    background: var(--vermillion);\n    box-shadow: 0 0 50px var(--vermillion);\n    transform: rotate(-15deg) translateY(0);\n    z-index: 10001;\n  }\n\n  .loader-part-top, .loader-part-bottom {\n    position: absolute;\n    left: 0;\n    width: 100%;\n    height: 50%;\n    background: var(--ink);\n    z-index: 10000;\n  }\n  .loader-part-top { top: 0; }\n  .loader-part-bottom { bottom: 0; }\n\n  /* Hero Diagonal */\n  .hero-slash {\n    position: absolute;\n    top: 30%;\n    left: -10%;\n    width: 120%;\n    height: 8px;\n    background: var(--vermillion);\n    transform: rotate(-8deg);\n    z-index: 5;\n    box-shadow: 0 0 30px var(--vermillion);\n  }\n\n  /* Matrix Rain Borders */\n  .matrix-border {\n    position: relative;\n    overflow: hidden;\n  }\n  .matrix-border::before {\n    content: '';\n    position: absolute;\n    inset: 0;\n    border: 4px solid transparent;\n    border-image: linear-gradient(to bottom, var(--cobalt), transparent) 1;\n    opacity: 0.3;\n  }\n\n  /* Speech Bubble */\n  .shout-bubble {\n    clip-path: polygon(0% 0%, 100% 0%, 100% 75%, 75% 75%, 75% 100%, 50% 75%, 0% 75%);\n    background: var(--vermillion);\n    padding: 2rem 2rem 4rem 2rem;\n    color: white;\n    transform: rotate(-2deg);\n  }\n\n  /* Narrator Box */\n  .narrator-box {\n    background: var(--ink);\n    color: white;\n    padding: 0.25rem 0.75rem;\n    font-family: var(--font-mono);\n    font-size: 0.65rem;\n    text-transform: uppercase;\n    position: absolute;\n    top: -12px;\n    left: 12px;\n    z-index: 10;\n  }\n\n  .work-panel {\n    will-change: transform;\n  }\n\n  /* Reading Path Lines */\n  .reading-path-line {\n    position: absolute;\n    border-left: 4px solid var(--cobalt);\n    border-bottom: 4px solid var(--cobalt);\n    z-index: 0;\n    opacity: 0.4;\n  }\n</style>\n\n\n<div id=\"loader-screen\" data-kid=\"1\">\n  <div class=\"loader-slash\" data-kid=\"2\"></div>\n  <div class=\"loader-part-top\" data-kid=\"3\"></div>\n  <div class=\"loader-part-bottom\" data-kid=\"4\"></div>\n  <div class=\"absolute z-[10002] flex flex-col items-center\" data-kid=\"5\">\n    <div class=\"italic-heavy text-[8vw] text-white big-header tracking-tighter\" id=\"loader-text\" data-kid=\"6\">ARYAN_B</div>\n    <div class=\"w-64 h-1 bg-white/20 mt-4 overflow-hidden\" data-kid=\"7\">\n      <div class=\"h-full bg-[var(--vermillion)]\" id=\"loader-bar\" style=\"width: 0%\" data-kid=\"8\"></div>\n    </div>\n  </div>\n</div>\n\n<nav class=\"fixed top-0 left-0 w-full z-[500] flex justify-between items-center px-12 py-8 mix-blend-difference\" data-kid=\"9\">\n  <div class=\"manga-panel px-6 py-2 bg-white border-black rotate-[-2deg]\" data-kid=\"10\">\n    <span class=\"font-black text-2xl uppercase tracking-tighter\" data-kid=\"11\">BARBATE_V3</span>\n  </div>\n  <div class=\"flex gap-12 font-mono text-xs uppercase tracking-[0.3em] text-white\" data-kid=\"12\">\n    <a href=\"#work\" class=\"hover:text-[var(--vermillion)] transition-colors underline underline-offset-8\" data-kid=\"13\">Projects</a>\n    <a href=\"#journey\" class=\"hover:text-[var(--vermillion)] transition-colors\" data-kid=\"14\">History</a>\n    <a href=\"#skills\" class=\"hover:text-[var(--vermillion)] transition-colors\" data-kid=\"15\">Arsenal</a>\n    <a href=\"#contact\" class=\"hover:text-[var(--vermillion)] transition-colors\" data-kid=\"16\">Pulse</a>\n  </div>\n</nav>\n\n\n<section class=\"min-h-screen pt-40 pb-20 px-12 relative flex items-center justify-center overflow-hidden\" data-kid=\"17\">\n  <div class=\"absolute inset-0 halftone pointer-events-none\" data-kid=\"18\"></div>\n  <div class=\"hero-slash\" data-kid=\"19\"></div>\n  \n  <div class=\"grid grid-cols-12 gap-8 w-full relative z-10\" data-kid=\"20\">\n    <div class=\"col-span-8\" data-kid=\"21\">\n      <div class=\"manga-panel p-16 bg-white rotate-[1deg]\" data-kid=\"22\">\n        <h1 class=\"big-header text-[14vw] italic leading-[0.75] mb-8\" data-kid=\"23\">\n          KINETIC<br data-kid=\"24\">\n          <span class=\"text-[var(--cobalt)]\" data-kid=\"25\">FRONT</span><span class=\"text-[var(--vermillion)]\" data-kid=\"26\">END</span>\n        </h1>\n        <p class=\"max-w-2xl text-2xl font-semibold leading-tight border-l-8 border-[var(--cobalt)] pl-8\" data-kid=\"27\">\n          Fusing editorial craftsmanship with high-velocity motion. India-based architect of digital experiences.\n        </p>\n        <div class=\"mt-16 flex gap-6\" data-kid=\"28\">\n          <button class=\"manga-panel px-12 py-6 vermillion-flood font-black uppercase text-xl hover:rotate-[-2deg]\" data-kid=\"29\">EXPLORE_WORK</button>\n          <button class=\"manga-panel px-12 py-6 bg-black text-white font-black uppercase text-xl hover:rotate-[2deg]\" data-kid=\"30\">READ_ARCHIVE</button>\n        </div>\n      </div>\n    </div>\n    \n    <div class=\"col-span-4 flex items-end\" data-kid=\"31\">\n      <div class=\"manga-panel w-full aspect-[4/5] overflow-hidden rotate-[-4deg] relative group\" data-kid=\"32\">\n        <div class=\"absolute top-4 left-4 manga-panel cobalt-flood p-3 z-20 rotate-[5deg]\" data-kid=\"33\">\n          <span class=\"font-mono text-xs font-bold uppercase tracking-tighter\" data-kid=\"34\">DATA_TYPE: PORTRAIT</span>\n        </div>\n        <img src=\"https://images.unsplash.com/photo-1541715301255-12a4839b424a?auto=format&w=800&q=80&fit=crop\" class=\"w-full h-full object-cover grayscale contrast-200 group-hover:scale-110 transition-transform duration-500\" data-kid=\"35\">\n        <div class=\"absolute inset-0 bg-gradient-to-t from-[var(--cobalt)]/40 to-transparent\" data-kid=\"36\"></div>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<div class=\"bg-black py-6 border-y-8 border-[var(--vermillion)] overflow-hidden relative z-50\" data-kid=\"37\">\n  <div class=\"flex whitespace-nowrap gap-16 animate-[scroll_30s_linear_infinite]\" data-kid=\"38\">\n    <div class=\"flex items-center gap-16 text-white font-black italic text-5xl uppercase tracking-tighter\" data-kid=\"39\">\n      <span data-kid=\"40\">REACT_CORE</span> <i class=\"ti ti-circle-filled text-[var(--cobalt)] text-2xl\" data-kid=\"41\"></i>\n      <span data-kid=\"42\">GSAP_ENGINE</span> <i class=\"ti ti-circle-filled text-[var(--vermillion)] text-2xl\" data-kid=\"43\"></i>\n      <span data-kid=\"44\">NEXT_GEN_UI</span> <i class=\"ti ti-circle-filled text-[var(--cobalt)] text-2xl\" data-kid=\"45\"></i>\n      <span data-kid=\"46\">MOTION_CRAFT</span> <i class=\"ti ti-circle-filled text-[var(--vermillion)] text-2xl\" data-kid=\"47\"></i>\n      <span data-kid=\"48\">TYPESCRIPT_SYS</span> <i class=\"ti ti-circle-filled text-[var(--cobalt)] text-2xl\" data-kid=\"49\"></i>\n    </div>\n    <div class=\"flex items-center gap-16 text-white font-black italic text-5xl uppercase tracking-tighter\" data-kid=\"50\">\n      <span data-kid=\"51\">REACT_CORE</span> <i class=\"ti ti-circle-filled text-[var(--cobalt)] text-2xl\" data-kid=\"52\"></i>\n      <span data-kid=\"53\">GSAP_ENGINE</span> <i class=\"ti ti-circle-filled text-[var(--vermillion)] text-2xl\" data-kid=\"54\"></i>\n      <span data-kid=\"55\">NEXT_GEN_UI</span> <i class=\"ti ti-circle-filled text-[var(--cobalt)] text-2xl\" data-kid=\"56\"></i>\n      <span data-kid=\"57\">MOTION_CRAFT</span> <i class=\"ti ti-circle-filled text-[var(--vermillion)] text-2xl\" data-kid=\"58\"></i>\n      <span data-kid=\"59\">TYPESCRIPT_SYS</span> <i class=\"ti ti-circle-filled text-[var(--cobalt)] text-2xl\" data-kid=\"60\"></i>\n    </div>\n  </div>\n</div>\n\n\n<section id=\"work\" class=\"py-40 px-12 bg-white relative overflow-hidden\" data-kid=\"61\">\n  <div class=\"absolute inset-0 halftone opacity-10\" data-kid=\"62\"></div>\n  \n  <div class=\"mb-32 flex flex-col items-start\" data-kid=\"63\">\n    <div class=\"manga-panel cobalt-flood p-6 rotate-[-1deg] mb-4\" data-kid=\"64\">\n      <h2 class=\"big-header text-9xl leading-none\" data-kid=\"65\">THE_CATALOG</h2>\n    </div>\n    <div class=\"flex gap-4 font-mono text-lg font-bold\" data-kid=\"66\">\n      <span class=\"text-[var(--vermillion)]\" data-kid=\"67\">[ACTIVE ENTRIES]</span>\n      <span data-kid=\"68\">V03_HYBRID</span>\n    </div>\n  </div>\n\n  <div class=\"space-y-64 max-w-7xl mx-auto\" data-kid=\"69\">\n    \n    <div class=\"work-panel grid grid-cols-12 gap-0 relative group\" data-kid=\"70\">\n      <div class=\"col-span-9 manga-panel aspect-[16/9] overflow-hidden z-10 relative\" data-kid=\"71\">\n        <div class=\"absolute top-0 right-0 w-24 h-24 cobalt-flood flex items-center justify-center z-20\" data-kid=\"72\">\n          <i class=\"ti ti-arrow-up-right text-5xl font-black\" data-kid=\"73\"></i>\n        </div>\n        <img src=\"https://images.unsplash.com/photo-1586204712758-6c50443844c2?auto=format&w=1200&q=80&fit=crop\" class=\"w-full h-full object-cover grayscale brightness-50 group-hover:brightness-100 transition-all duration-700\" data-kid=\"74\">\n        <div class=\"absolute inset-0 halftone mix-blend-overlay opacity-40\" data-kid=\"75\"></div>\n      </div>\n      <div class=\"col-span-5 absolute -right-12 bottom-[-10%] manga-panel bg-white p-12 z-30 group-hover:rotate-[2deg]\" data-kid=\"76\">\n        <div class=\"narrator-box\" data-kid=\"77\">V01 / CREATIVE</div>\n        <h3 class=\"big-header text-7xl mb-4 italic\" data-kid=\"78\">LINEA_FLORA</h3>\n        <p class=\"text-lg font-bold opacity-70 mb-8 leading-snug\" data-kid=\"79\">Editorial florist interface with hyper-fluid micro-interactions and GSAP choreography.</p>\n        <button class=\"manga-panel px-8 py-3 bg-[var(--cobalt)] text-white font-black uppercase text-sm\" data-kid=\"80\">INITIATE_CASE_V01</button>\n      </div>\n    </div>\n\n    \n    <div class=\"work-panel grid grid-cols-12 gap-0 relative group\" data-kid=\"81\">\n      <div class=\"col-span-5 absolute -left-12 top-[-10%] manga-panel bg-white p-12 z-30 group-hover:rotate-[-2deg]\" data-kid=\"82\">\n        <div class=\"narrator-box\" data-kid=\"83\">V02 / PRODUCT</div>\n        <h3 class=\"big-header text-7xl mb-4 italic\" data-kid=\"84\">ANISCOPE</h3>\n        <p class=\"text-lg font-bold opacity-70 mb-8 leading-snug\" data-kid=\"85\">Cinematic anime discovery platform. Real-time API data meets brutalist manga panels.</p>\n        <button class=\"manga-panel px-8 py-3 bg-[var(--vermillion)] text-white font-black uppercase text-sm\" data-kid=\"86\">LAUNCH_SYSTEM_V02</button>\n      </div>\n      <div class=\"col-span-9 col-start-4 manga-panel aspect-[16/9] overflow-hidden z-10 relative\" data-kid=\"87\">\n        <div class=\"absolute top-0 left-0 w-24 h-24 vermillion-flood flex items-center justify-center z-20\" data-kid=\"88\">\n          <i class=\"ti ti-bolt text-5xl font-black\" data-kid=\"89\"></i>\n        </div>\n        <img src=\"https://images.unsplash.com/photo-1593349480374-01bb7d5782d5?auto=format&w=1200&q=80&fit=crop\" class=\"w-full h-full object-cover grayscale brightness-50 group-hover:brightness-100 transition-all duration-700\" data-kid=\"90\">\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"journey\" class=\"py-40 px-12 bg-[var(--paper)] relative\" data-kid=\"91\">\n  <div class=\"mb-32 flex justify-end\" data-kid=\"92\">\n    <div class=\"manga-panel bg-black text-white p-6 rotate-[2deg]\" data-kid=\"93\">\n      <h2 class=\"big-header text-8xl leading-none italic\" data-kid=\"94\">THE_CHRONICLE</h2>\n    </div>\n  </div>\n\n  <div class=\"relative max-w-5xl mx-auto space-y-40\" data-kid=\"95\">\n    <div class=\"reading-path-line top-20 left-1/2 w-[100px] h-[300px]\" data-kid=\"96\"></div>\n    <div class=\"reading-path-line top-[450px] right-1/2 w-[100px] h-[300px] rotate-180\" data-kid=\"97\"></div>\n\n    \n    <div class=\"flex justify-start relative z-10\" data-kid=\"98\">\n      <div class=\"manga-panel p-10 bg-white w-96 rotate-[-2deg] hover:rotate-0\" data-kid=\"99\">\n        <div class=\"absolute -top-6 -left-6 w-16 h-16 bg-[var(--cobalt)] text-white flex items-center justify-center big-header text-3xl font-black\" data-kid=\"100\">01</div>\n        <h4 class=\"font-black uppercase text-2xl mb-4 border-b-4 border-black pb-2 tracking-tighter italic\" data-kid=\"101\">THE_SEED</h4>\n        <p class=\"font-bold opacity-80 leading-relaxed text-sm\" data-kid=\"102\">Initial contact with the DOM. A digital awakening through raw HTML/CSS experimentation.</p>\n      </div>\n    </div>\n\n    \n    <div class=\"flex justify-end relative z-10\" data-kid=\"103\">\n      <div class=\"manga-panel p-10 bg-white w-96 rotate-[3deg] hover:rotate-0\" data-kid=\"104\">\n        <div class=\"absolute -top-6 -right-6 w-16 h-16 bg-[var(--vermillion)] text-white flex items-center justify-center big-header text-3xl font-black\" data-kid=\"105\">02</div>\n        <h4 class=\"font-black uppercase text-2xl mb-4 border-b-4 border-black pb-2 tracking-tighter italic\" data-kid=\"106\">LOGIC_FLOOD</h4>\n        <p class=\"font-bold opacity-80 leading-relaxed text-sm\" data-kid=\"107\">JavaScript shifts from a tool to a language. Building functional systems and reactive states.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"skills\" class=\"py-40 px-12 bg-black text-white relative\" data-kid=\"108\">\n  <div class=\"absolute inset-0 halftone opacity-5\" data-kid=\"109\"></div>\n  \n  <div class=\"grid grid-cols-12 gap-12 mb-40\" data-kid=\"110\">\n    <div class=\"col-span-5\" data-kid=\"111\">\n      <div class=\"shout-bubble\" data-kid=\"112\">\n        <h2 class=\"big-header text-8xl italic\" data-kid=\"113\">ARSENAL</h2>\n        <p class=\"font-mono text-xs uppercase tracking-widest mt-4\" data-kid=\"114\">CORE_STRENGTH: Lvl_99</p>\n      </div>\n      <p class=\"mt-20 font-bold text-xl leading-relaxed opacity-60\" data-kid=\"115\">Technical weaponry optimized for high-impact front-end warfare and cinematic interfaces.</p>\n    </div>\n    \n    <div class=\"col-span-7 grid grid-cols-2 gap-8\" data-kid=\"116\">\n      <div class=\"manga-panel p-8 bg-white text-black rotate-[1deg] hover:rotate-[-1deg]\" data-kid=\"117\">\n        <h4 class=\"font-black uppercase text-2xl mb-6 tracking-tighter border-b-4 border-black pb-2 italic\" data-kid=\"118\">DEVELOPMENT</h4>\n        <div class=\"space-y-4 font-mono text-sm uppercase font-black\" data-kid=\"119\">\n          <div class=\"flex items-center gap-3\" data-kid=\"120\"><i class=\"ti ti-zap text-[var(--vermillion)]\" data-kid=\"121\"></i> React / Next.js</div>\n          <div class=\"flex items-center gap-3\" data-kid=\"122\"><i class=\"ti ti-zap text-[var(--vermillion)]\" data-kid=\"123\"></i> TypeScript</div>\n          <div class=\"flex items-center gap-3\" data-kid=\"124\"><i class=\"ti ti-zap text-[var(--vermillion)]\" data-kid=\"125\"></i> Tailwind_CSS</div>\n          <div class=\"flex items-center gap-3\" data-kid=\"126\"><i class=\"ti ti-zap text-[var(--vermillion)]\" data-kid=\"127\"></i> Node_Runtime</div>\n        </div>\n      </div>\n      <div class=\"manga-panel p-8 bg-white text-black rotate-[-2deg] hover:rotate-[1deg]\" data-kid=\"128\">\n        <h4 class=\"font-black uppercase text-2xl mb-6 tracking-tighter border-b-4 border-black pb-2 italic\" data-kid=\"129\">DYNAMICS</h4>\n        <div class=\"space-y-4 font-mono text-sm uppercase font-black\" data-kid=\"130\">\n          <div class=\"flex items-center gap-3\" data-kid=\"131\"><i class=\"ti ti-activity text-[var(--cobalt)]\" data-kid=\"132\"></i> GSAP_Animation</div>\n          <div class=\"flex items-center gap-3\" data-kid=\"133\"><i class=\"ti ti-activity text-[var(--cobalt)]\" data-kid=\"134\"></i> Framer_Motion</div>\n          <div class=\"flex items-center gap-3\" data-kid=\"135\"><i class=\"ti ti-activity text-[var(--cobalt)]\" data-kid=\"136\"></i> Web_GL_Shaders</div>\n          <div class=\"flex items-center gap-3\" data-kid=\"137\"><i class=\"ti ti-activity text-[var(--cobalt)]\" data-kid=\"138\"></i> Perf_Opt_V3</div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  \n  <div class=\"manga-panel bg-[#121210] border-[var(--cobalt)] p-1 offset-shadow matrix-border\" data-kid=\"139\">\n    <div class=\"flex items-center justify-between px-8 py-4 bg-black border-b-4 border-[var(--cobalt)]\" data-kid=\"140\">\n      <div class=\"flex gap-3\" data-kid=\"141\">\n        <div class=\"w-3 h-3 rounded-full bg-[#ff5f56]\" data-kid=\"142\"></div>\n        <div class=\"w-3 h-3 rounded-full bg-[#ffbd2e]\" data-kid=\"143\"></div>\n        <div class=\"w-3 h-3 rounded-full bg-[#27c93f]\" data-kid=\"144\"></div>\n      </div>\n      <div class=\"font-mono text-xs text-[var(--cobalt)] font-bold tracking-[0.4em]\" data-kid=\"145\">GITHUB_PULSE_MONITOR</div>\n      <i class=\"ti ti-terminal text-2xl text-[var(--cobalt)]\" data-kid=\"146\"></i>\n    </div>\n    <div class=\"p-12 grid grid-cols-4 gap-1 halftone opacity-10\" data-kid=\"147\">\n      <div class=\"col-span-4 font-mono text-[var(--cobalt)] text-sm mb-12 animate-pulse\" data-kid=\"148\">> Initializing Git_Neural_Link... Success.</div>\n      \n      <div class=\"stat-cell p-8 bg-black border border-white/5 flex flex-col items-center\" data-kid=\"149\">\n        <div class=\"big-header text-6xl text-[var(--vermillion)] italic\" data-kid=\"150\">250+</div>\n        <div class=\"font-mono text-[10px] opacity-40 mt-2\" data-kid=\"151\">COMMITS_YTD</div>\n      </div>\n      <div class=\"stat-cell p-8 bg-black border border-white/5 flex flex-col items-center\" data-kid=\"152\">\n        <div class=\"big-header text-6xl text-[var(--cobalt)] italic\" data-kid=\"153\">12</div>\n        <div class=\"font-mono text-[10px] opacity-40 mt-2\" data-kid=\"154\">ACTIVE_REPOS</div>\n      </div>\n      <div class=\"stat-cell p-8 bg-black border border-white/5 flex flex-col items-center\" data-kid=\"155\">\n        <div class=\"big-header text-6xl text-[var(--vermillion)] italic\" data-kid=\"156\">04</div>\n        <div class=\"font-mono text-[10px] opacity-40 mt-2\" data-kid=\"157\">MAJOR_RELEASES</div>\n      </div>\n      <div class=\"stat-cell p-8 bg-black border border-white/5 flex flex-col items-center\" data-kid=\"158\">\n        <div class=\"big-header text-6xl text-[var(--cobalt)] italic\" data-kid=\"159\">99</div>\n        <div class=\"font-mono text-[10px] opacity-40 mt-2\" data-kid=\"160\">CRAFT_SCORE</div>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"contact\" class=\"py-40 px-12 bg-white relative\" data-kid=\"161\">\n  <div class=\"grid grid-cols-12 gap-12 max-w-7xl mx-auto\" data-kid=\"162\">\n    <div class=\"col-span-5\" data-kid=\"163\">\n      <div class=\"manga-panel vermillion-flood p-12 rotate-[-4deg]\" data-kid=\"164\">\n        <h2 class=\"big-header text-8xl leading-[0.75] italic\" data-kid=\"165\">ESTABLISH<br data-kid=\"166\">LINK</h2>\n        <p class=\"font-mono text-sm mt-8 opacity-90 font-bold uppercase tracking-widest\" data-kid=\"167\">Awaiting manual interaction for collaboration request.</p>\n      </div>\n    </div>\n    \n    <div class=\"col-span-7 space-y-12\" data-kid=\"168\">\n      <div class=\"relative group\" data-kid=\"169\">\n        <div class=\"narrator-box\" data-kid=\"170\">USER_IDENTITY</div>\n        <input type=\"text\" class=\"w-full manga-panel p-6 focus:bg-[var(--paper)] outline-none font-bold text-xl transition-all\" placeholder=\"IDENTIFY YOURSELF...\" data-kid=\"171\">\n      </div>\n      <div class=\"relative group\" data-kid=\"172\">\n        <div class=\"narrator-box\" data-kid=\"173\">SIGNAL_DESTINATION</div>\n        <input type=\"email\" class=\"w-full manga-panel p-6 focus:bg-[var(--paper)] outline-none font-bold text-xl transition-all\" placeholder=\"EMAIL_COORDINATES...\" data-kid=\"174\">\n      </div>\n      <div class=\"relative group\" data-kid=\"175\">\n        <div class=\"narrator-box\" data-kid=\"176\">CORE_MESSAGE_DATA</div>\n        <textarea class=\"w-full manga-panel p-6 focus:bg-[var(--paper)] outline-none font-bold text-xl min-h-[200px] transition-all\" placeholder=\"TRANSMIT MESSAGE...\" data-kid=\"177\"></textarea>\n      </div>\n      <button class=\"w-full manga-panel bg-black text-white p-8 big-header text-5xl italic hover:bg-[var(--cobalt)] transition-colors\" data-kid=\"178\">INITIATE_TRANSMISSION</button>\n    </div>\n  </div>\n</section>\n\n<footer class=\"py-20 px-12 bg-black text-white relative\" data-kid=\"179\">\n  <div class=\"absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-[var(--cobalt)] via-[var(--vermillion)] to-[var(--cobalt)]\" data-kid=\"180\"></div>\n  <div class=\"max-w-7xl mx-auto flex flex-col items-center\" data-kid=\"181\">\n    <div class=\"italic-heavy big-header text-[12vw] opacity-10 select-none pointer-events-none absolute bottom-0\" data-kid=\"182\">ARYANB</div>\n    <div class=\"flex gap-20 font-black uppercase text-3xl italic relative z-10\" data-kid=\"183\">\n      <a href=\"#\" class=\"hover:text-[var(--vermillion)]\" data-kid=\"184\">TWITTER_LINK</a>\n      <a href=\"#\" class=\"hover:text-[var(--cobalt)]\" data-kid=\"185\">GITHUB_HUB</a>\n      <a href=\"#\" class=\"hover:text-[var(--vermillion)]\" data-kid=\"186\">LINKED_NET</a>\n    </div>\n    <div class=\"mt-20 pt-10 border-t border-white/20 w-full flex justify-between items-center font-mono text-[10px] tracking-[0.5em] opacity-40 uppercase\" data-kid=\"187\">\n      <span data-kid=\"188\">© 2024 / DATA_HYBRID_SYSTEM</span>\n      <span data-kid=\"189\">PANEL_POP_VELOCITY_V3</span>\n      <span data-kid=\"190\">END_OF_PAGE [^]</span>\n    </div>\n  </div>\n</footer>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"191\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"192\"></script>\n<script data-kid=\"193\">\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Loader Animation\n  const tl = gsap.timeline();\n  tl.to(\"#loader-bar\", { width: \"100%\", duration: 1.5, ease: \"power2.inOut\" })\n    .to(\"#loader-text\", { skewX: -20, opacity: 0, duration: 0.3 })\n    .to(\".loader-slash\", { rotate: 0, scaleY: 200, duration: 0.6, ease: \"power4.in\" })\n    .to(\".loader-part-top\", { y: \"-100%\", duration: 0.8, ease: \"power4.inOut\" }, \"-=0.2\")\n    .to(\".loader-part-bottom\", { y: \"100%\", duration: 0.8, ease: \"power4.inOut\" }, \"-=0.8\")\n    .to(\"#loader-screen\", { opacity: 0, pointerEvents: \"none\", duration: 0.4 })\n    .from(\"section\", { opacity: 0, y: 50, duration: 1, stagger: 0.2, ease: \"power3.out\" }, \"-=0.4\");\n\n  // Velocity-Skew Parallax Scroll\n  gsap.utils.toArray('.work-panel').forEach(panel => {\n    gsap.fromTo(panel, \n      { skewY: 0 }, \n      {\n        skewY: 10,\n        ease: \"none\",\n        scrollTrigger: {\n          trigger: panel,\n          start: \"top bottom\",\n          end: \"bottom top\",\n          scrub: true\n        }\n      }\n    );\n  });\n\n  // Floating Hero elements\n  gsap.to('.hero-inner img', {\n    y: -30,\n    rotate: 2,\n    duration: 4,\n    repeat: -1,\n    yoyo: true,\n    ease: \"sine.inOut\"\n  });\n\n  // Milestone Entrance\n  gsap.utils.toArray('.manga-panel').forEach(panel => {\n    gsap.from(panel, {\n      scrollTrigger: {\n        trigger: panel,\n        start: \"top 90%\",\n        toggleActions: \"play none none reverse\"\n      },\n      scale: 0.95,\n      opacity: 0,\n      duration: 0.8,\n      ease: \"back.out(1.7)\"\n    });\n  });\n\n  // Reading Path Reveal\n  gsap.utils.toArray('.reading-path-line').forEach(line => {\n    gsap.from(line, {\n      scrollTrigger: {\n        trigger: line,\n        start: \"top 80%\",\n        end: \"bottom 50%\",\n        scrub: 1\n      },\n      height: 0,\n      opacity: 0\n    });\n  });\n</script>",
