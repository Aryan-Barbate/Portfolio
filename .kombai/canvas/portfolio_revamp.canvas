      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800;900&family=Work+Sans:wght@300;400;500;600&family=Space+Mono&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n\n  :root {\n    --paper: #f4f0e8;\n    --ink: #000000;\n    --cobalt: #002387;\n    --vermillion: #e85d04;\n    --font-header: 'Big Shoulders Display', sans-serif;\n    --font-body: 'Work Sans', sans-serif;\n    --font-mono: 'Space Mono', monospace;\n    --border-thick: 3px solid var(--ink);\n    --shadow-pop: 8px 8px 0px var(--ink);\n  }\n\n  body {\n    background-color: var(--paper);\n    color: var(--ink);\n    font-family: var(--font-body);\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .manga-panel {\n    border: var(--border-thick);\n    background: white;\n    position: relative;\n    transition: transform 0.2s var(--ease-out);\n  }\n\n  .manga-panel:hover {\n    transform: translate(-4px, -4px);\n    box-shadow: 12px 12px 0px var(--ink);\n  }\n\n  .halftone {\n    background-image: radial-gradient(var(--ink) 1px, transparent 0);\n    background-size: 8px 8px;\n    opacity: 0.1;\n  }\n\n  .big-header {\n    font-family: var(--font-header);\n    text-transform: uppercase;\n    line-height: 0.85;\n    letter-spacing: -0.02em;\n  }\n\n  .offset-shadow {\n    box-shadow: var(--shadow-pop);\n  }\n\n  .cobalt-flood { background-color: var(--cobalt); color: white; }\n  .vermillion-flood { background-color: var(--vermillion); color: white; }\n\n  /* GSAP specific */\n  .work-panel-left { transform: translateX(-100px); opacity: 0; }\n  .work-panel-right { transform: translateX(100px); opacity: 0; }\n  \n  .marquee-content {\n    display: flex;\n    white-space: nowrap;\n    animation: scroll 20s linear infinite;\n  }\n\n  @keyframes scroll {\n    from { transform: translateX(0); }\n    to { transform: translateX(-50%); }\n  }\n\n  .grain-overlay {\n    position: fixed;\n    inset: 0;\n    background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E\");\n    opacity: 0.05;\n    pointer-events: none;\n    z-index: 1000;\n  }\n</style>\n\n<div class=\"grain-overlay\" data-kid=\"1\"></div>\n\n\n<nav class=\"fixed top-0 left-0 w-full z-50 flex justify-between items-center px-12 py-6 mix-blend-difference\" data-kid=\"2\">\n  <div class=\"manga-panel px-4 py-1 bg-white border-2 border-black rotate-[-2deg]\" data-kid=\"3\">\n    <span class=\"font-bold text-xl uppercase tracking-tighter\" data-kid=\"4\">Aryan / Portfolio</span>\n  </div>\n  <div class=\"flex gap-8 font-bold uppercase text-white tracking-widest text-sm\" data-kid=\"5\">\n    <a href=\"#work\" class=\"hover:text-[var(--vermillion)] transition-colors\" data-kid=\"6\">Work</a>\n    <a href=\"#journey\" class=\"hover:text-[var(--vermillion)] transition-colors\" data-kid=\"7\">Journey</a>\n    <a href=\"#skills\" class=\"hover:text-[var(--vermillion)] transition-colors\" data-kid=\"8\">Skills</a>\n    <a href=\"#about\" class=\"hover:text-[var(--vermillion)] transition-colors\" data-kid=\"9\">About</a>\n  </div>\n</nav>\n\n\n<section class=\"min-h-screen pt-32 pb-20 px-12 grid grid-cols-12 gap-6 relative\" data-kid=\"10\">\n  \n  <div class=\"absolute inset-0 halftone pointer-events-none\" data-kid=\"11\"></div>\n  \n  <div class=\"col-span-7 flex flex-col justify-end\" data-kid=\"12\">\n    <div class=\"manga-panel p-10 bg-white offset-shadow z-10 relative\" data-kid=\"13\">\n      <h1 class=\"big-header text-[12vw] leading-none mb-6\" data-kid=\"14\">\n        Frontend <br data-kid=\"15\">\n        <span class=\"text-[var(--vermillion)]\" data-kid=\"16\">Architect</span>\n      </h1>\n      <p class=\"max-w-xl text-xl font-medium leading-relaxed\" data-kid=\"17\">\n        Building high-performance interfaces with a high-contrast editorial soul. Currently crafting digital experiences in India.\n      </p>\n      <div class=\"mt-12 flex gap-4\" data-kid=\"18\">\n        <button class=\"manga-panel px-8 py-4 vermillion-flood font-black uppercase text-lg hover:scale-105\" data-kid=\"19\">View Selected Work</button>\n        <button class=\"manga-panel px-8 py-4 bg-white font-black uppercase text-lg hover:scale-105\" data-kid=\"20\">Read the story</button>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"col-span-5 relative\" data-kid=\"21\">\n    <div class=\"manga-panel w-full aspect-[3/4] overflow-hidden offset-shadow rotate-[3deg] scale-105\" data-kid=\"22\">\n      <img src=\"https://images.unsplash.com/photo-1541715301255-12a4839b424a?auto=format&w=800&q=80&fit=crop\" alt=\"Posterized Portrait\" class=\"w-full h-full object-cover grayscale contrast-150 brightness-90 mix-blend-multiply\" decoding=\"async\" loading=\"lazy\" data-kid=\"23\">\n      <div class=\"absolute inset-0 bg-[var(--vermillion)] mix-blend-overlay opacity-30\" data-kid=\"24\"></div>\n    </div>\n    \n    <div class=\"absolute -top-4 -left-8 manga-panel cobalt-flood p-3 rotate-[-5deg] z-20\" data-kid=\"25\">\n      <span class=\"font-mono text-xs uppercase font-bold tracking-tighter\" data-kid=\"26\">VOL. 2024 / EDITION 01</span>\n    </div>\n  </div>\n</section>\n\n\n<div class=\"bg-black py-4 border-y-4 border-black overflow-hidden relative z-20\" data-kid=\"27\">\n  <div class=\"marquee-content flex items-center gap-12\" data-kid=\"28\">\n    <div class=\"flex items-center gap-12 text-white font-black uppercase text-4xl tracking-tighter\" data-kid=\"29\">\n      <span data-kid=\"30\">React</span> <div class=\"w-3 h-3 bg-[var(--vermillion)] rounded-full\" data-kid=\"31\"></div>\n      <span data-kid=\"32\">GSAP</span> <div class=\"w-3 h-3 bg-[var(--cobalt)] rounded-full\" data-kid=\"33\"></div>\n      <span data-kid=\"34\">Framer Motion</span> <div class=\"w-3 h-3 bg-[var(--vermillion)] rounded-full\" data-kid=\"35\"></div>\n      <span data-kid=\"36\">Tailwind CSS</span> <div class=\"w-3 h-3 bg-[var(--cobalt)] rounded-full\" data-kid=\"37\"></div>\n      <span data-kid=\"38\">TypeScript</span> <div class=\"w-3 h-3 bg-[var(--vermillion)] rounded-full\" data-kid=\"39\"></div>\n      <span data-kid=\"40\">Next.js</span> <div class=\"w-3 h-3 bg-[var(--cobalt)] rounded-full\" data-kid=\"41\"></div>\n    </div>\n    <div class=\"flex items-center gap-12 text-white font-black uppercase text-4xl tracking-tighter\" data-kid=\"42\">\n      <span data-kid=\"43\">React</span> <div class=\"w-3 h-3 bg-[var(--vermillion)] rounded-full\" data-kid=\"44\"></div>\n      <span data-kid=\"45\">GSAP</span> <div class=\"w-3 h-3 bg-[var(--cobalt)] rounded-full\" data-kid=\"46\"></div>\n      <span data-kid=\"47\">Framer Motion</span> <div class=\"w-3 h-3 bg-[var(--vermillion)] rounded-full\" data-kid=\"48\"></div>\n      <span data-kid=\"49\">Tailwind CSS</span> <div class=\"w-3 h-3 bg-[var(--cobalt)] rounded-full\" data-kid=\"50\"></div>\n      <span data-kid=\"51\">TypeScript</span> <div class=\"w-3 h-3 bg-[var(--vermillion)] rounded-full\" data-kid=\"52\"></div>\n      <span data-kid=\"53\">Next.js</span> <div class=\"w-3 h-3 bg-[var(--cobalt)] rounded-full\" data-kid=\"54\"></div>\n    </div>\n  </div>\n</div>\n\n\n<section id=\"work\" class=\"py-32 px-12 bg-white relative overflow-hidden\" data-kid=\"55\">\n  <div class=\"absolute inset-0 halftone opacity-5\" data-kid=\"56\"></div>\n  <div class=\"mb-20 flex justify-between items-end\" data-kid=\"57\">\n    <div class=\"manga-panel bg-[var(--cobalt)] text-white p-4 rotate-[-2deg] offset-shadow\" data-kid=\"58\">\n      <h2 class=\"big-header text-8xl leading-none\" data-kid=\"59\">SELECTED PROJECTS</h2>\n    </div>\n    <span class=\"font-mono text-xl font-bold\" data-kid=\"60\">[04 / 04]</span>\n  </div>\n\n  <div class=\"space-y-40 max-w-6xl mx-auto\" data-kid=\"61\">\n    \n    <div class=\"work-panel-left grid grid-cols-12 gap-0 group\" data-kid=\"62\">\n      <div class=\"col-span-8 manga-panel aspect-video overflow-hidden offset-shadow z-10\" data-kid=\"63\">\n        <img src=\"https://images.unsplash.com/photo-1586204712758-6c50443844c2?auto=format&w=1200&q=80&fit=crop\" class=\"w-full h-full object-cover grayscale transition-transform duration-700 group-hover:scale-110\" decoding=\"async\" loading=\"lazy\" alt=\"Linea Flora\" data-kid=\"64\">\n      </div>\n      <div class=\"col-span-4 manga-panel bg-[var(--paper)] p-8 -ml-6 mt-12 z-20 self-start offset-shadow transition-all group-hover:bg-[var(--vermillion)] group-hover:text-white\" data-kid=\"65\">\n        <span class=\"font-mono text-xs mb-2 block font-bold opacity-60\" data-kid=\"66\">Creative Builder</span>\n        <h3 class=\"big-header text-6xl leading-none mb-4\" data-kid=\"67\">Linea Flora</h3>\n        <p class=\"text-sm font-medium mb-6\" data-kid=\"68\">A high-end editorial experience for a boutique florist, focused on micro-interactions and performance.</p>\n        <a href=\"#\" class=\"inline-flex items-center gap-2 font-bold uppercase tracking-widest text-xs border-b-2 border-current\" data-kid=\"69\">View Case Study <i class=\"ti ti-arrow-up-right\" data-kid=\"70\"></i></a>\n      </div>\n    </div>\n\n    \n    <div class=\"work-panel-right grid grid-cols-12 gap-0 group\" data-kid=\"71\">\n      <div class=\"col-span-4 manga-panel bg-[var(--paper)] p-8 -mr-6 mt-12 z-20 self-start offset-shadow transition-all group-hover:bg-[var(--cobalt)] group-hover:text-white text-right\" data-kid=\"72\">\n        <span class=\"font-mono text-xs mb-2 block font-bold opacity-60\" data-kid=\"73\">Live Product</span>\n        <h3 class=\"big-header text-6xl leading-none mb-4 text-right\" data-kid=\"74\">AniScope</h3>\n        <p class=\"text-sm font-medium mb-6\" data-kid=\"75\">Discover anime through a cinematic lens. Real-time API integration with a brutalist layout.</p>\n        <a href=\"#\" class=\"inline-flex items-center gap-2 font-bold uppercase tracking-widest text-xs border-b-2 border-current\" data-kid=\"76\">Launch Demo <i class=\"ti ti-arrow-up-right\" data-kid=\"77\"></i></a>\n      </div>\n      <div class=\"col-span-8 manga-panel aspect-video overflow-hidden offset-shadow z-10\" data-kid=\"78\">\n        <img src=\"https://images.unsplash.com/photo-1593349480374-01bb7d5782d5?auto=format&w=1200&q=80&fit=crop\" class=\"w-full h-full object-cover grayscale transition-transform duration-700 group-hover:scale-110\" decoding=\"async\" loading=\"lazy\" alt=\"AniScope\" data-kid=\"79\">\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section id=\"skills\" class=\"py-32 px-12 relative bg-[var(--paper)]\" data-kid=\"80\">\n  <div class=\"max-w-7xl mx-auto\" data-kid=\"81\">\n    <div class=\"grid grid-cols-12 gap-12\" data-kid=\"82\">\n      <div class=\"col-span-4 flex flex-col justify-center\" data-kid=\"83\">\n        <div class=\"manga-panel vermillion-flood p-8 rotate-[-3deg] offset-shadow mb-8\" data-kid=\"84\">\n          <h2 class=\"big-header text-7xl leading-none\" data-kid=\"85\">CORE<br data-kid=\"86\">SKILLS</h2>\n        </div>\n        <p class=\"font-medium text-lg leading-relaxed\" data-kid=\"87\">\n          The weapons of choice for modern web combat. Heavily focused on frontend excellence and user-centric motion.\n        </p>\n      </div>\n\n      <div class=\"col-span-8 grid grid-cols-2 gap-6\" data-kid=\"88\">\n        \n        <div class=\"manga-panel p-8 bg-white offset-shadow group\" data-kid=\"89\">\n          <div class=\"absolute top-0 right-0 w-12 h-12 bg-black flex items-center justify-center text-white\" data-kid=\"90\">\n            <i class=\"ti ti-bolt text-2xl\" data-kid=\"91\"></i>\n          </div>\n          <h4 class=\"font-black uppercase tracking-tighter text-2xl mb-6 border-b-2 border-black pb-2\" data-kid=\"92\">Development</h4>\n          <ul class=\"space-y-4 font-bold uppercase tracking-widest text-sm\" data-kid=\"93\">\n            <li class=\"flex items-center gap-3\" data-kid=\"94\"><i class=\"ti ti-zap text-[var(--vermillion)]\" data-kid=\"95\"></i> React / Next.js</li>\n            <li class=\"flex items-center gap-3\" data-kid=\"96\"><i class=\"ti ti-zap text-[var(--vermillion)]\" data-kid=\"97\"></i> TypeScript</li>\n            <li class=\"flex items-center gap-3\" data-kid=\"98\"><i class=\"ti ti-zap text-[var(--vermillion)]\" data-kid=\"99\"></i> Node.js</li>\n            <li class=\"flex items-center gap-3\" data-kid=\"100\"><i class=\"ti ti-zap text-[var(--vermillion)]\" data-kid=\"101\"></i> Tailwind CSS</li>\n          </ul>\n        </div>\n\n        <div class=\"manga-panel p-8 bg-white offset-shadow group\" data-kid=\"102\">\n          <div class=\"absolute top-0 right-0 w-12 h-12 bg-black flex items-center justify-center text-white\" data-kid=\"103\">\n            <i class=\"ti ti-brush text-2xl\" data-kid=\"104\"></i>\n          </div>\n          <h4 class=\"font-black uppercase tracking-tighter text-2xl mb-6 border-b-2 border-black pb-2\" data-kid=\"105\">Motion</h4>\n          <ul class=\"space-y-4 font-bold uppercase tracking-widest text-sm\" data-kid=\"106\">\n            <li class=\"flex items-center gap-3\" data-kid=\"107\"><i class=\"ti ti-zap text-[var(--cobalt)]\" data-kid=\"108\"></i> GSAP</li>\n            <li class=\"flex items-center gap-3\" data-kid=\"109\"><i class=\"ti ti-zap text-[var(--cobalt)]\" data-kid=\"110\"></i> Framer Motion</li>\n            <li class=\"ti ti-zap text-[var(--cobalt)]\" data-kid=\"111\"> SVG Animation</li>\n            <li class=\"flex items-center gap-3\" data-kid=\"112\"><i class=\"ti ti-zap text-[var(--cobalt)]\" data-kid=\"113\"></i> Performance Opt</li>\n          </ul>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<footer class=\"py-20 px-12 bg-black text-white relative overflow-hidden\" data-kid=\"114\">\n  <div class=\"absolute top-0 left-0 w-full h-1 bg-[var(--vermillion)]\" data-kid=\"115\"></div>\n  <div class=\"max-w-7xl mx-auto flex flex-col items-center gap-12\" data-kid=\"116\">\n    <div class=\"manga-panel bg-white text-black px-10 py-4 rotate-[-1deg]\" data-kid=\"117\">\n      <h2 class=\"big-header text-6xl leading-none uppercase\" data-kid=\"118\">Let's Connect</h2>\n    </div>\n    \n    <div class=\"flex gap-12 font-black uppercase text-2xl tracking-tighter\" data-kid=\"119\">\n      <a href=\"#\" class=\"hover:text-[var(--vermillion)]\" data-kid=\"120\">Twitter</a>\n      <a href=\"#\" class=\"hover:text-[var(--cobalt)]\" data-kid=\"121\">Github</a>\n      <a href=\"#\" class=\"hover:text-[var(--vermillion)]\" data-kid=\"122\">LinkedIn</a>\n    </div>\n\n    <div class=\"mt-20 pt-8 border-t border-white/20 w-full flex justify-between items-center font-mono text-[10px] tracking-widest opacity-50 uppercase\" data-kid=\"123\">\n      <span data-kid=\"124\">© 2024 ARYAN BARBATE</span>\n      <span data-kid=\"125\">BUILT WITH CRAFT AND PANELS</span>\n      <span data-kid=\"126\">BACK TO TOP [^]</span>\n    </div>\n  </div>\n</footer>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"127\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"128\"></script>\n<script data-kid=\"129\">\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Hero image drift\n  gsap.to('.hero-inner img', {\n    y: -20,\n    duration: 3,\n    repeat: -1,\n    yoyo: true,\n    ease: \"sine.inOut\"\n  });\n\n  // Work Panels Entrance\n  gsap.utils.toArray('.work-panel-left').forEach(panel => {\n    gsap.to(panel, {\n      x: 0,\n      opacity: 1,\n      duration: 1.5,\n      ease: \"power4.out\",\n      scrollTrigger: {\n        trigger: panel,\n        start: \"top 80%\",\n        toggleActions: \"play none none reverse\"\n      }\n    });\n  });\n\n  gsap.utils.toArray('.work-panel-right').forEach(panel => {\n    gsap.to(panel, {\n      x: 0,\n      opacity: 1,\n      duration: 1.5,\n      ease: \"power4.out\",\n      scrollTrigger: {\n        trigger: panel,\n        start: \"top 80%\",\n        toggleActions: \"play none none reverse\"\n      }\n    });\n  });\n\n  // Halftone reveal\n  gsap.from('.halftone', {\n    opacity: 0,\n    duration: 2,\n    ease: \"power2.out\"\n  });\n</script>",
