    "var_48c3def33f64": {
      "type": "variant",
      "label": "Cyber-Manga Glitch",
      "parentId": "var_ada8bbdc0c1b",
      "themeId": null,
      "rect": {
        "x": 9240,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Chivo:wght@300;400;700&family=Space+Mono&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --void: #09090b;\n    --harsh-white: #f4f4f5;\n    --matrix: #00ff41;\n    --magenta: #ff003c;\n    --cyan: #00f0ff;\n    --font-header: 'Bebas Neue', sans-serif;\n    --font-body: 'Chivo', sans-serif;\n    --font-mono: 'Space Mono', monospace;\n    --border-glitch: 4px solid var(--harsh-white);\n    --shadow-cyan: 10px 10px 0px var(--cyan);\n    --shadow-magenta: -10px -10px 0px var(--magenta);\n  }\n\n  body {\n    background-color: var(--void);\n    color: var(--harsh-white);\n    font-family: var(--font-body);\n    margin: 0;\n    overflow-x: hidden;\n    perspective: 1500px;\n  }\n\n  .glitch-grid {\n    position: fixed;\n    inset: 0;\n    background-image: \n      linear-gradient(rgba(0, 255, 65, 0.05) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(0, 255, 65, 0.05) 1px, transparent 1px);\n    background-size: 50px 50px;\n    pointer-events: none;\n    z-index: -1;\n    transform: rotateX(60deg) translateY(-200px);\n  }\n\n  .manga-panel-3d {\n    background: var(--void);\n    border: var(--border-glitch);\n    box-shadow: 8px 8px 0px var(--cyan), -8px -8px 0px var(--magenta);\n    transform-style: preserve-3d;\n    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n    position: relative;\n  }\n\n  .manga-panel-3d:hover {\n    transform: translateZ(30px) rotateX(5deg) rotateY(-5deg);\n    border-color: var(--matrix);\n  }\n\n  .chromatic-aberration {\n    position: relative;\n    color: white;\n  }\n  .chromatic-aberration::before, .chromatic-aberration::after {\n    content: attr(data-text);\n    position: absolute;\n    top: 0; left: 0; width: 100%; height: 100%;\n    opacity: 0.8;\n  }\n  .chromatic-aberration::before { color: var(--magenta); z-index: -1; transform: translate(-2px, 0); animation: glitch-left 2s infinite linear alternate-reverse; }\n  .chromatic-aberration::after { color: var(--cyan); z-index: -2; transform: translate(2px, 0); animation: glitch-right 2s infinite linear alternate-reverse; }\n\n  @keyframes glitch-left { 0% { transform: translate(-2px, 0); } 100% { transform: translate(-5px, -2px); } }\n  @keyframes glitch-right { 0% { transform: translate(2px, 0); } 100% { transform: translate(5px, 2px); } }\n\n  .scanline {\n    position: absolute;\n    top: 0; left: 0; width: 100%; height: 2px;\n    background: rgba(0, 255, 65, 0.2);\n    animation: scan 4s linear infinite;\n    pointer-events: none;\n  }\n  @keyframes scan { 0% { top: 0; } 100% { top: 100%; } }\n\n  /* Binary Rain Loader */\n  #loader-overlay {\n    position: fixed; inset: 0; background: black; z-index: 10000;\n    display: flex; flex-direction: column; align-items: center; justify-content: center;\n    font-family: var(--font-mono); color: var(--matrix);\n  }\n  .binary-stream { position: absolute; top: -100px; font-size: 10px; opacity: 0.5; }\n\n  .warp-container { transform-style: preserve-3d; }\n  .warped-panel { transform: rotateY(20deg) rotateX(10deg); }\n\n  .big-header {\n    font-family: var(--font-header);\n    font-size: 12vw;\n    line-height: 0.8;\n    text-transform: uppercase;\n  }\n\n  .neon-text {\n    text-shadow: 0 0 10px var(--matrix), 0 0 20px var(--matrix);\n  }\n\n  .diagonal-slash {\n    position: absolute; width: 200%; height: 10px; background: var(--magenta);\n    box-shadow: 0 0 30px var(--magenta); transform: rotate(-15deg);\n    top: 50%; left: -50%; z-index: 50;\n  }\n</style>\n\n<div id=\"loader-overlay\" data-kid=\"1\">\n  <div id=\"binary-container\" class=\"absolute inset-0 overflow-hidden pointer-events-none\" data-kid=\"2\"></div>\n  <div class=\"z-10 text-center\" data-kid=\"3\">\n    <div class=\"text-4xl mb-4 neon-text\" data-kid=\"4\">> SYSTEM_BOOT</div>\n    <div id=\"loader-percent\" class=\"text-xl\" data-kid=\"5\">0%</div>\n  </div>\n</div>\n\n<div class=\"glitch-grid\" data-kid=\"6\"></div>\n\n<nav class=\"fixed top-0 left-0 w-full z-[100] flex justify-between items-center px-12 py-8 mix-blend-difference\" data-kid=\"7\">\n  <div class=\"manga-panel-3d px-6 py-2 border-2 border-white rotate-[-3deg]\" data-kid=\"8\">\n    <span class=\"font-bold text-2xl tracking-tighter neon-text\" data-kid=\"9\">AB // V.03</span>\n  </div>\n  <div class=\"flex gap-12 font-mono text-xs uppercase tracking-[0.4em]\" data-kid=\"10\">\n    <a href=\"#work\" class=\"hover:text-[var(--matrix)] transition-all\" data-kid=\"11\">DECRYPT_WORK</a>\n    <a href=\"#journey\" class=\"hover:text-[var(--matrix)] transition-all\" data-kid=\"12\">TRACE_PATH</a>\n    <a href=\"#contact\" class=\"hover:text-[var(--matrix)] transition-all\" data-kid=\"13\">ESTABLISH_LINK</a>\n  </div>\n</nav>\n\n<main class=\"relative z-10\" data-kid=\"14\">\n  \n  <section class=\"min-h-screen flex items-center px-20 relative overflow-hidden\" id=\"hero\" data-kid=\"15\">\n    <div class=\"diagonal-slash\" data-kid=\"16\"></div>\n    <div class=\"grid grid-cols-12 gap-12 w-full items-center\" data-kid=\"17\">\n      <div class=\"col-span-8 z-20\" data-kid=\"18\">\n        <div class=\"manga-panel-3d bg-black/80 p-12 backdrop-blur-xl\" data-kid=\"19\">\n          <div class=\"scanline\" data-kid=\"20\"></div>\n          <span class=\"font-mono text-xs text-[var(--matrix)] mb-6 block tracking-[0.5em]\" data-kid=\"21\">PROTOCOL_LEVEL: OVERDRIVE</span>\n          <h1 class=\"big-header chromatic-aberration mb-8\" data-text=\"ARYAN BARBATE\" data-kid=\"22\">ARYAN BARBATE</h1>\n          <p class=\"text-3xl font-light leading-relaxed max-w-2xl text-[var(--harsh-white)]/80\" data-kid=\"23\">\n            I am a <span class=\"text-[var(--matrix)] neon-text italic\" data-kid=\"24\">Front-end Mercenary</span> building immersive 3D manga environments with high-voltage kinetics.\n          </p>\n          <div class=\"flex gap-8 mt-12\" data-kid=\"25\">\n            <button class=\"manga-panel-3d bg-[var(--matrix)] text-black px-12 py-6 font-header text-4xl tracking-widest hover:scale-105 active:scale-95\" data-kid=\"26\">EXECUTE ARCHIVE</button>\n            <button class=\"manga-panel-3d border-2 border-[var(--cyan)] px-12 py-6 font-header text-4xl tracking-widest hover:bg-[var(--cyan)] hover:text-black\" data-kid=\"27\">CHAPTER_02</button>\n          </div>\n        </div>\n      </div>\n      <div class=\"col-span-4 relative group\" data-kid=\"28\">\n        <div class=\"manga-panel-3d aspect-[3/4] rotateY(20deg) overflow-hidden group-hover:rotateY(0deg) duration-700\" data-kid=\"29\">\n          <div class=\"scanline\" data-kid=\"30\"></div>\n          <img src=\"https://images.unsplash.com/photo-1563863251222-11d3e3bd3b62?auto=format&w=800&q=80&fit=crop\" class=\"w-full h-full object-cover grayscale contrast-150 brightness-50 mix-blend-screen\" alt=\"Cyberpunk View\" data-kid=\"31\">\n          <div class=\"absolute inset-0 bg-gradient-to-t from-[var(--magenta)]/60 to-transparent mix-blend-color-dodge\" data-kid=\"32\"></div>\n        </div>\n        <div class=\"absolute -bottom-10 -left-10 manga-panel-3d bg-[var(--cyan)] text-black p-4 rotate-[-10deg] font-mono text-xs font-bold\" data-kid=\"33\">\n          LATENCY: 12ms // STABLE\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <div class=\"bg-black py-10 border-y-8 border-[var(--harsh-white)] overflow-hidden flex whitespace-nowrap -rotate-2 relative z-20\" data-kid=\"34\">\n    <div class=\"flex animate-[marquee_40s_linear_infinite] gap-20 items-center\" data-kid=\"35\">\n      <span class=\"font-header text-8xl text-white tracking-tighter italic\" data-kid=\"36\">REACT REDESIGN</span>\n      <img src=\"https://cdn.jsdelivr.net/npm/openmoji-named-svgs@latest/color/collision.svg\" class=\"h-16\" data-kid=\"37\">\n      <span class=\"font-header text-8xl text-[var(--matrix)] tracking-tighter\" data-kid=\"38\">Z-AXIS FLOW</span>\n      <img src=\"https://cdn.jsdelivr.net/npm/openmoji-named-svgs@latest/color/bomb.svg\" class=\"h-16\" data-kid=\"39\">\n      <span class=\"font-header text-8xl text-[var(--magenta)] tracking-tighter italic\" data-kid=\"40\">KINETIC GLITCH</span>\n      <img src=\"https://cdn.jsdelivr.net/npm/openmoji-named-svgs@latest/color/collision.svg\" class=\"h-16\" data-kid=\"41\">\n      <span class=\"font-header text-8xl text-[var(--cyan)] tracking-tighter\" data-kid=\"42\">3D MANGA SOUL</span>\n    </div>\n  </div>\n\n  \n  <section class=\"py-40 px-20 bg-black relative\" id=\"work\" data-kid=\"43\">\n    <div class=\"absolute inset-0 glitch-grid opacity-10 pointer-events-none\" data-kid=\"44\"></div>\n    <div class=\"flex justify-between items-end mb-32\" data-kid=\"45\">\n      <h2 class=\"big-header neon-text italic text-[15vw]\" data-kid=\"46\">WORKS.dat</h2>\n      <div class=\"font-mono text-right text-sm opacity-50 tracking-widest text-[var(--magenta)]\" data-kid=\"47\">\n        EXTRACTING ENTRIES...<br data-kid=\"48\">\n        [####------] 40%\n      </div>\n    </div>\n\n    <div class=\"warp-container space-y-80\" data-kid=\"49\">\n      \n      <div class=\"grid grid-cols-12 gap-0 items-center warped-panel group\" data-kid=\"50\">\n        <div class=\"col-span-7 manga-panel-3d aspect-video overflow-hidden z-10 group-hover:translateZ(100px) duration-500\" data-kid=\"51\">\n          <div class=\"scanline\" data-kid=\"52\"></div>\n          <img src=\"https://images.unsplash.com/photo-1600998837340-4887228e311f?auto=format&w=1200&q=80&fit=crop\" class=\"w-full h-full object-cover grayscale contrast-200 group-hover:grayscale-0 duration-700\" alt=\"Linea Flora\" data-kid=\"53\">\n          <div class=\"absolute inset-0 bg-[var(--matrix)] mix-blend-multiply opacity-20\" data-kid=\"54\"></div>\n        </div>\n        <div class=\"col-span-5 manga-panel-3d bg-[var(--harsh-white)] text-black p-12 -ml-20 z-20 group-hover:rotateY(-10deg) duration-500\" data-kid=\"55\">\n          <span class=\"font-mono text-xs uppercase font-bold mb-4 block text-[var(--magenta)]\" data-kid=\"56\">01 / CREATIVE_BUILDER</span>\n          <h3 class=\"font-header text-8xl leading-none mb-6\" data-kid=\"57\">LINEA FLORA</h3>\n          <p class=\"text-xl font-medium mb-10 leading-tight\" data-kid=\"58\">Editorial flower curation with a high-motion soul. Redesigned for the glitch era.</p>\n          <button class=\"w-full py-5 bg-black text-white font-header text-3xl tracking-widest hover:bg-[var(--magenta)] transition-colors\" data-kid=\"59\">DECRYPT_DATA</button>\n        </div>\n      </div>\n\n      \n      <div class=\"grid grid-cols-12 gap-0 items-center warped-panel group\" style=\"transform: rotateY(-20deg)\" data-kid=\"60\">\n        <div class=\"col-span-5 manga-panel-3d bg-[var(--harsh-white)] text-black p-12 -mr-20 z-20 group-hover:rotateY(10deg) duration-500 text-right\" data-kid=\"61\">\n          <span class=\"font-mono text-xs uppercase font-bold mb-4 block text-[var(--cyan)]\" data-kid=\"62\">02 / LIVE_PRODUCT</span>\n          <h3 class=\"font-header text-8xl leading-none mb-6\" data-kid=\"63\">ANISCOPE</h3>\n          <p class=\"text-xl font-medium mb-10 leading-tight\" data-kid=\"64\">Cinematic anime discovery engine. Real-time data streams filtered through a 3D lens.</p>\n          <button class=\"w-full py-5 bg-black text-white font-header text-3xl tracking-widest hover:bg-[var(--cyan)] transition-colors\" data-kid=\"65\">L_DEMO.sh</button>\n        </div>\n        <div class=\"col-span-7 manga-panel-3d aspect-video overflow-hidden z-10 group-hover:translateZ(100px) duration-500\" data-kid=\"66\">\n          <div class=\"scanline\" data-kid=\"67\"></div>\n          <img src=\"https://images.unsplash.com/photo-1707999464758-0ad86b14290f?auto=format&w=1200&q=80&fit=crop\" class=\"w-full h-full object-cover grayscale contrast-200 group-hover:grayscale-0 duration-700\" alt=\"AniScope\" data-kid=\"68\">\n          <div class=\"absolute inset-0 bg-[var(--cyan)] mix-blend-multiply opacity-20\" data-kid=\"69\"></div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-40 px-20 bg-[var(--void)]\" id=\"journey\" data-kid=\"70\">\n    <div class=\"diagonal-slash\" style=\"top: 10%; transform: rotate(5deg)\" data-kid=\"71\"></div>\n    <div class=\"flex justify-between items-end mb-32\" data-kid=\"72\">\n       <h2 class=\"big-header chromatic-aberration italic\" data-text=\"EVOLUTION\" data-kid=\"73\">EVOLUTION</h2>\n       <div class=\"font-mono text-right text-xs opacity-40 tracking-[0.5em] uppercase\" data-kid=\"74\">YEARS: 2020_2024</div>\n    </div>\n\n    <div class=\"flex h-[70vh] gap-4 perspective-[2000px]\" data-kid=\"75\">\n      <div class=\"manga-panel-3d flex-1 bg-[var(--magenta)] text-white p-12 rotateY(30deg) hover:rotateY(0deg) hover:translateZ(50px) hover:flex-[2] transition-all duration-700 group\" data-kid=\"76\">\n        <div class=\"scanline\" data-kid=\"77\"></div>\n        <div class=\"text-9xl font-header opacity-20\" data-kid=\"78\">01</div>\n        <h3 class=\"text-6xl font-header mt-auto\" data-kid=\"79\">THE SEED</h3>\n        <p class=\"font-mono text-sm mt-6 opacity-0 group-hover:opacity-100 duration-500\" data-kid=\"80\">DISCOVERING LOGIC. FIRST CONTACT WITH DOM_CORE.</p>\n      </div>\n      <div class=\"manga-panel-3d flex-1 bg-[var(--matrix)] text-black p-12 rotateY(0deg) hover:translateZ(100px) hover:flex-[2] transition-all duration-700 group\" data-kid=\"81\">\n        <div class=\"scanline\" data-kid=\"82\"></div>\n        <div class=\"text-9xl font-header opacity-20\" data-kid=\"83\">02</div>\n        <h3 class=\"text-6xl font-header mt-auto\" data-kid=\"84\">THE ROOT</h3>\n        <p class=\"font-mono text-sm mt-6 opacity-0 group-hover:opacity-100 duration-500\" data-kid=\"85\">SYSTEM ARCHITECTURE. REACT_HOOKS AND STATE_FLOW.</p>\n      </div>\n      <div class=\"manga-panel-3d flex-1 bg-[var(--cyan)] text-black p-12 rotateY(-30deg) hover:rotateY(0deg) hover:translateZ(50px) hover:flex-[2] transition-all duration-700 group\" data-kid=\"86\">\n        <div class=\"scanline\" data-kid=\"87\"></div>\n        <div class=\"text-9xl font-header opacity-20\" data-kid=\"88\">03</div>\n        <h3 class=\"text-6xl font-header mt-auto\" data-kid=\"89\">THE BLOOM</h3>\n        <p class=\"font-mono text-sm mt-6 opacity-0 group-hover:opacity-100 duration-500\" data-kid=\"90\">KINETIC FRONTEND. 3D_CRAFT AND PERFORMANCE_OPT.</p>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-40 px-20 bg-black overflow-hidden\" id=\"skills\" data-kid=\"91\">\n    <div class=\"grid grid-cols-12 gap-20\" data-kid=\"92\">\n      <div class=\"col-span-5\" data-kid=\"93\">\n        <div class=\"manga-panel-3d bg-white text-black p-12 rotateX(15deg) -rotateY(10deg)\" data-kid=\"94\">\n          <div class=\"scanline\" data-kid=\"95\"></div>\n          <h2 class=\"font-header text-9xl mb-8 leading-none\" data-kid=\"96\">COMBAT<br data-kid=\"97\">STATS</h2>\n          <p class=\"text-2xl font-bold font-mono text-[var(--magenta)]\" data-kid=\"98\">\n            [ LOADING_ARSENAL... ]\n          </p>\n        </div>\n      </div>\n      <div class=\"col-span-7 grid grid-cols-2 gap-12\" data-kid=\"99\">\n        \n        <div class=\"manga-panel-3d bg-black p-10 rotateY(15deg) hover:rotateY(0deg) duration-500 border-[var(--matrix)]\" data-kid=\"100\">\n          <div class=\"scanline\" data-kid=\"101\"></div>\n          <div class=\"flex justify-between items-center mb-10\" data-kid=\"102\">\n            <h4 class=\"font-header text-5xl\" data-kid=\"103\">FRONTEND</h4>\n            <span class=\"text-7xl font-header text-[var(--matrix)]\" data-kid=\"104\">99</span>\n          </div>\n          <div class=\"h-2 w-full bg-white/10 mb-10 overflow-hidden\" data-kid=\"105\">\n            <div class=\"h-full bg-[var(--matrix)] w-[99%] neon-text shadow-[0_0_15px_#00ff41]\" data-kid=\"106\"></div>\n          </div>\n          <ul class=\"font-mono text-xs space-y-4 text-[var(--matrix)]\" data-kid=\"107\">\n            <li data-kid=\"108\">> React / Next.js</li>\n            <li data-kid=\"109\">> TypeScript</li>\n            <li data-kid=\"110\">> Tailwind CSS</li>\n          </ul>\n        </div>\n        <div class=\"manga-panel-3d bg-black p-10 -rotateY(15deg) hover:rotateY(0deg) duration-500 border-[var(--magenta)]\" data-kid=\"111\">\n          <div class=\"scanline\" data-kid=\"112\"></div>\n          <div class=\"flex justify-between items-center mb-10\" data-kid=\"113\">\n            <h4 class=\"font-header text-5xl\" data-kid=\"114\">KINETICS</h4>\n            <span class=\"text-7xl font-header text-[var(--magenta)]\" data-kid=\"115\">95</span>\n          </div>\n          <div class=\"h-2 w-full bg-white/10 mb-10 overflow-hidden\" data-kid=\"116\">\n            <div class=\"h-full bg-[var(--magenta)] w-[95%] shadow-[0_0_15px_#ff003c]\" data-kid=\"117\"></div>\n          </div>\n          <ul class=\"font-mono text-xs space-y-4 text-[var(--magenta)]\" data-kid=\"118\">\n            <li data-kid=\"119\">> GSAP / 3D</li>\n            <li data-kid=\"120\">> Framer Motion</li>\n            <li data-kid=\"121\">> Three.js / WebGL</li>\n          </ul>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"py-60 px-20 bg-[var(--void)] flex items-center justify-center relative overflow-hidden\" id=\"contact\" data-kid=\"122\">\n    <div class=\"absolute inset-0 binary-container opacity-5\" data-kid=\"123\"></div>\n    <div class=\"manga-panel-3d bg-[var(--harsh-white)] p-20 text-black max-w-5xl w-full rotateX(10deg) hover:rotateX(0deg) duration-700\" data-kid=\"124\">\n      <div class=\"scanline\" data-kid=\"125\"></div>\n      <div class=\"grid grid-cols-2 gap-20\" data-kid=\"126\">\n        <div data-kid=\"127\">\n          <h2 class=\"font-header text-huge text-9xl leading-[0.7] mb-12 chromatic-aberration\" data-text=\"ESTABLISH LINK\" data-kid=\"128\">ESTABLISH<br data-kid=\"129\">LINK</h2>\n          <p class=\"font-mono text-lg opacity-60\" data-kid=\"130\">Initializing encrypted transmission channel. Awaiting handshake...</p>\n          <div class=\"mt-20 flex gap-8\" data-kid=\"131\">\n            <img src=\"https://cdn.jsdelivr.net/npm/openmoji-named-svgs@latest/color/bomb.svg\" class=\"h-20 grayscale hover:grayscale-0 cursor-pointer\" data-kid=\"132\">\n            <img src=\"https://cdn.jsdelivr.net/npm/openmoji-named-svgs@latest/color/collision.svg\" class=\"h-20 grayscale hover:grayscale-0 cursor-pointer\" data-kid=\"133\">\n          </div>\n        </div>\n        <form class=\"space-y-8\" data-kid=\"134\">\n          <div class=\"manga-panel-3d border-2 bg-white p-4\" data-kid=\"135\">\n            <label class=\"font-mono text-[10px] font-black uppercase text-[var(--magenta)]\" data-kid=\"136\">NAME_INPUT</label>\n            <input type=\"text\" placeholder=\"WHO ARE YOU?\" class=\"bg-transparent border-none w-full font-header text-5xl outline-none placeholder:opacity-10\" data-kid=\"137\">\n          </div>\n          <div class=\"manga-panel-3d border-2 bg-white p-4\" data-kid=\"138\">\n            <label class=\"font-mono text-[10px] font-black uppercase text-[var(--cyan)]\" data-kid=\"139\">EMAIL_CHANNEL</label>\n            <input type=\"email\" placeholder=\"WHERE TO REPLY?\" class=\"bg-transparent border-none w-full font-header text-5xl outline-none placeholder:opacity-10\" data-kid=\"140\">\n          </div>\n          <button class=\"w-full manga-panel-3d bg-black text-white py-10 font-header text-5xl tracking-widest hover:bg-[var(--matrix)] hover:text-black duration-300\" data-kid=\"141\">SEND_SIGNAL</button>\n        </form>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer class=\"py-20 px-20 bg-black text-white border-t-4 border-[var(--matrix)] relative overflow-hidden\" data-kid=\"142\">\n    <div class=\"flex flex-col items-center gap-12 relative z-10\" data-kid=\"143\">\n      <div class=\"font-header text-[15vw] opacity-10 leading-none\" data-kid=\"144\">END TRANSMISSION</div>\n      <div class=\"flex gap-20 font-header text-6xl italic text-[var(--harsh-white)]\" data-kid=\"145\">\n        <a href=\"#\" class=\"hover:text-[var(--magenta)] duration-300\" data-kid=\"146\">X_SOCIAL</a>\n        <a href=\"#\" class=\"hover:text-[var(--matrix)] duration-300\" data-kid=\"147\">GITHUB_SRC</a>\n        <a href=\"#\" class=\"hover:text-[var(--cyan)] duration-300\" data-kid=\"148\">LN_PRO</a>\n      </div>\n      <div class=\"mt-20 flex justify-between w-full font-mono text-[10px] tracking-[1em] opacity-40 uppercase\" data-kid=\"149\">\n        <span data-kid=\"150\">© 2024 / CYBER_MANGA_ARCHIVE</span>\n        <span data-kid=\"151\">STAY_VOLATILE</span>\n        <span data-kid=\"152\">REBOOT [^]</span>\n      </div>\n    </div>\n    <div class=\"absolute inset-0 scanline opacity-5\" data-kid=\"153\"></div>\n  </footer>\n</main>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"154\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"155\"></script>\n<script data-kid=\"156\">\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Binary Rain Effect\n  const container = document.getElementById('binary-container');\n  for (let i = 0; i < 50; i++) {\n    const stream = document.createElement('div');\n    stream.className = 'binary-stream';\n    stream.style.left = `${Math.random() * 100}%`;\n    stream.textContent = Array.from({length: 20}, () => Math.round(Math.random())).join('\\n');\n    container.appendChild(stream);\n    \n    gsap.to(stream, {\n      y: window.innerHeight + 200,\n      duration: 1 + Math.random() * 2,\n      repeat: -1,\n      ease: \"none\",\n      delay: Math.random() * 2\n    });\n  }\n\n  // Loader Sequence\n  const loaderTl = gsap.timeline();\n  loaderTl.to(\"#loader-percent\", {\n    innerHTML: 100,\n    duration: 2,\n    snap: { innerHTML: 1 },\n    onUpdate: function() {\n      document.getElementById('loader-percent').innerHTML = `${this.targets()[0].innerHTML}%`;\n    }\n  })\n  .to(\"#loader-overlay\", {\n    yPercent: -100,\n    duration: 1,\n    ease: \"power4.inOut\"\n  })\n  .from(\"main\", {\n    opacity: 0,\n    z: -1000,\n    duration: 1.5,\n    ease: \"power2.out\"\n  }, \"-=0.5\");\n\n  // Velocity-based Warp for Work Section\n  let lastScroll = 0;\n  window.addEventListener('scroll', () => {\n    const currentScroll = window.scrollY;\n    const velocity = currentScroll - lastScroll;\n    lastScroll = currentScroll;\n\n    gsap.to('.warped-panel', {\n      rotateY: velocity * 0.1,\n      skewX: velocity * 0.05,\n      duration: 0.5,\n      ease: \"power2.out\"\n    });\n  });\n\n  // Smooth 3D Entrance for all Sections\n  gsap.utils.toArray('section').forEach(section => {\n    gsap.from(section, {\n      scrollTrigger: {\n        trigger: section,\n        start: \"top bottom\",\n        end: \"top center\",\n        scrub: 1\n      },\n      rotateX: 30,\n      opacity: 0,\n      scale: 0.8,\n      transformOrigin: \"top\"\n    });\n  });\n\n  // Marquee Speedup on Scroll\n  gsap.to(\".marquee-content\", {\n    scrollTrigger: {\n      trigger: \"body\",\n      start: \"top top\",\n      end: \"bottom bottom\",\n      scrub: 0.5\n    },\n    xPercent: -50,\n    ease: \"none\"\n  });\n\n  // Tilt Interaction for Hero Image\n  const heroPanel = document.querySelector('#hero .manga-panel-3d');\n  window.addEventListener('mousemove', (e) => {\n    const xPercent = (e.clientX / window.innerWidth - 0.5) * 2;\n    const yPercent = (e.clientY / window.innerHeight - 0.5) * 2;\n    \n    gsap.to(heroPanel, {\n      rotateY: xPercent * 10,\n      rotateX: -yPercent * 10,\n      duration: 1,\n      ease: \"power2.out\"\n    });\n  });\n</script>",
      "comments": [],
      "created": "2026-07-10T05:20:40.474583+00:00",
      "modified": "2026-07-10T05:21:21.892569+00:00",
      "id": "var_48c3def33f64",
      "viewportScrollY": 5866
    },
    "var_552bbcea272d": {
      "type": "variant",
      "label": "Brutalist Ink Wash",
      "parentId": "var_ada8bbdc0c1b",
      "themeId": null,
      "rect": {
        "x": 10780,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Syne:wght@800&family=Space+Mono:wght@400;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n\n  :root {\n    --ink: #111111;\n    --paper: #e5e5e5;\n    --accent: #8b0000;\n    --font-header: 'Syne', sans-serif;\n    --font-mono: 'Space Mono', monospace;\n    --border-brutal: 4px solid var(--ink);\n    --shadow-heavy: 12px 12px 0px var(--ink);\n  }\n\n  body {\n    background-color: var(--paper);\n    color: var(--ink);\n    font-family: var(--font-mono);\n    margin: 0;\n    overflow-x: hidden;\n    perspective: 2000px;\n  }\n\n  .ink-texture {\n    background-image: url('https://images.unsplash.com/photo-1629196911514-cfd8d628ba26?auto=format&w=1440&q=80&fit=crop');\n    background-size: cover;\n    background-blend-mode: multiply;\n    background-attachment: fixed;\n    opacity: 0.15;\n    position: fixed;\n    inset: 0;\n    pointer-events: none;\n    z-index: 0;\n  }\n\n  .section-hinge {\n    background: var(--paper);\n    border-top: var(--border-brutal);\n    min-height: 100vh;\n    width: 100%;\n    position: relative;\n    transform-style: preserve-3d;\n    transform-origin: top;\n    box-shadow: 0 -20px 50px rgba(0,0,0,0.1);\n    z-index: 10;\n  }\n\n  .brutal-panel {\n    background: white;\n    border: var(--border-brutal);\n    box-shadow: var(--shadow-heavy);\n    padding: 2rem;\n    position: relative;\n    transform-style: preserve-3d;\n  }\n\n  .syne-extra {\n    font-family: var(--font-header);\n    font-weight: 800;\n    text-transform: uppercase;\n    line-height: 0.8;\n    letter-spacing: -0.04em;\n  }\n\n  /* 3D Wireframe Cube */\n  .scene-cube {\n    width: 400px;\n    height: 400px;\n    perspective: 1000px;\n    margin: 0 auto;\n  }\n\n  .cube {\n    width: 100%;\n    height: 100%;\n    position: relative;\n    transform-style: preserve-3d;\n  }\n\n  .cube-face {\n    position: absolute;\n    width: 400px;\n    height: 400px;\n    border: 2px solid var(--ink);\n    background: rgba(255, 255, 255, 0.9);\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    align-items: center;\n    padding: 20px;\n    box-sizing: border-box;\n    backface-visibility: hidden;\n    overflow: hidden;\n  }\n\n  .front  { transform: rotateY(  0deg) translateZ(200px); }\n  .back   { transform: rotateY(180deg) translateZ(200px); }\n  .right  { transform: rotateY( 90deg) translateZ(200px); }\n  .left   { transform: rotateY(-90deg) translateZ(200px); }\n  .top    { transform: rotateX( 90deg) translateZ(200px); }\n  .bottom { transform: rotateX(-90deg) translateZ(200px); }\n\n  .cube-face img {\n    width: 100%;\n    height: 60%;\n    object-fit: cover;\n    filter: grayscale(1) contrast(1.2);\n    border: 2px solid var(--ink);\n    margin-bottom: 1rem;\n  }\n\n  /* Loader */\n  #ink-loader {\n    position: fixed;\n    inset: 0;\n    background: var(--ink);\n    z-index: 10000;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    clip-path: circle(150% at 50% 50%);\n  }\n\n  .marquee-brutal {\n    background: var(--ink);\n    color: white;\n    padding: 1rem 0;\n    border-y: var(--border-brutal);\n    overflow: hidden;\n    white-space: nowrap;\n    transform: rotate(-1deg);\n  }\n\n  .stat-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n    gap: 2rem;\n  }\n\n  .shuriken-icon {\n    width: 40px;\n    height: 40px;\n    filter: invert(1);\n    animation: spin 10s linear infinite;\n  }\n\n  @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }\n\n  .floating {\n    animation: float 3s ease-in-out infinite alternate;\n  }\n  @keyframes float {\n    from { transform: translateZ(20px) translateY(0); }\n    to { transform: translateZ(50px) translateY(-10px); }\n  }\n\n  .blood-text { color: var(--accent); }\n  .ink-flood { background-color: var(--ink); color: white; }\n\n</style>\n\n\n<div class=\"ink-texture\" data-kid=\"1\"></div>\n\n\n<div id=\"ink-loader\" data-kid=\"2\">\n  <div class=\"flex flex-col items-center gap-4\" data-kid=\"3\">\n    <h2 class=\"syne-extra text-6xl text-white\" data-kid=\"4\">BRUTALIST</h2>\n    <div class=\"w-48 h-1 bg-[var(--accent)]\" id=\"loader-bar\" data-kid=\"5\"></div>\n  </div>\n</div>\n\n<div id=\"main-content\" data-kid=\"6\">\n  \n  <nav class=\"fixed top-0 left-0 w-full z-[100] flex justify-between items-center p-8\" data-kid=\"7\">\n    <div class=\"brutal-panel bg-white p-2 rotate-[-2deg]\" data-kid=\"8\">\n      <span class=\"syne-extra text-2xl tracking-tighter\" data-kid=\"9\">ARYAN B.</span>\n    </div>\n    <div class=\"flex gap-8 bg-white border-4 border-black p-2 font-bold uppercase text-xs tracking-widest\" data-kid=\"10\">\n      <a href=\"#work\" class=\"hover:text-[var(--accent)] transition-colors\" data-kid=\"11\">Combat / Work</a>\n      <a href=\"#skills\" class=\"hover:text-[var(--accent)] transition-colors\" data-kid=\"12\">Arsenal</a>\n      <a href=\"#journey\" class=\"hover:text-[var(--accent)] transition-colors\" data-kid=\"13\">Chapters</a>\n      <a href=\"#contact\" class=\"hover:text-[var(--accent)] transition-colors\" data-kid=\"14\">Transmission</a>\n    </div>\n  </nav>\n\n  \n  <section class=\"section-hinge flex flex-col items-center justify-center pt-40 pb-20 px-12\" id=\"hero\" data-kid=\"15\">\n    <div class=\"grid grid-cols-12 gap-12 w-full max-w-7xl items-center relative\" data-kid=\"16\">\n      \n      <div class=\"col-span-12 text-center mb-20\" style=\"transform: translateZ(100px)\" data-kid=\"17\">\n        <h1 class=\"syne-extra text-[18vw] leading-none mb-4 mix-blend-difference\" data-kid=\"18\">\n          CRAFTED<br data-kid=\"19\">\n          <span class=\"blood-text\" data-kid=\"20\">TO KILL.</span>\n        </h1>\n        <p class=\"text-xl font-bold uppercase tracking-widest bg-black text-white inline-block px-4 py-2\" data-kid=\"21\">\n          High-Performance Frontend Architect / India\n        </p>\n      </div>\n\n      <div class=\"col-span-12 relative h-[500px]\" data-kid=\"22\">\n        <div class=\"scene-cube\" data-kid=\"23\">\n          <div class=\"cube\" id=\"project-cube\" data-kid=\"24\">\n            <div class=\"cube-face front\" data-kid=\"25\">\n              <img src=\"https://images.pexels.com/photos/12024938/pexels-photo-12024938.jpeg\" alt=\"Project 1\" data-kid=\"26\">\n              <h3 class=\"syne-extra text-3xl\" data-kid=\"27\">LINEA FLORA</h3>\n              <p class=\"text-[10px] uppercase font-bold\" data-kid=\"28\">Creative Builder</p>\n            </div>\n            <div class=\"cube-face back\" data-kid=\"29\">\n              <img src=\"https://images.pexels.com/photos/16254765/pexels-photo-16254765.jpeg\" alt=\"Project 2\" data-kid=\"30\">\n              <h3 class=\"syne-extra text-3xl\" data-kid=\"31\">ANISCOPE</h3>\n              <p class=\"text-[10px] uppercase font-bold\" data-kid=\"32\">Live Product</p>\n            </div>\n            <div class=\"cube-face right\" data-kid=\"33\">\n              <img src=\"https://images.pexels.com/photos/15846055/pexels-photo-15846055.jpeg\" alt=\"Project 3\" data-kid=\"34\">\n              <h3 class=\"syne-extra text-3xl\" data-kid=\"35\">GITHUB FINDER</h3>\n              <p class=\"text-[10px] uppercase font-bold\" data-kid=\"36\">Dev Tool</p>\n            </div>\n            <div class=\"cube-face left\" data-kid=\"37\">\n              <img src=\"https://images.pexels.com/photos/17211996/pexels-photo-17211996.jpeg\" alt=\"Project 4\" data-kid=\"38\">\n              <h3 class=\"syne-extra text-3xl\" data-kid=\"39\">GALLERY SENSES</h3>\n              <p class=\"text-[10px] uppercase font-bold\" data-kid=\"40\">Experiment</p>\n            </div>\n            <div class=\"cube-face top\" data-kid=\"41\">\n              <div class=\"bg-[var(--ink)] w-full h-full flex items-center justify-center\" data-kid=\"42\">\n                <h3 class=\"syne-extra text-4xl text-white\" data-kid=\"43\">PROJECTS</h3>\n              </div>\n            </div>\n            <div class=\"cube-face bottom\" data-kid=\"44\">\n              <div class=\"bg-[var(--accent)] w-full h-full flex items-center justify-center\" data-kid=\"45\">\n                <h3 class=\"syne-extra text-4xl text-white\" data-kid=\"46\">ARCHIVE</h3>\n              </div>\n            </div>\n          </div>\n        </div>\n        \n        <div class=\"absolute top-1/2 left-0 w-full h-[8px] bg-[var(--accent)] -translate-y-1/2 -rotate-[10deg] opacity-50 pointer-events-none\" data-kid=\"47\"></div>\n      </div>\n    </div>\n  </section>\n\n  \n  <div class=\"marquee-brutal\" data-kid=\"48\">\n    <div class=\"flex animate-[marquee_20s_linear_infinite] gap-12 items-center\" data-kid=\"49\">\n      <span class=\"syne-extra text-5xl\" data-kid=\"50\">REACT REDUX</span>\n      <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/darkzaitzev/shuriken.svg\" class=\"shuriken-icon\" data-kid=\"51\">\n      <span class=\"syne-extra text-5xl\" data-kid=\"52\">GSAP MOTION</span>\n      <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/darkzaitzev/shuriken.svg\" class=\"shuriken-icon\" data-kid=\"53\">\n      <span class=\"syne-extra text-5xl\" data-kid=\"54\">THREE.JS</span>\n      <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/darkzaitzev/shuriken.svg\" class=\"shuriken-icon\" data-kid=\"55\">\n      <span class=\"syne-extra text-5xl\" data-kid=\"56\">TAILWIND CSS</span>\n    </div>\n  </div>\n\n  \n  <section class=\"section-hinge py-32 px-12\" id=\"skills\" data-kid=\"57\">\n    <div class=\"max-w-7xl mx-auto\" data-kid=\"58\">\n      <div class=\"mb-20 flex items-baseline gap-8\" data-kid=\"59\">\n        <h2 class=\"syne-extra text-9xl\" data-kid=\"60\">ARSENAL</h2>\n        <span class=\"text-xs uppercase font-bold tracking-[0.4em] opacity-40\" data-kid=\"61\">Tactical skill set / 2024</span>\n      </div>\n\n      <div class=\"stat-grid\" data-kid=\"62\">\n        <div class=\"brutal-panel bg-white floating\" data-kid=\"63\">\n          <div class=\"flex justify-between items-start mb-12\" data-kid=\"64\">\n            <h3 class=\"syne-extra text-5xl\" data-kid=\"65\">FRONTEND</h3>\n            <span class=\"font-bold text-4xl blood-text\" data-kid=\"66\">99%</span>\n          </div>\n          <p class=\"text-sm border-t-2 border-black pt-4 mb-4\" data-kid=\"67\">Mastery over React, Next.js, and complex state management. Performance is not a feature, it's a requirement.</p>\n          <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/darkzaitzev/shuriken.svg\" class=\"absolute -bottom-4 -right-4 w-20 opacity-5\" data-kid=\"68\">\n        </div>\n\n        <div class=\"brutal-panel bg-white floating\" style=\"animation-delay: -1.5s\" data-kid=\"69\">\n          <div class=\"flex justify-between items-start mb-12\" data-kid=\"70\">\n            <h3 class=\"syne-extra text-5xl\" data-kid=\"71\">MOTION</h3>\n            <span class=\"font-bold text-4xl blood-text\" data-kid=\"72\">95%</span>\n          </div>\n          <p class=\"text-sm border-t-2 border-black pt-4 mb-4\" data-kid=\"73\">GSAP and Framer Motion are my primary weapons. Interfaces should feel alive, snappy, and intentional.</p>\n          <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/darkzaitzev/shuriken.svg\" class=\"absolute -bottom-4 -right-4 w-20 opacity-5\" data-kid=\"74\">\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"section-hinge py-32 px-12 bg-[var(--ink)] text-white\" id=\"console\" data-kid=\"75\">\n    <div class=\"max-w-7xl mx-auto grid grid-cols-12 gap-12 items-center\" data-kid=\"76\">\n      <div class=\"col-span-5\" data-kid=\"77\">\n        <h2 class=\"syne-extra text-8xl mb-8 leading-[0.7]\" data-kid=\"78\">SYSTEM<br data-kid=\"79\"><span class=\"blood-text\" data-kid=\"80\">PULSE</span></h2>\n        <p class=\"font-mono text-sm opacity-60\" data-kid=\"81\">Monitoring live development metrics and terminal throughput.</p>\n      </div>\n      <div class=\"col-span-7\" data-kid=\"82\">\n        <div class=\"brutal-panel bg-[#1a1a1a] border-white/20 p-8 shadow-[12px_12px_0px_#8b0000]\" data-kid=\"83\">\n          <div class=\"flex items-center gap-2 mb-6 text-xs text-[var(--accent)] font-bold\" data-kid=\"84\">\n            <div class=\"w-2 h-2 bg-[var(--accent)] rounded-full animate-pulse\" data-kid=\"85\"></div>\n            CONNECTING TO REPOSITORY...\n          </div>\n          <div class=\"space-y-4 font-mono text-sm leading-relaxed overflow-hidden\" data-kid=\"86\">\n            <div class=\"text-white\" data-kid=\"87\">> npm run optimize</div>\n            <div class=\"text-green-500\" data-kid=\"88\">[SUCCESS] Binary assets compressed to 12.4kb</div>\n            <div class=\"text-white\" data-kid=\"89\">> git push origin main</div>\n            <div class=\"text-white\" data-kid=\"90\">Enumerating objects: 42, done.</div>\n            <div class=\"text-[var(--accent)]\" data-kid=\"91\">>> STATUS: OVERDRIVE ENGAGED</div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  \n  <section class=\"section-hinge py-40 px-12 flex flex-col items-center justify-center bg-[var(--paper)]\" id=\"contact\" data-kid=\"92\">\n    <div class=\"brutal-panel bg-white max-w-4xl w-full rotate-1 flex flex-col gap-12 p-16\" style=\"transform: rotateX(20deg); transform-origin: bottom;\" id=\"contact-panel\" data-kid=\"93\">\n      <h2 class=\"syne-extra text-9xl text-center\" data-kid=\"94\">CONTACT</h2>\n      <form class=\"grid grid-cols-1 md:grid-cols-2 gap-12\" data-kid=\"95\">\n        <div class=\"flex flex-col gap-4\" data-kid=\"96\">\n          <label class=\"font-bold text-[10px] tracking-widest\" data-kid=\"97\">NAME_ENTRY</label>\n          <input type=\"text\" placeholder=\"WHO ARE YOU?\" class=\"border-b-4 border-black p-4 syne-extra text-2xl outline-none focus:border-[var(--accent)]\" data-kid=\"98\">\n        </div>\n        <div class=\"flex flex-col gap-4\" data-kid=\"99\">\n          <label class=\"font-bold text-[10px] tracking-widest\" data-kid=\"100\">EMAIL_ENTRY</label>\n          <input type=\"email\" placeholder=\"WHERE CAN I REACH YOU?\" class=\"border-b-4 border-black p-4 syne-extra text-2xl outline-none focus:border-[var(--accent)]\" data-kid=\"101\">\n        </div>\n        <div class=\"col-span-2 flex flex-col gap-4\" data-kid=\"102\">\n          <label class=\"font-bold text-[10px] tracking-widest\" data-kid=\"103\">MESSAGE_BODY</label>\n          <textarea placeholder=\"STATE YOUR PURPOSE.\" class=\"border-b-4 border-black p-4 syne-extra text-2xl outline-none h-32 focus:border-[var(--accent)]\" data-kid=\"104\"></textarea>\n        </div>\n        <button class=\"col-span-2 brutal-panel bg-[var(--ink)] text-white syne-extra text-5xl py-8 hover:bg-[var(--accent)] transition-all\" data-kid=\"105\">SEND TRANSMISSION</button>\n      </form>\n    </div>\n  </section>\n\n  <footer class=\"py-20 px-12 bg-black text-white flex flex-col items-center gap-12\" data-kid=\"106\">\n    <div class=\"syne-extra text-[15vw] opacity-5\" data-kid=\"107\">END CHAPTER</div>\n    <div class=\"flex gap-12 font-bold uppercase text-xl\" data-kid=\"108\">\n      <a href=\"#\" class=\"hover:text-[var(--accent)]\" data-kid=\"109\">Twitter</a>\n      <a href=\"#\" class=\"hover:text-[var(--accent)]\" data-kid=\"110\">Github</a>\n      <a href=\"#\" class=\"hover:text-[var(--accent)]\" data-kid=\"111\">LinkedIn</a>\n    </div>\n    <div class=\"w-full flex justify-between items-center text-[10px] opacity-30 tracking-widest\" data-kid=\"112\">\n      <span data-kid=\"113\">© 2024 ARYAN BARBATE</span>\n      <span data-kid=\"114\">BRUTALIST EDITION 02</span>\n    </div>\n  </footer>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"115\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"116\"></script>\n<script data-kid=\"117\">\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Loader animation\n  const tl = gsap.timeline();\n  tl.to(\"#loader-bar\", { width: \"100%\", duration: 1.5, ease: \"power4.inOut\" })\n    .to(\"#ink-loader\", { clipPath: \"circle(0% at 50% 50%)\", duration: 1, ease: \"power4.inOut\" })\n    .from(\"#hero h1\", { y: 100, opacity: 0, duration: 1, ease: \"power4.out\" }, \"-=0.5\");\n\n  // Rotating Cube Logic\n  gsap.to(\"#project-cube\", {\n    rotateY: 360,\n    rotateX: 360,\n    duration: 30,\n    repeat: -1,\n    ease: \"none\"\n  });\n\n  // Section Hinge Up Animation\n  gsap.utils.toArray('.section-hinge').forEach(section => {\n    gsap.from(section, {\n      scrollTrigger: {\n        trigger: section,\n        start: \"top bottom\",\n        end: \"top center\",\n        scrub: 1\n      },\n      rotateX: 60,\n      transformOrigin: \"top\"\n    });\n  });\n\n  // Contact Panel Pop-up\n  gsap.to(\"#contact-panel\", {\n    scrollTrigger: {\n      trigger: \"#contact\",\n      start: \"top 80%\",\n      end: \"top 20%\",\n      scrub: 1\n    },\n    rotateX: 0,\n    y: -50\n  });\n\n  // Mouse Move Parallax for Cube Scene\n  window.addEventListener('mousemove', (e) => {\n    const x = (e.clientX / window.innerWidth - 0.5) * 30;\n    const y = (e.clientY / window.innerHeight - 0.5) * 30;\n    gsap.to(\".scene-cube\", { rotationY: x, rotationX: -y, duration: 1 });\n  });\n\n</script>",
