    },
    "var_0592a1c65663": {
      "type": "variant",
      "label": "Kinetic Hybrid - Architectural",
      "parentId": "var_b147d8870838",
      "themeId": null,
      "rect": {
        "x": 13860,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800;900&family=Work+Sans:wght@300;400;500;600&family=Space+Mono:wght@400;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n\n  :root {\n    --paper: #f4f0e8;\n    --ink: #000000;\n    --cobalt: #002387;\n    --vermillion: #e85d04;\n    --font-header: 'Big Shoulders Display', sans-serif;\n    --font-body: 'Work Sans', sans-serif;\n    --font-mono: 'Space Mono', monospace;\n    --border-thick: 3px solid var(--ink);\n    --shadow-pop: 8px 8px 0px var(--ink);\n    --ease-snap: cubic-bezier(0.34, 1.56, 0.64, 1);\n  }\n\n  body {\n    background-color: var(--paper);\n    color: var(--ink);\n    font-family: var(--font-body);\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .manga-panel {\n    border: var(--border-thick);\n    background: white;\n    position: relative;\n    transition: transform 0.3s var(--ease-snap), box-shadow 0.3s var(--ease-snap);\n  }\n\n  .manga-panel:hover {\n    transform: translate(-4px, -4px);\n    box-shadow: 12px 12px 0px var(--ink);\n  }\n\n  .big-header {\n    font-family: var(--font-header);\n    text-transform: uppercase;\n    line-height: 0.8;\n    letter-spacing: -0.02em;\n  }\n\n  .italic-heavy {\n    font-style: italic;\n    font-weight: 900;\n  }\n\n  .halftone-bg {\n    background-image: radial-gradient(var(--ink) 1.5px, transparent 0);\n    background-size: 10px 10px;\n    opacity: 0.05;\n  }\n\n  /* Loader Styles */\n  #loader {\n    position: fixed;\n    inset: 0;\n    background: var(--paper);\n    z-index: 9999;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    align-items: center;\n    overflow: hidden;\n  }\n\n  .loader-blueprint {\n    width: 300px;\n    height: 450px;\n    border: 1px solid var(--cobalt);\n    position: relative;\n    opacity: 0.3;\n  }\n\n  .loader-blueprint::before {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background-image: linear-gradient(var(--cobalt) 1px, transparent 1px), linear-gradient(90deg, var(--cobalt) 1px, transparent 1px);\n    background-size: 20px 20px;\n  }\n\n  .scan-line {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 4px;\n    background: var(--vermillion);\n    box-shadow: 0 0 15px var(--vermillion);\n    z-index: 2;\n  }\n\n  .loader-text {\n    font-family: var(--font-mono);\n    font-size: 0.75rem;\n    margin-top: 2rem;\n    letter-spacing: 0.3em;\n    color: var(--cobalt);\n  }\n\n  /* Grain overlay */\n  .grain-overlay {\n    position: fixed;\n    inset: 0;\n    background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E\");\n    opacity: 0.04;\n    pointer-events: none;\n    z-index: 1000;\n  }\n\n  /* Action Lines */\n  .action-lines {\n    position: absolute;\n    inset: 0;\n    background-image: url(\"data:image/svg+xml,%3Csvg width='100' height='2' viewBox='0 0 100 2' xmlns='http://www.w3.org/2000/svg'%3E%3Cline x1='0' y1='1' x2='40' y2='1' stroke='black' stroke-opacity='0.1' /%3E%3C/svg%3E\");\n    background-repeat: repeat;\n    pointer-events: none;\n    z-index: 0;\n  }\n\n  .work-skew-panel {\n    transform: skewY(12deg);\n    transition: transform 0.5s var(--ease-snap), z-index 0s;\n  }\n\n  .work-skew-panel:hover {\n    transform: skewY(0deg) scale(1.02);\n    z-index: 50;\n  }\n\n  .speed-line-hover::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background: repeating-linear-gradient(90deg, transparent, transparent 10px, var(--vermillion) 10px, var(--vermillion) 12px);\n    opacity: 0;\n    transition: opacity 0.2s;\n    pointer-events: none;\n    z-index: -1;\n  }\n\n  .speed-line-hover:hover::after {\n    opacity: 0.15;\n  }\n\n  .diagonal-bg {\n    position: absolute;\n    top: 0;\n    right: 0;\n    width: 50%;\n    height: 100%;\n    background: var(--cobalt);\n    clip-path: polygon(20% 0, 100% 0, 100% 100%, 0% 100%);\n    z-index: -1;\n  }\n\n  .status-badge {\n    padding: 2px 8px;\n    background: var(--ink);\n    color: white;\n    font-family: var(--font-mono);\n    font-size: 0.6rem;\n    text-transform: uppercase;\n  }\n\n  /* Animation helpers */\n  .reveal-panel { opacity: 0; transform: translateY(30px); }\n</style>\n\n\n<div id=\"loader\" data-kid=\"1\">\n  <div class=\"loader-blueprint\" data-kid=\"2\">\n    <div class=\"scan-line\" data-kid=\"3\"></div>\n    \n    <svg viewBox=\"0 0 100 150\" class=\"absolute inset-0 w-full h-full opacity-40\" data-kid=\"4\">\n      <path d=\"M20,40 Q50,10 80,40 L80,100 Q50,130 20,100 Z\" fill=\"none\" stroke=\"var(--cobalt)\" stroke-width=\"0.5\" data-kid=\"5\"></path>\n      <path d=\"M35,60 L45,60 M55,60 L65,60 M40,85 Q50,95 60,85\" fill=\"none\" stroke=\"var(--cobalt)\" stroke-width=\"0.5\" data-kid=\"6\"></path>\n    </svg>\n  </div>\n  <div class=\"loader-text\" data-kid=\"7\">INITIALIZING_BLUEPRINT_ARCHIVE</div>\n  <div class=\"w-48 h-1 bg-gray-200 mt-4 overflow-hidden\" data-kid=\"8\">\n    <div class=\"loader-progress h-full bg-[var(--vermillion)] w-0\" data-kid=\"9\"></div>\n  </div>\n</div>\n\n<div class=\"grain-overlay\" data-kid=\"10\"></div>\n\n\n<nav class=\"fixed top-0 left-0 w-full z-[100] flex justify-between items-center px-12 py-8 mix-blend-difference\" data-kid=\"11\">\n  <div class=\"manga-panel px-5 py-1 bg-white rotate-[-1deg]\" data-kid=\"12\">\n    <span class=\"font-black text-2xl uppercase tracking-tighter\" data-kid=\"13\">AB / ARCHITECT</span>\n  </div>\n  <div class=\"flex gap-10 font-black uppercase text-white tracking-widest text-xs\" data-kid=\"14\">\n    <a href=\"#work\" class=\"hover:text-[var(--vermillion)] transition-all hover:skew-x-[-10deg]\" data-kid=\"15\">Work</a>\n    <a href=\"#journey\" class=\"hover:text-[var(--vermillion)] transition-all hover:skew-x-[-10deg]\" data-kid=\"16\">Journey</a>\n    <a href=\"#capabilities\" class=\"hover:text-[var(--vermillion)] transition-all hover:skew-x-[-10deg]\" data-kid=\"17\">Arsenal</a>\n    <a href=\"#writing\" class=\"hover:text-[var(--vermillion)] transition-all hover:skew-x-[-10deg]\" data-kid=\"18\">Journal</a>\n    <button class=\"status-badge hover:bg-[var(--vermillion)] transition-colors\" data-kid=\"19\">Let's Talk</button>\n  </div>\n</nav>\n\n<main class=\"opacity-0 translate-y-10\" id=\"main-content\" data-kid=\"20\">\n  \n  <section class=\"min-h-screen relative overflow-hidden flex items-center px-12\" data-kid=\"21\">\n    <div class=\"diagonal-bg\" data-kid=\"22\"></div>\n    <div class=\"absolute inset-0 halftone-bg pointer-events-none\" data-kid=\"23\"></div>\n    <div class=\"absolute top-1/4 right-20 w-1/3 aspect-square border-[8px] border-white/10 rotate-12 z-[-1]\" data-kid=\"24\"></div>\n    \n    <div class=\"grid grid-cols-12 gap-8 w-full\" data-kid=\"25\">\n      <div class=\"col-span-8\" data-kid=\"26\">\n        <div class=\"manga-panel p-12 bg-white relative z-10\" data-kid=\"27\">\n          <div class=\"flex items-center gap-3 mb-6\" data-kid=\"28\">\n            <div class=\"w-12 h-0.5 bg-black\" data-kid=\"29\"></div>\n            <span class=\"font-mono text-xs uppercase tracking-widest font-bold\" data-kid=\"30\">SYSTEM_V2.0 / ACTIVE</span>\n          </div>\n          <h1 class=\"big-header text-[14vw] leading-[0.75] mb-8\" data-kid=\"31\">\n            ARYAN<br data-kid=\"32\">\n            <span class=\"text-[var(--vermillion)] italic-heavy\" data-kid=\"33\">BARBATE</span>\n          </h1>\n          <p class=\"max-w-xl text-2xl font-bold leading-tight uppercase tracking-tight\" data-kid=\"34\">\n            Architecting high-fidelity interfaces with a high-contrast editorial soul. Bridging the gap between