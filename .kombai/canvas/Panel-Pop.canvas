  "nodes": {
    "node_paste_cec23cb8f7ce": {
      "type": "variant",
      "id": "node_paste_cec23cb8f7ce",
      "label": "Panel Pop",
      "html": "<style>\n    :root {\n      --bone: #F2EBDC;\n      --bone2: #E4D9C0;\n      --ink: #16131A;\n      --cobalt: #1B43D8;\n      --vermillion: #F23C18;\n      --cobalt-deep: #0E2A8C;\n      --scroll: 0;\n      --disp: 'Big Shoulders Display', sans-serif;\n      --sub: 'Archivo Black', sans-serif;\n      --body: 'Archivo', sans-serif;\n      --ui: 'Darker Grotesque', sans-serif;\n      --ease: cubic-bezier(.2, .8, .2, 1);\n    }\n\n    * {\n      margin: 0;\n      padding: 0;\n      box-sizing: border-box\n    }\n\n    html {\n      scroll-behavior: smooth\n    }\n\n    body {\n      background: var(--bone);\n      color: var(--ink);\n      font-family: var(--body);\n      line-height: 1.55;\n      -webkit-font-smoothing: antialiased;\n      overflow-x: hidden\n    }\n\n    img {\n      display: block;\n      max-width: 100%\n    }\n\n    a {\n      color: inherit;\n      text-decoration: none;\n      cursor: pointer\n    }\n\n    button,\n    input {\n      font-family: inherit;\n      cursor: pointer\n    }\n\n    :focus-visible {\n      outline: 3px solid var(--vermillion);\n      outline-offset: 2px\n    }\n\n    /* ---- textures ---- */\n    .halftone-cobalt {\n      background-color: var(--cobalt);\n      background-image: radial-gradient(rgba(0, 0, 0, .32) 1.5px, transparent 1.6px);\n      background-size: 13px 13px\n    }\n\n    .halftone-verm {\n      background-color: var(--vermillion);\n      background-image: radial-gradient(rgba(0, 0, 0, .28) 1.5px, transparent 1.6px);\n      background-size: 13px 13px\n    }\n\n    .halftone-bone {\n      background-color: var(--bone);\n      background-image: radial-gradient(rgba(22, 19, 26, .13) 1.3px, transparent 1.4px);\n      background-size: 14px 14px\n    }\n\n    .halftone-deep {\n      background-color: var(--cobalt-deep);\n      background-image: radial-gradient(rgba(242, 235, 220, .18) 1.3px, transparent 1.5px);\n      background-size: 16px 16px\n    }\n\n    .crosshatch {\n      background-image: repeating-linear-gradient(45deg, rgba(22, 19, 26, .06), rgba(22, 19, 26, .06) 1px, transparent 1px, transparent 9px), repeating-linear-gradient(-45deg, rgba(22, 19, 26, .06), rgba(22, 19, 26, .06) 1px, transparent 1px, transparent 9px)\n    }\n\n    /* ---- chips / ui ---- */\n    .eyebrow {\n      font-family: var(--ui);\n      font-weight: 800;\n      text-transform: uppercase;\n      letter-spacing: .18em;\n      font-size: .92rem;\n      line-height: 1\n    }\n\n    .tag {\n      display: inline-block;\n      font-family: var(--ui);\n      font-weight: 800;\n      text-transform: uppercase;\n      letter-spacing: .14em;\n      font-size: .82rem;\n      background: var(--ink);\n      color: var(--bone);\n      padding: .18rem .55rem;\n      line-height: 1.2\n    }\n\n    .bubble {\n      display: inline-flex;\n      align-items: center;\n      gap: .4rem;\n      font-family: var(--ui);\n      font-weight: 800;\n      text-transform: uppercase;\n      letter-spacing: .1em;\n      background: var(--bone);\n      border: 3px solid var(--ink);\n      padding: .32rem .8rem;\n      line-height: 1\n    }\n\n    .bubble.verm {\n      background: var(--vermillion);\n      color: var(--bone);\n      border-color: var(--ink)\n    }\n\n    .bubble.cobalt {\n      background: var(--cobalt);\n      color: var(--bone);\n      border-color: var(--ink)\n    }\n\n    .btn {\n      display: inline-flex;\n      align-items: center;\n      gap: .45rem;\n      font-family: var(--ui);\n      font-weight: 800;\n      text-transform: uppercase;\n      letter-spacing: .08em;\n      font-size: .95rem;\n      padding: .5rem 1rem;\n      border: 3px solid var(--ink);\n      background: var(--bone);\n      color: var(--ink);\n      box-shadow: 4px 4px 0 var(--ink);\n      transition: transform .15s var(--ease), box-shadow .15s var(--ease)\n    }\n\n    .btn:hover {\n      transform: translate(-1px, -1px);\n      box-shadow: 6px 6px 0 var(--ink)\n    }\n\n    .btn:active {\n      transform: translate(2px, 2px);\n      box-shadow: 2px 2px 0 var(--ink)\n    }\n\n    .btn.verm {\n      background: var(--vermillion);\n      color: var(--bone)\n    }\n\n    .btn.cobalt {\n      background: var(--cobalt);\n      color: var(--bone)\n    }\n\n    .btn.sm {\n      font-size: .82rem;\n      padding: .35rem .7rem;\n      box-shadow: 3px 3px 0 var(--ink)\n    }\n\n    .wrap {\n      max-width: 1400px;\n      margin: 0 auto;\n      padding: 0 24px\n    }\n\n    /* misprint heading: ink layer + cobalt/vermillion ghosts */\n    .misprint {\n      position: relative;\n      font-family: var(--disp);\n      font-weight: 900;\n      text-transform: uppercase;\n      line-height: .82;\n      color: var(--ink)\n    }\n\n    .misprint .ghost {\n      position: absolute;\n      inset: 0;\n      pointer-events: none;\n      mix-blend-mode: multiply\n    }\n\n    .misprint .ghost.c {\n      color: var(--cobalt);\n      transform: translate(3px, 3px);\n      z-index: -1\n    }\n\n    .misprint .ghost.v {\n      color: var(--vermillion);\n      transform: translate(-3px, -2px);\n      z-index: -2\n    }\n\n    /* ---- entrances ---- */\n    .reveal {\n      opacity: 0;\n      transform: translateY(28px);\n      transition: opacity .7s var(--ease), transform .7s var(--ease)\n    }\n\n    .reveal.in {\n      opacity: 1;\n      transform: none\n    }\n\n    .clipline {\n      clip-path: inset(0 100% 0 0);\n      transition: clip-path .9s var(--ease)\n    }\n\n    .clipline.in {\n      clip-path: inset(0 0 0 0)\n    }\n\n    .skewset {\n      opacity: 0;\n      transform: translateY(40px) skewY(7deg);\n      transition: opacity .8s var(--ease), transform .8s var(--ease)\n    }\n\n    .skewset.in {\n      opacity: 1;\n      transform: none\n    }\n\n    .windup {\n      letter-spacing: .34em;\n      opacity: .35;\n      transition: letter-spacing .9s var(--ease), opacity .9s var(--ease)\n    }\n\n    .windup.in {\n      letter-spacing: .01em;\n      opacity: 1\n    }\n\n    .blursharp {\n      filter: blur(16px);\n      opacity: 0;\n      transition: filter .8s var(--ease), opacity .8s var(--ease)\n    }\n\n    .blursharp.in {\n      filter: blur(0);\n      opacity: 1\n    }\n\n    .word {\n      display: inline-block;\n      margin-right: .28em;\n      opacity: 0;\n      transform: translateY(.7em);\n      transition: opacity .55s var(--ease), transform .55s var(--ease);\n      transition-delay: calc(var(--i) * 60ms)\n    }\n\n    .word.in {\n      opacity: 1;\n      transform: none\n    }\n\n    /* ============ NAV ============ */\n    header.bar {\n      position: sticky;\n      top: 0;\n      z-index: 60;\n      background: var(--bone);\n      border-bottom: 3px solid var(--ink)\n    }\n\n    .bar .row {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 16px;\n      padding: 10px 24px;\n      max-width: 1400px;\n      margin: 0 auto\n    }\n\n    .brand {\n      display: flex;\n      align-items: center;\n      gap: 12px\n    }\n\n    .mark {\n      width: 44px;\n      height: 44px;\n      display: grid;\n      place-items: center;\n      background: var(--vermillion);\n      color: var(--bone);\n      border: 3px solid var(--ink);\n      box-shadow: 3px 3px 0 var(--ink);\n      transform: rotate(-4deg);\n      font-family: var(--disp);\n      font-weight: 900;\n      font-size: 1.5rem\n    }\n\n    .brand .name {\n      font-family: var(--disp);\n      font-weight: 900;\n      font-size: 1.9rem;\n      line-height: .85;\n      text-transform: uppercase\n    }\n\n    .brand .sub {\n      font-family: var(--ui);\n      font-weight: 700;\n      text-transform: uppercase;\n      letter-spacing: .22em;\n      font-size: .7rem;\n      opacity: .7\n    }\n\n    nav.main {\n      display: flex;\n      gap: 22px;\n      font-family: var(--ui);\n      font-weight: 800;\n      text-transform: uppercase;\n      letter-spacing: .08em;\n      font-size: 1.05rem\n    }\n\n    nav.main a {\n      padding-bottom: 2px\n    }\n\n    nav.main a.active {\n      border-bottom: 3px solid var(--vermillion)\n    }\n\n    nav.main a:not(.active) {\n      opacity: .7\n    }\n\n    nav.main a:not(.active):hover {\n      opacity: 1\n    }\n\n    .bar .tools {\n      display: flex;\n      align-items: center;\n      gap: 10px\n    }\n\n    .search {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      border: 3px solid var(--ink);\n      background: var(--bone);\n      padding: .35rem .6rem;\n      box-shadow: 3px 3px 0 var(--ink)\n    }\n\n    .search input {\n      background: transparent;\n      border: none;\n      outline: none;\n      font-size: .85rem;\n      width: 160px\n    }\n\n    .search input::placeholder {\n      color: rgba(22, 19, 26, .5)\n    }\n\n    .avatar {\n      width: 44px;\n      height: 44px;\n      border: 3px solid var(--ink);\n      overflow: hidden;\n      box-shadow: 3px 3px 0 var(--ink);\n      background: var(--cobalt);\n      border-radius: 50%\n    }\n\n    .avatar img {\n      width: 100%;\n      height: 100%;\n      object-fit: cover\n    }\n\n    /* ============ HERO ============ */\n    .hero {\n      position: relative;\n      border-bottom: 3px solid var(--ink);\n      overflow: hidden;\n      background: var(--bone)\n    }\n\n    .film {\n      height: 16px;\n      background: repeating-linear-gradient(90deg, var(--ink), var(--ink) 14px, var(--cobalt) 14px, var(--cobalt) 22px, var(--ink) 22px, var(--ink) 36px, var(--vermillion) 36px, var(--vermillion) 44px)\n    }\n\n    .hero-inner {\n      position: relative;\n      display: grid;\n      grid-template-columns: minmax(320px, 0.95fr) 1.25fr;\n      gap: 40px;\n      align-items: center;\n      padding: 40px 24px 34px;\n      max-width: 1400px;\n      margin: 0 auto\n    }\n\n    .hero-text {\n      position: relative;\n      z-index: 5;\n      align-self: center\n    }\n\n    .starburst {\n      position: relative;\n      display: inline-block;\n      background: var(--vermillion);\n      color: var(--bone);\n      font-family: var(--ui);\n      font-weight: 900;\n      text-transform: uppercase;\n      letter-spacing: .1em;\n      padding: .5rem 1.1rem;\n      border: 3px solid var(--ink);\n      box-shadow: 4px 4px 0 var(--ink);\n      transform: rotate(-3deg);\n      margin-bottom: 22px\n    }\n\n    .starburst::before,\n    .starburst::after {\n      content: \"\";\n      position: absolute;\n      background: var(--vermillion);\n      border: 3px solid var(--ink);\n      width: 18px;\n      height: 18px\n    }\n\n    .starburst::before {\n      top: -9px;\n      right: 18px;\n      transform: rotate(20deg);\n      z-index: -1\n    }\n\n    .starburst::after {\n      bottom: -9px;\n      left: 22px;\n      transform: rotate(15deg);\n      z-index: -1\n    }\n\n    .stack {\n      margin: 0\n    }\n\n    .stack .ln {\n      display: block;\n      font-family: var(--disp);\n      font-weight: 900;\n      text-transform: uppercase;\n      line-height: .8;\n      font-size: clamp(3rem, 9vw, 7.2rem);\n      position: relative\n    }\n\n    .stack .ln:nth-child(1) {\n      margin-left: 0\n    }\n\n    .stack .ln:nth-child(2) {\n      margin-left: .9ch;\n      color: var(--cobalt)\n    }\n\n    .stack .ln:nth-child(3) {\n      margin-left: 1.9ch\n    }\n\n    .stack .ln .gc,\n    .stack .ln .gv {\n      position: absolute;\n      left: 0;\n      top: 0;\n      pointer-events: none;\n      mix-blend-mode: multiply\n    }\n\n    .stack .ln .gc {\n      color: var(--cobalt);\n      transform: translate(4px, 4px);\n      z-index: -1\n    }\n\n    .stack .ln .gv {\n      color: var(--vermillion);\n      transform: translate(-4px, -3px);\n      z-index: -2\n    }\n\n    .stack .ln:nth-child(2) .gc {\n      color: var(--cobalt-deep)\n    }\n\n    .read-dir {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      margin-top: 18px;\n      font-family: var(--ui);\n      font-weight: 800;\n      letter-spacing: .2em;\n      font-size: 1rem\n    }\n\n    /* mosaic */\n    .mosaic {\n      display: grid;\n      grid-template-columns: repeat(6, 1fr);\n      gap: 8px;\n      position: relative\n    }\n\n    .tile {\n      position: relative;\n      aspect-ratio: 3/4;\n      border: 3px solid var(--ink);\n      overflow: hidden;\n      background: var(--cobalt);\n      box-shadow: 3px 3px 0 var(--ink);\n      transform: translate3d(var(--dx), var(--dy), 0) rotate(var(--r));\n      opacity: 0;\n      transition: transform .9s var(--ease), opacity .6s var(--ease);\n      transition-delay: calc(var(--i) * 38ms);\n      will-change: transform\n    }\n\n    .mosaic.in .tile {\n      transform: translate3d(var(--px, 0), var(--py, 0), 0) rotate(0);\n      opacity: 1\n    }\n\n    .tile img {\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      filter: grayscale(.15) contrast(1.05)\n    }\n\n    .tile::after {\n      content: \"\";\n      position: absolute;\n      inset: 0;\n      background-image: radial-gradient(rgba(27, 67, 216, .0) 1px, transparent 1.4px);\n      background-size: 6px 6px;\n      mix-blend-mode: multiply;\n      pointer-events: none\n    }\n\n    .mosaic:hover .tile {\n      opacity: .5\n    }\n\n    .mosaic .tile:hover {\n      opacity: 1;\n      transform: scale(1.06) rotate(-1deg);\n      z-index: 3;\n      box-shadow: 6px 6px 0 var(--vermillion)\n    }\n\n    /* volume rail */\n    .rail-band {\n      border-top: 3px solid var(--ink);\n      background: var(--cobalt-deep);\n      overflow: hidden;\n      padding: 18px 0\n    }\n\n    .rail {\n      display: flex;\n      gap: 18px;\n      width: max-content;\n      will-change: transform\n    }\n\n    .vcard {\n      position: relative;\n      width: 230px;\n      flex: 0 0 auto;\n      background: var(--bone);\n      border: 3px solid var(--ink);\n      box-shadow: 5px 5px 0 var(--vermillion)\n    }\n\n    .vcard .cov {\n      position: relative;\n      aspect-ratio: 3/4;\n      border-bottom: 3px solid var(--ink);\n      overflow: hidden;\n      background: var(--cobalt)\n    }\n\n    .vcard .cov img {\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      filter: grayscale(.2) contrast(1.1)\n    }\n\n    .vcard .cap {\n      padding: .6rem .7rem\n    }\n\n    .vcard .cap .t {\n      font-family: var(--sub);\n      font-size: 1.35rem;\n      line-height: .95;\n      text-transform: uppercase\n    }\n\n    .vcard .cap .a {\n      font-family: var(--ui);\n      font-weight: 700;\n      font-size: .95rem;\n      letter-spacing: .04em;\n      opacity: .7;\n      margin-top: 2px\n    }\n\n    .vcard .ch {\n      position: absolute;\n      top: 10px;\n      left: 10px\n    }\n\n    .vcard .gn {\n      position: absolute;\n      bottom: 10px;\n      left: 10px;\n      font-size: .72rem;\n      padding: .2rem .5rem\n    }\n\n    .vcard .pop {\n      position: absolute;\n      top: 10px;\n      right: 10px;\n      background: var(--vermillion);\n      color: var(--bone);\n      border: 3px solid var(--ink);\n      font-family: var(--ui);\n      font-weight: 900;\n      letter-spacing: .06em;\n      padding: .25rem .55rem;\n      font-size: .82rem;\n      box-shadow: 3px 3px 0 var(--ink);\n      opacity: 0;\n      transform: scale(.5) rotate(-12deg);\n      transform-origin: top right;\n      transition: transform .35s var(--ease), opacity .35s var(--ease)\n    }\n\n    .vcard:hover .pop {\n      opacity: 1;\n      transform: scale(1) rotate(-4deg)\n    }\n\n    /* ============ CONTINUE READING ============ */\n    .cr {\n      border-bottom: 3px solid var(--ink);\n      background: var(--bone)\n    }\n\n    .cr .grid {\n      display: grid;\n      grid-template-columns: minmax(240px, 4fr) 8fr;\n      gap: 40px;\n      padding: 64px 24px;\n      max-width: 1400px;\n      margin: 0 auto\n    }\n\n    .cr .left {\n      position: sticky;\n      top: 90px;\n      align-self: start\n    }\n\n    .cr .head-chip {\n      display: inline-block;\n      background: var(--vermillion);\n      color: var(--bone);\n      border: 3px solid var(--ink);\n      box-shadow: 5px 5px 0 var(--ink);\n      padding: .4rem .8rem;\n      transform: rotate(-2deg)\n    }\n\n    .cr .head-chip span {\n      font-family: var(--disp);\n      font-weight: 900;\n      font-size: 1.7rem;\n      text-transform: uppercase;\n      letter-spacing: .02em\n    }\n\n    .cr .count {\n      font-family: var(--ui);\n      font-weight: 900;\n      font-size: clamp(6rem, 13vw, 10rem);\n      line-height: .8;\n      color: var(--cobalt);\n      margin-top: 26px\n    }\n\n    .cr .count .pct {\n      font-size: .45em;\n      vertical-align: super\n    }\n\n    .cr .count-lbl {\n      font-family: var(--ui);\n      font-weight: 800;\n      text-transform: uppercase;\n      letter-spacing: .18em;\n      font-size: 1rem;\n      opacity: .7;\n      margin-top: 4px\n    }\n\n    .cr .viewall {\n      margin-top: 24px;\n      display: inline-flex;\n      align-items: center;\n      gap: 6px;\n      font-family: var(--ui);\n      font-weight: 800;\n      text-transform: uppercase;\n      letter-spacing: .1em\n    }\n\n    .cr .cards {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 20px\n    }\n\n    .crcard {\n      display: flex;\n      border: 3px solid var(--ink);\n      background: var(--bone);\n      box-shadow: 5px 5px 0 var(--cobalt)\n    }\n\n    .crcard .cov {\n      width: 118px;\n      flex: 0 0 auto;\n      border-right: 3px solid var(--ink);\n      position: relative;\n      background: var(--cobalt);\n      overflow: hidden\n    }\n\n    .crcard .cov img {\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      filter: grayscale(.2) contrast(1.1)\n    }\n\n    .crcard .cov .v {\n      position: absolute;\n      top: 8px;\n      left: 8px;\n      font-size: .72rem\n    }\n\n    .crcard .meta {\n      flex: 1;\n      padding: 14px 16px;\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      min-width: 0\n    }\n\n    .crcard .chap {\n      font-family: var(--ui);\n      font-weight: 800;\n      text-transform: uppercase;\n      letter-spacing: .12em;\n      font-size: .8rem;\n      opacity: .7\n    }\n\n    .crcard .ttl {\n      font-family: var(--sub);\n      font-size: 1.5rem;\n      line-height: .95;\n      text-transform: uppercase;\n      margin-top: 3px\n    }\n\n    .crcard .sub {\n      font-size: .85rem;\n      margin-top: 3px\n    }\n\n    .bar-row {\n      display: flex;\n      justify-content: space-between;\n      font-family: var(--ui);\n      font-weight: 800;\n      font-size: .9rem;\n      margin-bottom: 5px\n    }\n\n    .track {\n      height: 14px;\n      border: 2px solid var(--ink);\n      background: var(--ink);\n      overflow: hidden\n    }\n\n    .fill {\n      height: 100%;\n      background: var(--cobalt);\n      border-right: 2px solid var(--ink);\n      transform: scaleX(0);\n      transform-origin: left;\n      transition: transform 1s var(--ease)\n    }\n\n    .fill.in {\n      transform: scaleX(var(--p))\n    }\n\n    .crcard .acts {\n      display: flex;\n      gap: 8px;\n      margin-top: 12px\n    }\n\n    /* ============ SIX FLAVORS BENTO ============ */\n    .flavors {\n      border-bottom: 3px solid var(--ink)\n    }\n\n    .flavors .top {\n      display: flex;\n      align-items: flex-end;\n      justify-content: space-between;\n      gap: 28px;\n      padding: 64px 24px 30px;\n      max-width: 1400px;\n      margin: 0 auto\n    }\n\n    .flavors h2 {\n      font-size: clamp(2.6rem, 6vw, 5rem)\n    }\n\n    .flavors .top p {\n      max-width: 330px;\n      font-size: .95rem\n    }\n\n    .bento {\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      grid-auto-rows: 185px;\n      gap: 14px;\n      padding: 0 24px 64px;\n      max-width: 1400px;\n      margin: 0 auto\n    }\n\n    .gtile {\n      position: relative;\n      border: 3px solid var(--ink);\n      box-shadow: 6px 6px 0 var(--ink);\n      overflow: hidden;\n      display: flex;\n      flex-direction: column;\n      justify-content: flex-end;\n      padding: 20px;\n      transition: transform .35s var(--ease), box-shadow .35s var(--ease), opacity .35s var(--ease)\n    }\n\n    .gtile.big {\n      grid-column: span 2;\n      grid-row: span 2\n    }\n\n    .gtile.tall {\n      grid-row: span 2\n    }\n\n    .gtile.wide {\n      grid-column: span 2\n    }\n\n    .gtile img {\n      position: absolute;\n      top: 0;\n      right: 0;\n      width: 46%;\n      height: auto;\n      border-left: 3px solid var(--ink);\n      border-bottom: 3px solid var(--ink);\n      object-fit: cover;\n      filter: grayscale(.2) contrast(1.1);\n      transition: transform .4s var(--ease)\n    }\n\n    .gtile.big img {\n      width: 55%\n    }\n\n    .gtile .gtag {\n      position: relative;\n      z-index: 2;\n      width: fit-content\n    }\n\n    .gtile .gttl {\n      position: relative;\n      z-index: 2;\n      font-family: var(--disp);\n      font-weight: 900;\n      text-transform: uppercase;\n      line-height: .82;\n      font-size: clamp(2rem, 3.3vw, 3.4rem);\n      margin-top: 8px\n    }\n\n    .gtile.big .gttl {\n      font-size: clamp(2.8rem, 5vw, 5rem)\n    }\n\n    .gtile .arrow {\n      position: absolute;\n      right: 16px;\n      bottom: 16px;\n      width: 46px;\n      height: 46px;\n      border-radius: 50%;\n      background: var(--ink);\n      color: var(--vermillion);\n      display: grid;\n      place-items: center;\n      font-size: 1.4rem;\n      transform: translate(70px, 70px);\n      transition: transform .45s var(--ease);\n      z-index: 3\n    }\n\n    .bento:hover .gtile {\n      opacity: .55;\n      transform: scale(.99)\n    }\n\n    .bento .gtile:hover {\n      opacity: 1;\n      transform: scale(1.04);\n      z-index: 5;\n      box-shadow: 9px 9px 0 var(--vermillion)\n    }\n\n    .bento .gtile:hover img {\n      transform: translate(6px, -4px)\n    }\n\n    .bento .gtile:hover .arrow {\n      transform: translate(0, 0)\n    }\n\n    .gtile.c-cob {\n      color: var(--bone)\n    }\n\n    .gtile.c-cob .gtag {\n      background: var(--bone);\n      color: var(--ink)\n    }\n\n    .gtile.c-verm {\n      color: var(--bone)\n    }\n\n    .gtile.c-verm .gtag {\n      background: var(--bone);\n      color: var(--ink)\n    }\n\n    .gtile.c-ink {\n      color: var(--bone)\n    }\n\n    .gtile.c-ink .arrow {\n      background: var(--vermillion);\n      color: var(--bone)\n    }\n\n    .gtile.c-deep {\n      color: var(--bone)\n    }\n\n    /* ============ THE SHELF ============ */\n    .shelf {\n      position: relative;\n      border-bottom: 3px solid var(--ink);\n      background: var(--cobalt-deep);\n      color: var(--bone);\n      overflow: hidden\n    }\n\n    .shelf .grid {\n      display: grid;\n      grid-template-columns: minmax(260px, 4fr) 8fr;\n      gap: 40px;\n      padding: 64px 24px;\n      max-width: 1400px;\n      margin: 0 auto;\n      position: relative\n    }\n\n    .shelf .left {\n      position: sticky;\n      top: 90px;\n      align-self: start\n    }\n\n    .shelf h2 {\n      color: var(--bone);\n      font-size: clamp(3rem, 7vw, 5.5rem)\n    }\n\n    .shelf h2 .ghost.c {\n      color: var(--cobalt)\n    }\n\n    .shelf .body {\n      font-size: .95rem;\n      opacity: .85;\n      max-width: 340px;\n      margin-top: 14px\n    }\n\n    .shelf .left .acts {\n      display: flex;\n      gap: 10px;\n      margin-top: 20px\n    }\n\n    .rack-shell {\n      background: var(--bone);\n      border: 3px solid var(--cobalt);\n      box-shadow: 9px 9px 0 var(--vermillion);\n      padding: 24px 24px 10px\n    }\n\n    .rack {\n      display: flex;\n      align-items: flex-end;\n      gap: 8px;\n      overflow-x: auto;\n      padding-bottom: 8px;\n      min-height: 350px\n    }\n\n    .spine {\n      position: relative;\n      flex: 0 0 auto;\n      width: 56px;\n      border: 3px solid var(--ink);\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      align-items: center;\n      padding: 12px 0;\n      will-change: transform;\n      cursor: pointer;\n      transition: transform .25s var(--ease)\n    }\n\n    .spine .num {\n      width: 30px;\n      height: 30px;\n      border-radius: 50%;\n      display: grid;\n      place-items: center;\n      font-family: var(--disp);\n      font-weight: 900;\n      font-size: .95rem;\n      border: 2px solid var(--ink)\n    }\n\n    .spine .stitle {\n      writing-mode: vertical-rl;\n      transform: rotate(180deg);\n      font-family: var(--sub);\n      font-size: 1.05rem;\n      text-transform: uppercase;\n      letter-spacing: .04em;\n      white-space: nowrap\n    }\n\n    .spine .gn {\n      font-family: var(--ui);\n      font-weight: 800;\n      font-size: .72rem;\n      letter-spacing: .1em\n    }\n\n    .spine:hover {\n      transform: translateY(-18px) rotate(-2deg) !important;\n      z-index: 10\n    }\n\n    .spine .tip {\n      position: absolute;\n      left: 50%;\n      top: -46px;\n      transform: translateX(-50%) translateY(8px) scale(.9);\n      opacity: 0;\n      transition: transform .25s var(--ease), opacity .25s var(--ease);\n      white-space: nowrap;\n      background: var(--vermillion);\n      color: var(--bone);\n      border: 3px solid var(--ink);\n      box-shadow: 3px 3px 0 var(--ink);\n      padding: .3rem .6rem;\n      font-family: var(--ui);\n      font-weight: 800;\n      font-size: .78rem;\n      z-index: 20\n    }\n\n    .spine:hover .tip {\n      opacity: 1;\n      transform: translateX(-50%) translateY(0) scale(1)\n    }\n\n    .spine.s-verm {\n      background: var(--vermillion);\n      color: var(--bone)\n    }\n\n    .spine.s-verm .num {\n      background: var(--ink);\n      color: var(--vermillion);\n      border-color: var(--bone)\n    }\n\n    .spine.s-verm .gn {\n      color: var(--bone)\n    }\n\n    .spine.s-cob {\n      background: var(--cobalt);\n      color: var(--bone)\n    }\n\n    .spine.s-cob .num {\n      background: var(--bone);\n      color: var(--ink)\n    }\n\n    .spine.s-bone {\n      background: var(--bone);\n      color: var(--ink)\n    }\n\n    .spine.s-bone .num {\n      background: var(--ink);\n      color: var(--bone)\n    }\n\n    .spine.s-ink {\n      background: var(--ink);\n      color: var(--bone)\n    }\n\n    .spine.s-ink .num {\n      background: var(--vermillion);\n      color: var(--bone)\n    }\n\n    .spine.s-ink .stitle,\n    .spine.s-ink .gn {\n      color: var(--bone)\n    }\n\n    .shelf .board {\n      height: 14px;\n      background: var(--ink);\n      margin: 0 -24px\n    }\n\n    .shelf .board2 {\n      height: 18px;\n      margin: 0 -24px;\n      background: linear-gradient(180deg, rgba(22, 19, 26, .35), transparent)\n    }\n\n    /* ============ NEW VOLUMES PIN ============ */\n    .nv {\n      position: relative;\n      border-bottom: 3px solid var(--ink)\n    }\n\n    .nv-outer {\n      height: 240vh;\n      position: relative\n    }\n\n    .nv-sticky {\n      position: sticky;\n      top: 0;\n      height: 100vh;\n      display: flex;\n      flex-direction: column;\n      justify-content: center;\n      overflow: hidden;\n      background: var(--bone)\n    }\n\n    .nv-tear {\n      height: 0;\n      border-top: 3px dashed var(--ink);\n      margin: 0 24px\n    }\n\n    .nv .top {\n      display: flex;\n      align-items: flex-end;\n      justify-content: space-between;\n      gap: 24px;\n      padding: 0 24px 26px;\n      max-width: 1400px;\n      margin: 0 auto;\n      width: 100%\n    }\n\n    .nv h2 {\n      font-size: clamp(2.6rem, 6vw, 5rem)\n    }\n\n    .nv .filters {\n      display: flex;\n      gap: 8px;\n      align-items: center\n    }\n\n    .nv-track {\n      overflow: hidden;\n      padding: 10px 0\n    }\n\n    .reel {\n      display: flex;\n      gap: 28px;\n      padding: 0 24px;\n      width: max-content;\n      will-change: transform\n    }\n\n    .ticket {\n      position: relative;\n      width: 380px;\n      flex: 0 0 auto;\n      background: var(--bone);\n      border: 3px solid var(--ink);\n      box-shadow: 6px 6px 0 var(--ink);\n      padding: 22px 26px;\n      transition: transform .3s var(--ease)\n    }\n\n    .ticket::before,\n    .ticket::after {\n      content: \"\";\n      position: absolute;\n      top: 50%;\n      width: 26px;\n      height: 26px;\n      background: var(--bone);\n      border: 3px solid var(--ink);\n      border-radius: 50%;\n      transform: translateY(-50%)\n    }\n\n    .ticket::before {\n      left: -15px\n    }\n\n    .ticket::after {\n      right: -15px\n    }\n\n    .ticket.active {\n      transform: scale(1.03)\n    }\n\n    .ticket .stamp {\n      position: absolute;\n      top: -14px;\n      right: 18px;\n      width: 62px;\n      height: 62px;\n      border-radius: 50%;\n      display: grid;\n      place-items: center;\n      text-align: center;\n      line-height: 1;\n      background: var(--vermillion);\n      color: var(--bone);\n      border: 3px dashed var(--bone);\n      box-shadow: 0 0 0 3px var(--ink);\n      font-family: var(--disp);\n      font-weight: 900;\n      transform: rotate(-10deg);\n      transition: transform .3s var(--ease)\n    }\n\n    .ticket .stamp .mo {\n      font-family: var(--ui);\n      font-weight: 800;\n      font-size: .7rem;\n      letter-spacing: .12em\n    }\n\n    .ticket .stamp .dy {\n      font-size: 1.5rem\n    }\n\n    .ticket.alt .stamp {\n      background: var(--ink);\n      color: var(--cobalt);\n      border-color: var(--cobalt)\n    }\n\n    .ticket.active .stamp {\n      transform: rotate(2deg) scale(1.05)\n    }\n\n    .tk-inner {\n      border-top: 2px dashed rgba(22, 19, 26, .45);\n      padding-top: 14px;\n      margin-top: 6px\n    }\n\n    .ticket .vtag {\n      margin-bottom: 6px\n    }\n\n    .ticket .ttl {\n      font-family: var(--sub);\n      font-size: 1.7rem;\n      line-height: .95;\n      text-transform: uppercase\n    }\n\n    .ticket .desc {\n      font-size: .85rem;\n      opacity: .7;\n      margin-top: 4px\n    }\n\n    .ticket .rel {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      margin-top: 18px;\n      gap: 10px\n    }\n\n    .ticket .rel .rl {\n      font-size: .82rem\n    }\n\n    .ticket .rel .rl b {\n      font-family: var(--ui);\n      font-weight: 800;\n      letter-spacing: .1em;\n      text-transform: uppercase\n    }\n\n    .nv-hint {\n      text-align: center;\n      font-family: var(--ui);\n      font-weight: 800;\n      text-transform: uppercase;\n      letter-spacing: .2em;\n      font-size: .85rem;\n      opacity: .55;\n      margin-top: 18px\n    }\n\n    /* ============ FOOTER ============ */\n    footer {\n      background: var(--cobalt-deep);\n      color: var(--bone);\n      position: relative;\n      overflow: hidden\n    }\n\n    .foot-tear {\n      height: 0;\n      border-top: 3px dashed rgba(242, 235, 220, .4)\n    }\n\n    .foot-grid {\n      display: grid;\n      grid-template-columns: 1.6fr 1fr 1fr 1.4fr;\n      gap: 40px;\n      padding: 56px 24px;\n      max-width: 1400px;\n      margin: 0 auto;\n      position: relative;\n      z-index: 2\n    }\n\n    .foot-col {\n      opacity: 0;\n      transform: translateY(26px);\n      transition: opacity .7s var(--ease), transform .7s var(--ease);\n      transition-delay: calc(var(--i) * 90ms)\n    }\n\n    .foot-col.in {\n      opacity: 1;\n      transform: none\n    }\n\n    .foot-mark {\n      font-family: var(--disp);\n      font-weight: 900;\n      font-size: 2.6rem;\n      text-transform: uppercase;\n      line-height: .85;\n      position: relative;\n      display: inline-block\n    }\n\n    .foot-mark .gc {\n      position: absolute;\n      inset: 0;\n      color: var(--cobalt);\n      transform: translate(3px, 3px);\n      z-index: -1;\n      mix-blend-mode: screen\n    }\n\n    .foot-mark .gv {\n      position: absolute;\n      inset: 0;\n      color: var(--vermillion);\n      transform: translate(-3px, -2px);\n      z-index: -2;\n      mix-blend-mode: screen\n    }\n\n    .foot-tag {\n      font-size: .85rem;\n      opacity: .75;\n      margin-top: 12px;\n      max-width: 300px\n    }\n\n    .foot-h {\n      font-family: var(--ui);\n      font-weight: 800;\n      text-transform: uppercase;\n      letter-spacing: .16em;\n      font-size: .95rem;\n      margin-bottom: 12px\n    }\n\n    .foot-col ul {\n      list-style: none;\n      display: flex;\n      flex-direction: column;\n      gap: 6px;\n      font-size: .92rem;\n      opacity: .85\n    }\n\n    .foot-col ul li {\n      cursor: pointer\n    }\n\n    .foot-col ul li:hover {\n      opacity: 1;\n      color: var(--vermillion)\n    }\n\n    .news {\n      display: flex\n    }\n\n    .news input {\n      flex: 1;\n      border: 3px solid var(--bone);\n      background: var(--bone);\n      color: var(--ink);\n      padding: .5rem .7rem;\n      font-size: .85rem;\n      outline: none\n    }\n\n    .news .btn {\n      box-shadow: none\n    }\n\n    .news-note {\n      font-size: .78rem;\n      opacity: .7;\n      margin-top: 8px\n    }\n\n    .copy {\n      border-top: 1px solid rgba(242, 235, 220, .2);\n      padding: 16px;\n      text-align: center;\n      font-family: var(--ui);\n      font-weight: 700;\n      letter-spacing: .08em;\n      font-size: .85rem;\n      opacity: .8;\n      position: relative;\n      z-index: 2\n    }\n\n    .foot-dots {\n      position: absolute;\n      inset: 0;\n      opacity: .25;\n      background-image: radial-gradient(rgba(242, 235, 220, .5) 1px, transparent 1.3px);\n      background-size: 18px 18px;\n      z-index: 1;\n      pointer-events: none\n    }\n\n    /* ============ RESPONSIVE ============ */\n    @media(max-width:900px) {\n      .hero-inner {\n        grid-template-columns: 1fr;\n        gap: 24px;\n        padding: 34px 20px 24px\n      }\n\n      .mosaic {\n        grid-template-colu