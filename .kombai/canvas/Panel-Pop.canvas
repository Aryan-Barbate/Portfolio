l\" data-kid=\"326\">\n              <div class=\"stamp\" data-kid=\"327\"><span class=\"mo\" data-kid=\"328\">JAN</span><span class=\"dy\" data-kid=\"329\">23</span></div>\n              <div class=\"tk-inner\" data-kid=\"330\">\n                <span class=\"tag vtag\" data-kid=\"331\">VOL 22 · Special</span>\n                <div class=\"ttl\" data-kid=\"332\">SHIBUYA UNDERTOW</div>\n                <div class=\"desc\" data-kid=\"333\">\"Neon, Then Nothing\" · 264 pages</div>\n                <div class=\"rel\" data-kid=\"334\">\n                  <div class=\"rl\" data-kid=\"335\"><b data-kid=\"336\">Release</b><br data-kid=\"337\">Fri · 23 Jan · 09:00 JST</div><button class=\"btn verm sm\" data-kid=\"338\">◔ Remind\n                    me</button>\n                </div>\n              </div>\n            </article>\n          </div>\n        </div>\n        <div class=\"nv-hint\" aria-hidden=\"true\" data-kid=\"339\">scroll to reel through ⇆</div>\n      </div>\n    </div>\n  </section>\n\n  \n  <footer data-kid=\"340\">\n    <div class=\"foot-tear\" aria-hidden=\"true\" data-kid=\"341\"></div>\n    <div class=\"foot-dots\" aria-hidden=\"true\" data-kid=\"342\"></div>\n    <div class=\"foot-grid\" data-kid=\"343\">\n      <div class=\"foot-col\" style=\"--i:0\" data-kid=\"344\">\n        <span class=\"foot-mark\" data-kid=\"345\">PANEL/POP<span class=\"gc\" aria-hidden=\"true\" data-kid=\"346\">PANEL/POP</span><span class=\"gv\" aria-hidden=\"true\" data-kid=\"347\">PANEL/POP</span></span>\n        <p class=\"foot-tag\" data-kid=\"348\">Officially licensed weekly seinen, delivered every Tuesday at 09:00 JST. Read in original\n          direction.</p>\n      </div>\n      <div class=\"foot-col\" style=\"--i:1\" data-kid=\"349\">\n        <div class=\"foot-h\" data-kid=\"350\">Catalog</div>\n        <ul data-kid=\"351\">\n          <li data-kid=\"352\">All series</li>\n          <li data-kid=\"353\">Schedule</li>\n          <li data-kid=\"354\">Mangaka</li>\n          <li data-kid=\"355\">Imprints</li>\n        </ul>\n      </div>\n      <div class=\"foot-col\" style=\"--i:2\" data-kid=\"356\">\n        <div class=\"foot-h\" data-kid=\"357\">Account</div>\n        <ul data-kid=\"358\">\n          <li data-kid=\"359\">Library</li>\n          <li data-kid=\"360\">Subscription</li>\n          <li data-kid=\"361\">Bookmarks</li>\n          <li data-kid=\"362\">Devices</li>\n        </ul>\n      </div>\n      <div class=\"foot-col\" style=\"--i:3\" data-kid=\"363\">\n        <div class=\"foot-h\" data-kid=\"364\">Join the Club</div>\n        <div class=\"news\" data-kid=\"365\">\n          <input type=\"email\" placeholder=\"your@email.jp\" aria-label=\"Email address\" data-kid=\"366\">\n          <button class=\"btn verm sm\" data-kid=\"367\">Subscribe</button>\n        </div>\n        <p class=\"news-note\" data-kid=\"368\">Weekly drops, no spam. Cancel anytime.</p>\n      </div>\n    </div>\n    <div class=\"copy\" data-kid=\"369\">© 2026 Panel/Pop Editions · Tokyo · Brooklyn</div>\n  </footer>\n\n  <script data-kid=\"370\">\n    (function () {\n      const reduce = false;\n      /* ---- build hero mosaic: 18 tiles, 8 unique imgs reused ---- */\n      var mosaic = document.getElementById('mosaic');\n      var heroTitles = ['KUROI HANA', 'SILENT RONIN', 'VOID PROTOCOL', 'NIGHT IN AOMORI', 'FERAL EYES', 'SHIBUYA UNDERTOW', 'PAPER CRANE WAR', 'OBSIDIAN BLOOM'];\n      var heroImgs = [\n        'https://images.unsplash.com/photo-1593345215990-170543af6949?auto=format&w=520&q=80&fit=crop',\n        'https://images.unsplash.com/photo-1618645003576-cc6c9a3e5bb4?auto=format&w=520&q=80&fit=crop',\n        'https://images.unsplash.com/photo-1642089142419-a0aa1d4ba375?auto=format&w=520&q=80&fit=crop',\n        'https://images.unsplash.com/photo-1540172777610-b15b605dd68d?auto=format&w=520&q=80&fit=crop',\n        'https://images.unsplash.com/photo-1571668168013-17b1e615f325?auto=format&w=520&q=80&fit=crop',\n        'https://images.unsplash.com/photo-1563308908-1006314af9c1?auto=format&w=520&q=80&fit=crop',\n        'https://images.unsplash.com/photo-1667288259129-96c2a533ca72?auto=format&w=520&q=80&fit=crop',\n        'https://images.unsplash.com/photo-1737501999699-0472be0c82ef?auto=format&w=520&q=80&fit=crop'\n      ];\n      for (var i = 0; i < 18; i++) {\n        var t = document.createElement('div');\n        t.className = 'tile';\n        var n = i % 8;\n        var dx = (Math.random() * 440 - 220).toFixed(0) + 'px';\n        var dy = (Math.random() * 300 - 150).toFixed(0) + 'px';\n        var r = (Math.random() * 30 - 15).toFixed(1) + 'deg';\n        t.style.setProperty('--i', i);\n        t.style.setProperty('--dx', dx);\n        t.style.setProperty('--dy', dy);\n        t.style.setProperty('--r', r);\n        t.style.setProperty('--py', '0px');\n        t.setAttribute('data-depth', (i % 3 === 0 ? '-0.05' : (i % 3 === 1 ? '-0.11' : '-0.17')));\n        var img = document.createElement('img');\n        img.src = heroImgs[n];\n        img.alt = '';\n        img.setAttribute('onerror', \"this.style.display='none'\");\n        t.appendChild(img);\n        mosaic.appendChild(t);\n      }\n      // settle on load\n      window.addEventListener('load', function () { setTimeout(function () { mosaic.classList.add('in'); }, 120); });\n      if (reduce) { mosaic.classList.add('in'); }\n\n      /* ---- volume rail (duplicate set for marquee loop) ---- */\n      var railData = [\n        ['KUROI HANA', 'Ito Junji · Drama / Psych', 'CH. 184', 'SEINEN', 1],\n        ['SILENT RONIN', 'K. Tanaka · Historical', 'CH. 077', 'ACTION', 2],\n        ['VOID PROTOCOL', 'R. Ozawa · Cosmic Horror', 'CH. 042', 'HORROR', 3],\n        ['NIGHT IN AOMORI', 'M. Hayashi · Slice / Noir', 'CH. 213', 'SEINEN', 4],\n        ['FERAL EYES', 'S. Yamada · Thriller', 'CH. 098', 'DRAMA', 5],\n        ['SHIBUYA UNDERTOW', 'D. Mori · Crime', 'CH. 056', 'CRIME', 6],\n        ['PAPER CRANE WAR', 'A. Sugiyama · Historical', 'CH. 121', 'SEINEN', 7],\n        ['OBSIDIAN BLOOM', 'N. Kuroda · Mystery', 'CH. 008', 'NEW', 8]\n      ];\n      var rail = document.getElementById('rail');\n      function buildCard(d) {\n        var a = document.createElement('article'); a.className = 'vcard';\n        a.innerHTML = '<div class=\"cov\"><img src=\"' + heroImgs[d[4] - 1] + '\" alt=\"\" loading=\"lazy\" onerror=\"this.style.display=\\'none\\'\"/>'\n          + '<span class=\"tag ch\">' + d[2] + '</span>'\n          + '<span class=\"bubble verm gn\">' + d[3] + '</span>'\n          + '<span class=\"pop\">▶ READ NOW</span></div>'\n          + '<div class=\"cap\"><div class=\"t\">' + d[0] + '</div><div class=\"a\">' + d[1] + '</div></div>';\n        return a;\n      }\n      for (var k = 0; k < 2; k++) { railData.forEach(function (d) { rail.appendChild(buildCard(d)); }); }\n\n      /* ---- IntersectionObserver: entrances ---- */\n      var io = new IntersectionObserver(function (es) {\n        es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });\n      }, { threshold: .12, rootMargin: '0px 0px -8% 0px' });\n      var animEls = document.querySelectorAll('.reveal,.skewset,.clipline,.windup,.blursharp,.fill,.foot-col');\n      // reveal anything already in the initial viewport immediately (above-the-fold hero, etc.)\n      function revealVisible() {\n        var vh = window.innerHeight;\n        animEls.forEach(function (el) {\n          var r = el.getBoundingClientRect();\n          if (r.top < vh * 0.92 && r.bottom > 0) { el.classList.add('in'); }\n        });\n      }\n      animEls.forEach(function (el) { io.observe(el); });\n      revealVisible();\n      window.addEventListener('load', revealVisible);\n\n      // continue-reading heading chip skew handled via reveal on left; add skewset class to chip\n      var crChip = document.querySelector('.cr .head-chip'); if (crChip) { crChip.classList.add('skewset'); io.observe(crChip); }\n\n      /* ---- per-word fade-rise for [data-words] heading ---- */\n      document.querySelectorAll('[data-words]').forEach(function (h) {\n        var ghosts = h.querySelectorAll('.ghost');\n        var txt = h.childNodes[0].textContent;\n        var label = txt.trim();\n        h.setAttribute('aria-label', label);\n        var words = label.split(' ');\n        h.childNodes[0].textContent = '';\n        var frag = document.createDocumentFragment();\n        words.forEach(function (w, idx) {\n          var s = document.createElement('span'); s.className = 'word'; s.style.setProperty('--i', idx); s.textContent = w;\n          frag.appendChild(s);\n        });\n        h.insertBefore(frag, ghosts[0]);\n        var wio = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { h.querySelectorAll('.word').forEach(function (x) { x.classList.add('in'); }); wio.unobserve(h); } }); }, { threshold: .3 });\n        wio.observe(h);\n      });\n\n      /* ---- rAF scroll loop ---- */\n      var scrollY = 0, ticking = false;\n      var crCount = document.getElementById('crcount');\n      var crSection = document.getElementById('continue');\n      var mosaicTiles = mosaic.querySelectorAll('.tile');\n      var spines = document.querySelectorAll('[data-spine]');\n      var nvOuter = document.getElementById('nvOuter');\n      var reel = document.getElementById('reel');\n      var tickets = reel ? reel.querySelectorAll('.ticket') : [];\n      var railEl = document.getElementById('rail');\n      var lastScroll = 0, vel = 0, railShift = 0;\n\n      function clamp(v, a, b) { return Math.max(a, Math.min(b, v)); }\n\n      function update() {\n        document.documentElement.style.setProperty('--scroll', scrollY);\n        var vh = window.innerHeight;\n\n        // hero mosaic parallax separation\n        if (mosaic.classList.contains('in')) {\n          mosaicTiles.forEach(function (t) {\n            var dp = parseFloat(t.getAttribute('data-depth')) || 0;\n            t.style.setProperty('--py', (scrollY * dp).toFixed(1) + 'px');\n          });\n        }\n\n        // continue-reading scrubbed counter 0->78\n        if (crSection) {\n          var r = crSection.getBoundingClientRect();\n          var p = clamp((vh - r.top) / (vh * 0.9), 0, 1);\n          crCount.firstChild.textContent = Math.round(p * 78);\n        }\n\n        // shelf spine parallax drift\n        spines.forEach(function (sp) {\n          var d = parseFloat(sp.style.getPropertyValue('--d')) || 0;\n          var rr = sp.getBoundingClientRect();\n          var center = (rr.top + rr.height / 2) - vh / 2;\n          sp.style.transform = 'translateY(' + (center * d * 0.18).toFixed(1) + 'px)';\n        });\n\n        // new volumes horizontal pin\n        if (nvOuter && reel && window.innerWidth > 768) {\n          var ro = nvOuter.getBoundingClientRect();\n          var total = nvOuter.offsetHeight - vh;\n          var pp = clamp((-ro.top) / total, 0, 1);\n          var maxShift = reel.scrollWidth - window.innerWidth + 48;\n          if (maxShift < 0) maxShift = 0;\n          reel.style.transform = 'translateX(' + (-pp * maxShift).toFixed(1) + 'px)';\n          // active ticket = nearest to center\n          var cx = window.innerWidth / 2, best = 1e9, bi = 0;\n          tickets.forEach(function (tk, idx) {\n            var tr = tk.getBoundingClientRect();\n            var dc = Math.abs((tr.left + tr.width / 2) - cx);\n            if (dc < best) { best = dc; bi = idx; }\n          });\n          tickets.forEach(function (tk, idx) { tk.classList.toggle('active', idx === bi); });\n        }\n\n        // velocity rail: base drift + scroll-velocity boost\n        if (railEl && window.innerWidth > 768) {\n          railShift -= (0.4 + Math.abs(vel) * 0.05);\n          var halfW = railEl.scrollWidth / 2;\n          if (halfW > 0 && -railShift >= halfW) { railShift += halfW; }\n          railEl.style.transform = 'translateX(' + railShift.toFixed(1) + 'px)';\n        }\n        vel *= 0.85;\n        ticking = false;\n      }\n\n      window.addEventListener('scroll', function () {\n        scrollY = window.scrollY;\n        vel = scrollY - lastScroll; lastScroll = scrollY;\n        if (!ticking && !reduce) { requestAnimationFrame(update); ticking = true; }\n      }, { passive: true });\n\n      // continuous rAF for the rail drift (autonomous) + initial\n      function loop() { if (!reduce) { if (!ticking) { requestAnimationFrame(update); ticking = true; } } requestAnimationFrame(loop); }\n      if (!reduce) { requestAnimationFrame(loop); } else { update(); }\n    })();\n  </script>\n",
